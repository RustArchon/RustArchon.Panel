{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=RustArchon_Identity;Username=rustarchon;Password="
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // SecretKey deliberately absent - see JwtTokenOptions (JumpStart, ADR-016) and this project's
  // Program.cs; it comes from the flat RUSTARCHON_JWT_SECRET_KEY key below instead.
  "JwtSettings": {
    "Issuer": "RustArchonBlazorServer",
    "Audience": "RustArchonApi",
    "ExpirationMinutes": 60
  },
  "ApiBaseUrl": "https://localhost:7130",
  "CookieDomain": ".rustarchon.com",
  // Deliberately absent by default, same as RustArchon.Api's own appsettings.json - no configured
  // connection string means IConnectionMultiplexer is simply never registered, and SiteBrandingService
  // falls back to reading through the Api's own anonymous endpoint instead. docker-compose.yml's
  // rustarchon-panel service overrides this to "valkey:6379" - the same Valkey container
  // rustarchon-api already uses, not a separate one.
  "Valkey": {
    "ConnectionString": ""
  },
  "RUSTARCHON_INTERNAL_API_KEY": "",
  "RUSTARCHON_JWT_SECRET_KEY": ""
}
