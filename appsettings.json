{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=RustArchon_Identity;Username=rustarchon;Password="
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // SecretKey deliberately absent - see JwtTokenOptions (JumpStart, ADR-016) and this project's
  // Program.cs; it comes from the flat RUSTARCHON_JWT_SECRET_KEY key below instead.
  "JwtSettings": {
    "Issuer": "RustArchonBlazorServer",
    "Audience": "RustArchonApi",
    "ExpirationMinutes": 60
  },
  "ApiBaseUrl": "https://localhost:7130",
  "MarketingBaseUrl": "https://www.rustarchon.com",
  "CookieDomain": ".rustarchon.com",
  "RUSTARCHON_INTERNAL_API_KEY": "",
  "RUSTARCHON_JWT_SECRET_KEY": ""
}
