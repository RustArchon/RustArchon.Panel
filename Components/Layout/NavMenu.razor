@implements IDisposable

@using RustArchon.Panel.Services
@inject NavigationManager NavigationManager
@inject SiteBrandingService Branding

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @* Panel's own "/" is just a redirect-to-servers page (see Index.razor) since the marketing
           home page now lives in the separate RustArchon.Web app - the brand mark navigates there
           instead of Panel's own root. Both the text and the href come from the platform's own
           SiteName/SiteUrl settings (see SiteBrandingService), not this app's name. *@
        <a class="navbar-brand" href="@siteUrl">@siteName</a>
        <div class="d-flex align-items-center gap-2">
            <CultureSelector />
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="@Localizer["Toggle light/dark theme"]" aria-pressed="true">
                <span data-theme-icon>☀</span>
            </button>
        </div>
    </div>
</div>

<input type="checkbox" title="@Localizer["Navigation menu"]" class="navbar-toggler" />

@*
    Grouped by who the section is for, which is the same split the product itself has: what a
    subscriber does inside their own organization, and what a site admin does across all of them.
    Before this the two were interleaved in one flat list, so a customer's four pages sat among seven
    they will never open.

    The headings are labels, not gates. Every link stays visible to any signed-in user because the
    Panel has no way to know what someone holds - permissions live on the Api side and reach the
    Panel only inside a JWT that is fetched lazily, on the first API call, which has not happened
    when the nav first renders. Each page and endpoint enforces its own permission, so clicking
    through to one you can't use says so plainly. The heading at least tells you that up front.
*@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <a class="nav-link" href="@siteUrl">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i> @Localizer["Home"]
            </a>
        </div>

        <AuthorizeView>
            <Authorized>
                @* The subscriber's own organization: the servers they run, the people who help run
                   them, and what they pay for it. Servers leads because it is the product. *@
                <h2 class="nav-group">@Localizer["Your organization"]</h2>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Organization" Match="NavLinkMatch.All">
                        <i class="bi bi-people-fill" aria-hidden="true"></i> @Localizer["Organization"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="servers">
                        <i class="bi bi-hdd-network-fill" aria-hidden="true"></i> @Localizer["Servers"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Organization/Roles">
                        <i class="bi bi-shield-lock-fill" aria-hidden="true"></i> @Localizer["Roles"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    @* Their OWN plan, not the platform-wide catalog under Site administration. The
                       two used to sit six items apart in one flat list. *@
                    <NavLink class="nav-link" href="Account/Subscription">
                        <i class="bi bi-credit-card-fill" aria-hidden="true"></i> @Localizer["Subscription"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    @* Previously reachable only from a button on the Subscription page. It is where
                       someone goes to answer "what have I been charged?", which is a question you
                       look for in the nav rather than remember is one click deeper. *@
                    <NavLink class="nav-link" href="Account/BillingHistory">
                        <i class="bi bi-receipt" aria-hidden="true"></i> @Localizer["Billing history"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    @* A rare action rather than a place you return to, so it sits last in the group.
                       It lives here because the switcher above it is JumpStart's component and must
                       not learn RustArchon's routes. *@
                    <NavLink class="nav-link" href="Organization/New">
                        <i class="bi bi-plus-square" aria-hidden="true"></i> @Localizer["New organization"]
                    </NavLink>
                </div>

                @* Everything a site admin does across all organizations, ordered the way the job
                   runs: the customers, then how the business is doing, then what it sells, then the
                   settings that govern the platform itself. *@
                <h2 class="nav-group">@Localizer["Site administration"]</h2>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/Organizations">
                        <i class="bi bi-buildings-fill" aria-hidden="true"></i> @Localizer["Organizations"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/Users">
                        <i class="bi bi-person-vcard-fill" aria-hidden="true"></i> @Localizer["Users"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Reports">
                        <i class="bi bi-bar-chart-fill" aria-hidden="true"></i> @Localizer["Reports"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/Invoices">
                        <i class="bi bi-receipt-cutoff" aria-hidden="true"></i> @Localizer["Invoices"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/Plans">
                        <i class="bi bi-tags-fill" aria-hidden="true"></i> @Localizer["Plans"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/InvitationCodes">
                        <i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i> @Localizer["Invitation codes"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/PlatformSettings">
                        <i class="bi bi-sliders" aria-hidden="true"></i> @Localizer["Platform settings"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/EmailTemplates">
                        <i class="bi bi-envelope-paper-fill" aria-hidden="true"></i> @Localizer["Email templates"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Admin/EmailPlaceholders">
                        <i class="bi bi-braces" aria-hidden="true"></i> @Localizer["Email placeholders"]
                    </NavLink>
                </div>

                @* No heading: this is the session, not a part of the product. *@
                <div class="nav-item nav-session px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <i class="bi bi-person-fill" aria-hidden="true"></i> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    @* data-enhance="false" forces a real browser navigation instead of Blazor's
                       enhanced-navigation fetch/DOM-patch - without it, the SignalR circuit (and
                       its cached JWT in ITokenStore) survives logout indefinitely. *@
                    <form action="Account/Logout" method="post" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <i class="bi bi-arrow-bar-left" aria-hidden="true"></i> @Localizer["Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>

        @* AGPL-3.0 §13: anyone interacting with this app over a network - including signed-in users,
           not just marketing-site visitors - must be offered a way to get its source. See NOTICE.md. *@
        <div class="nav-item px-3 nav-source">
            <a class="nav-link" href="https://github.com/RustArchon" target="_blank" rel="noopener">
                <i class="bi bi-github" aria-hidden="true"></i> @Localizer["Source"]
            </a>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <i class="bi bi-person" aria-hidden="true"></i> @Localizer["Register"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <i class="bi bi-person-badge" aria-hidden="true"></i> @Localizer["Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string siteName = "RustArchon";
    private string siteUrl = "https://www.rustarchon.com";

    protected override async Task OnInitializedAsync()
    {
        await LoadBrandingAsync();

        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private async Task LoadBrandingAsync()
    {
        var branding = await Branding.GetAsync();
        siteName = branding.SiteName;
        siteUrl = branding.SiteUrl;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        // This component is mounted once and never re-initialized for the life of the circuit (see
        // MainLayout), so OnInitializedAsync's own load above only ever runs the first time - refreshed
        // here instead so an admin's saved Site name/Site URL change shows up on this nav bar's very
        // next navigation, not whenever the circuit next happens to restart. Cheap to do on every
        // navigation: GetAsync() reads Valkey directly (see SiteBrandingService), not a network round
        // trip to the Api in the common case.
        _ = InvokeAsync(async () =>
        {
            await LoadBrandingAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
