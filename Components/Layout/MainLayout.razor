@inherits LayoutComponentBase
@using JumpStart.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <TenantSwitcher @rendermode="RenderModes.NonPrerenderedServer" />
                </Authorized>
            </AuthorizeView>
            <ProfileMenu />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@* TenantSwitcher's @rendermode above uses RenderModes.NonPrerenderedServer (a single, shared,
   stable instance) rather than constructing a fresh InteractiveServerRenderMode inline - see that
   class's own remarks for why an inline `new` there would be a real, confirmed bug, not just style. *@
