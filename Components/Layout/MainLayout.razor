@inherits LayoutComponentBase
@using JumpStart.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <TenantSwitcher @rendermode="RenderModes.NonPrerenderedServer" />
                </Authorized>
            </AuthorizeView>
            <ProfileMenu />

            @* Language and theme apply to the whole app, not just a signed-in user's own organization -
               unlike TenantSwitcher/ProfileMenu above, deliberately outside any AuthorizeView so an
               anonymous visitor (the login page, say) can still reach them. Placed here, to the right
               of the profile link, rather than cramped into the sidebar's brand row - see
               CultureSelector.razor's own remarks for why it also needs its own @rendermode to work at
               all in an otherwise-static layout. *@
            <div class="d-flex align-items-center gap-2">
                <CultureSelector @rendermode="RenderModes.NonPrerenderedServer" />
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="@Localizer["Toggle light/dark theme"]" aria-pressed="true">
                    <span data-theme-icon>☀</span>
                </button>
            </div>
        </div>

        <AppGenerationWatcher @rendermode="RenderModes.NonPrerenderedServer" />

        @* Above the content, not inside it, so it is present on every page a site admin might wander
           onto while acting as somebody else - including ones written later. *@
        <AuthorizeView>
            <Authorized>
                <ActingAsBanner @rendermode="RenderModes.NonPrerenderedServer" />
            </Authorized>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["An unhandled error has occurred."]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@* TenantSwitcher's @rendermode above uses RenderModes.NonPrerenderedServer (a single, shared,
   stable instance) rather than constructing a fresh InteractiveServerRenderMode inline - see that
   class's own remarks for why an inline `new` there would be a real, confirmed bug, not just style. *@
