@using JumpStart.Services
@inject ITenantSelectionService TenantSelection

@*
    Says, at all times and on every page, that what you are looking at is not yours.

    A site admin acting as a customer sees the customer's own screens, unchanged - which is the whole
    point, and also the whole risk. Somebody who forgets which organization they are in can disable a
    server, send an RCON command or change a plan believing it is their own. So this is deliberately
    loud, deliberately un-dismissable, and deliberately offers the way out.

    Derived from the tenant selection rather than the token: acting as somebody means the current
    tenant is not one of yours, and that is a question this component can answer without waiting for
    a JWT that is only fetched on the first API call.
*@

@if (actingAs)
{
    <div class="alert alert-warning border-warning rounded-0 mb-0 d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-eye-fill" aria-hidden="true"></i>
            <strong>You're acting as another organization.</strong>
            Anything you do here happens to their servers and their billing, as though you were them.
        </div>
        @* A real navigation, so the circuit restarts and the tenant resolves back to one of yours. *@
        <a class="btn btn-sm btn-outline-dark" href="Admin/Organizations" data-enhance="false">
            Leave
        </a>
    </div>
}

@code {
    private bool actingAs;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await TenantSelection.GetCurrentTenantIdAsync();

            if (current is not { } tenantId)
            {
                return;
            }

            var mine = await TenantSelection.GetAvailableTenantsAsync();
            actingAs = mine.All(t => t.Id != tenantId);
        }
        catch
        {
            // Never let the banner break the page it sits above. Failing to render it is a worse
            // outcome than rendering nothing, but not as bad as taking the layout down - and the
            // condition it reports is unusual enough that a transient failure here is not the thing
            // to escalate.
            actingAs = false;
        }
    }
}
