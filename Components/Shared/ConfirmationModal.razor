@* Reusable Bootstrap modal for confirmations *@
<div class="modal fade @(IsVisible ? "show" : "")" 
     id="@ModalId" 
     tabindex="-1" 
     style="display: @(IsVisible ? "block" : "none")"
     aria-labelledby="@($"{ModalId}Label")" 
     aria-hidden="@(!IsVisible)">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@($"{ModalId}Label")">@Title</h5>
                <button type="button" class="btn-close" @onclick="Cancel" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                @Message
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    @CancelButtonText
                </button>
                <button type="button" class="btn @ConfirmButtonClass" @onclick="Confirm">
                    @ConfirmButtonText
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public string ModalId { get; set; } = $"modal-{Guid.NewGuid():N}";

    // string?, not a literal English default - @inject properties like Localizer aren't populated yet
    // when field initializers run, so "Confirm"/"Yes"/"No" are filled in from OnParametersSet below
    // instead, once Localizer is actually available and before this ever renders.
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Message { get; set; }
    [Parameter] public string? ConfirmButtonText { get; set; }
    [Parameter] public string? CancelButtonText { get; set; }
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-danger";
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    protected override void OnParametersSet()
    {
        Title ??= Localizer["Confirm"];
        ConfirmButtonText ??= Localizer["Yes"];
        CancelButtonText ??= Localizer["No"];
    }

    // Both call sites in this project (ServersList, InvitationCodes) mount this component only
    // inside their own `@if (showXConfirmation)` block, and never hold a `@ref` to call Show() -
    // JumpStart.DemoApp's template this was copied from expects the latter pattern instead, which
    // left IsVisible permanently false here: the modal rendered into the DOM (display: none) but
    // never actually appeared. Defaulting to visible matches how this component is actually used -
    // being mounted at all IS the "show" signal for these call sites.
    private bool IsVisible { get; set; } = true;

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        IsVisible = false;
        await OnClose.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        IsVisible = false;
        await OnClose.InvokeAsync(false);
    }
}
