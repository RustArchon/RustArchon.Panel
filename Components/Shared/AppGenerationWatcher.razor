@implements IDisposable
@using RustArchon.Panel.Services
@inject NavigationManager Navigation
@inject AppGenerationService AppGeneration

@*
    Renders nothing - this is a headless interactive island, the same pattern as TenantSwitcher/
    ActingAsBanner, carved out of an otherwise-static MainLayout for exactly one reason: it needs a
    real Blazor circuit to call NavigationManager.RegisterLocationChangingHandler at all.

    MainLayout.razor itself declares no @rendermode of its own - only specific pages opt into
    interactivity (see e.g. ServersList.razor's own @rendermode directive), and a rendermode never
    extends upward from a page to the layout wrapping it. Putting this logic directly in MainLayout's
    own @code block (the first version of this) compiled fine and looked correct, but silently never
    ran: OnAfterRender never fires on a statically-rendered component, so the location-changing handler
    was never actually registered. Confirmed the hard way investigating a separate, structurally
    identical bug in CultureSelector.razor - see its own remarks.
*@

@code {
    /// <summary>
    /// The app generation this circuit was actually rendered under - captured once, when this island
    /// starts, and compared against on every navigation attempt from then on. See
    /// <see cref="OnLocationChangingAsync"/> and AppGenerationService's own remarks.
    /// </summary>
    private string? _bornGeneration;

    private IDisposable? _locationChangingRegistration;

    protected override async Task OnInitializedAsync()
    {
        _bornGeneration = await AppGeneration.GetCurrentAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    /// <summary>
    /// Upgrades this circuit's next navigation to a full page reload once the shared app generation no
    /// longer matches the one this circuit was <see cref="_bornGeneration">born under</see> - see
    /// AppGenerationService's remarks for why a Blazor Server circuit needs telling at all: it renders
    /// its own page chrome once, at first load, and never re-runs that just because something it read
    /// (the site name, eventually an active theme) changed on the server in the meantime.
    /// </summary>
    /// <remarks>
    /// A <c>null</c> current generation - Valkey unreachable, or never configured - is treated as
    /// "can't tell", not as a mismatch. Failing to answer the question is never itself a reason to
    /// force a reload; see AppGenerationService's remarks.
    /// </remarks>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        var current = await AppGeneration.GetCurrentAsync();

        if (current is null || current == _bornGeneration)
        {
            return;
        }

        context.PreventNavigation();
        Navigation.NavigateTo(context.TargetLocation, forceLoad: true);
    }

    public void Dispose() => _locationChangingRegistration?.Dispose();
}
