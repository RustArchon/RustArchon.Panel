@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager NavigationManager

@* "/" used to serve Home.razor (the marketing page) before the Web/Panel split - that page now
   lives in the separate RustArchon.Web app. This app's root has no content of its own: an
   authenticated hit goes straight to the server list (the real landing page for a signed-in user);
   an anonymous hit falls through to Routes.razor's existing [Authorize]-failure handling
   (RedirectToLogin), the same mechanism every other authenticated-only page here already relies on
   - no separate anonymous-vs-authenticated branching needed here. *@

@code {
    // Forwards the query string along with the redirect - this page has no meaning of its own, so it
    // should be a transparent pass-through. Notably, TenantSwitcher relies on exactly this: it reloads
    // to "/" with a "?tenantId=..." hint after a tenant switch (see
    // ITenantSelectionService.TenantIdQueryParameterName's remarks for why), which would otherwise be
    // silently dropped here, undoing the switch.
    protected override void OnInitialized() =>
        NavigationManager.NavigateTo("servers" + new Uri(NavigationManager.Uri).Query);
}
