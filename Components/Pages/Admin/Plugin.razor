@* Copyright ©2026 Scott Blomfield *@

@page "/Admin/Plugin"
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IPluginAdminApiClient Client
@inject IJSRuntime JS
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>@Localizer["Plugin"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>@Localizer["RustArchon plugin"]</h1>
</div>
<p class="text-muted">
    @Localizer["The signing key that vouches for the plugin, and the plugin files this Panel delivers to game servers. Every action here is recorded in the audit log below."]
</p>

@if (accessDenied)
{
    <div class="alert alert-warning" data-testid="plugin-admin-denied">
        <i class="bi bi-shield-lock"></i> @Localizer["You don't have access to manage the plugin."]
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" data-testid="plugin-admin-error">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" data-testid="plugin-admin-success">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <p><em>@Localizer["Loading..."]</em></p>
    }
    else
    {
        @* ============================ Signing keys ============================ *@
        <div class="card mb-4" data-testid="plugin-keys">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h5 mb-0">@Localizer["Signing keys"]</h2>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-testid="rotate-key" disabled="@busy"
                            @onclick="StartRotate">
                        <i class="bi bi-arrow-repeat"></i> @Localizer["Rotate key"]
                    </button>
                </div>
                <p class="small text-muted">
                    @Localizer["One key is active and signs everything new. Every earlier key is kept: a server that still trusts one is moved to the active key in a single update. Nothing is ever deleted."]
                </p>

                @if (reminder is { Due: true })
                {
                    <div class="alert alert-warning small d-flex justify-content-between align-items-center" data-testid="key-rotation-reminder">
                        <span>
                            <i class="bi bi-bell"></i>
                            @string.Format(Localizer["The active signing key {0} has been in use for {1} days (since {2}). Consider rotating it. Rotating is safe: servers on the old key are moved to the new one in a single update. Nothing is ever rotated for you."], reminder.Fingerprint, reminder.AgeDays, reminder.ActiveSinceUtc?.ToString("yyyy-MM-dd"))
                            @string.Format(Localizer["This reminder follows the platform setting 'Signing key rotation reminder (days)' ({0}); set it to 0 to turn it off."], reminder.ReminderDays)
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-warning ms-3 text-nowrap" data-testid="reminder-rotate" disabled="@busy" @onclick="StartRotate">@Localizer["Rotate key"]</button>
                    </div>
                }

                @if (confirm == Confirm.Rotate)
                {
                    <div class="border rounded p-3 mb-3" data-testid="confirm-rotate">
                        <p class="mb-2">@Localizer["Rotating makes a new key the active one. The current key is kept so servers still on it can be updated. Plugins already installed keep working."]</p>
                        <div class="mb-2">
                            <label class="form-label small" for="rotate-note">@Localizer["Note (optional)"]</label>
                            <input id="rotate-note" class="form-control form-control-sm" maxlength="500" @bind="note" @bind:event="oninput" />
                        </div>
                        <div class="form-check mb-2">
                            <input id="rotate-revoke" class="form-check-input" type="checkbox" @bind="revokeCurrent" />
                            <label class="form-check-label" for="rotate-revoke">@Localizer["Also revoke the current key (suspected compromise)"]</label>
                        </div>
                        @if (revokeCurrent)
                        {
                            <div class="alert alert-warning py-2 small" data-testid="revoke-warning">
                                @Localizer["A revoked key never signs again. Servers still on it cannot be updated from here: their plugin must be downloaded and installed by hand."]
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="rotate-reason">@Localizer["Reason (required)"]</label>
                                <input id="rotate-reason" class="form-control form-control-sm" maxlength="500" @bind="reason" @bind:event="oninput" />
                            </div>
                        }
                        <button type="button" class="btn btn-danger btn-sm me-2" data-testid="confirm-rotate-go" disabled="@(busy || (revokeCurrent && string.IsNullOrWhiteSpace(reason)))"
                                @onclick="RotateAsync">@Localizer["Rotate now"]</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelConfirm">@Localizer["Cancel"]</button>
                    </div>
                }

                @if (confirm == Confirm.Revoke && revokeTarget is not null)
                {
                    <div class="border border-danger rounded p-3 mb-3" data-testid="confirm-revoke">
                        <p class="mb-2">
                            @Localizer["Revoke key"] <code>@revokeTarget</code>?
                            @Localizer["It will never sign again. Servers still on it must have their plugin downloaded and installed by hand."]
                        </p>
                        <div class="mb-2">
                            <label class="form-label small" for="revoke-reason">@Localizer["Reason (required)"]</label>
                            <input id="revoke-reason" class="form-control form-control-sm" maxlength="500" @bind="reason" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-danger btn-sm me-2" data-testid="confirm-revoke-go" disabled="@(busy || string.IsNullOrWhiteSpace(reason))"
                                @onclick="RevokeAsync">@Localizer["Revoke"]</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelConfirm">@Localizer["Cancel"]</button>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["Key"]</th>
                                <th>@Localizer["State"]</th>
                                <th>@Localizer["Servers last reporting it"]</th>
                                <th>@Localizer["Details"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in keys)
                            {
                                <tr data-testid="key-row" data-fingerprint="@key.Fingerprint">
                                    <td><code>@key.Fingerprint</code></td>
                                    <td>
                                        @if (key.State == "active")
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else if (key.State == "retired")
                                        {
                                            <span class="badge bg-secondary">@Localizer["Retired"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@Localizer["Revoked"]</span>
                                        }
                                    </td>
                                    <td>
                                        @key.ServersReporting
                                        @if (key.LastReportedUtc is not null)
                                        {
                                            <span class="text-muted small">· @Localizer["last"] @key.LastReportedUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @if (key.ActiveSinceUtc is not null)
                                        {
                                            <span data-testid="key-active-since">@Localizer["Active since"] @key.ActiveSinceUtc.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                        else if (key.RevokedAtUtc is not null)
                                        {
                                            @Localizer["Revoked"] @key.RevokedAtUtc.Value.ToString("yyyy-MM-dd") <text>-</text> @key.RevokedReason
                                        }
                                        else if (key.RetiredAtUtc is not null)
                                        {
                                            @Localizer["Retired"] @key.RetiredAtUtc.Value.ToString("yyyy-MM-dd")
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (key.State == "retired")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-testid="revoke-key" disabled="@busy"
                                                    @onclick="() => StartRevoke(key.Fingerprint)">@Localizer["Revoke"]</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2 mb-0">
                    @Localizer["The count is only what servers last reported. An offline or lagging server reports nothing, so a low number never means a key is unused."]
                </p>
            </div>
        </div>

        @* ============================ Back up and copy the keys ============================ *@
        <div class="card mb-4" data-testid="plugin-key-transfer">
            <div class="card-body">
                <h2 class="h5">@Localizer["Back up and copy signing keys"]</h2>
                <p class="small text-muted">
                    @Localizer["Export every signing key into a passphrase-protected file, to keep as a backup or to import into another Panel so both can sign for the same servers."]
                </p>
                <div class="alert alert-warning small" data-testid="key-transfer-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    @Localizer["The file holds private signing keys. Anyone with the file and its passphrase can sign code that every server trusting these keys will run. Keep it like a password, and only import it into a Panel you trust as much as this one."]
                </div>

                <div class="row g-4">
                    <div class="col-lg-6" data-testid="key-export">
                        <h3 class="h6">@Localizer["Export"]</h3>
                        <label class="form-label small" for="export-passphrase">@Localizer["Passphrase (at least 12 characters)"]</label>
                        <input id="export-passphrase" type="password" class="form-control form-control-sm mb-2" autocomplete="new-password"
                               data-testid="export-passphrase" @bind="exportPassphrase" @bind:event="oninput" />
                        <label class="form-label small" for="export-passphrase-repeat">@Localizer["Repeat the passphrase"]</label>
                        <input id="export-passphrase-repeat" type="password" class="form-control form-control-sm mb-2" autocomplete="new-password"
                               data-testid="export-passphrase-repeat" @bind="exportPassphraseRepeat" @bind:event="oninput" />
                        @if (exportProblem is not null)
                        {
                            <div class="text-danger small mb-2" data-testid="export-problem">@exportProblem</div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary" data-testid="export-keys" disabled="@busy" @onclick="ExportAsync">
                            <i class="bi bi-download"></i> @Localizer["Export keys"]
                        </button>
                    </div>

                    <div class="col-lg-6" data-testid="key-import">
                        <h3 class="h6">@Localizer["Import"]</h3>
                        <label class="form-label small" for="import-file">@Localizer["Key file"]</label>
                        <InputFile id="import-file" class="form-control form-control-sm mb-2" accept=".json" OnChange="OnKeyFileChosen" />
                        <label class="form-label small" for="import-passphrase">@Localizer["Passphrase"]</label>
                        <input id="import-passphrase" type="password" class="form-control form-control-sm mb-2" autocomplete="off"
                               data-testid="import-passphrase" @bind="importPassphrase" @bind:event="oninput" />
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="check-import"
                                disabled="@(busy || importBundle is null || string.IsNullOrEmpty(importPassphrase))" @onclick="() => CheckImportAsync()">
                            <i class="bi bi-search"></i> @Localizer["Check the file"]
                        </button>

                        @if (importPlan is not null)
                        {
                            <div class="mt-3" data-testid="import-plan">
                                <p class="small mb-2">@Localizer["This is what importing will do. Nothing has changed yet."]</p>
                                <table class="table table-sm small align-middle mb-2">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["Key"]</th>
                                            <th>@Localizer["In the file"]</th>
                                            <th>@Localizer["What happens"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in importPlan.Items)
                                        {
                                            <tr data-testid="import-plan-row" data-fingerprint="@item.Fingerprint" data-action="@item.Action">
                                                <td><code>@item.Fingerprint</code></td>
                                                <td>@BundleStateLabel(item.BundleState)</td>
                                                <td>@ActionLabel(item.Action)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                @if (importHasActiveKey)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="import-activate" data-testid="import-activate"
                                               checked="@importActivate" disabled="@busy" @onchange="OnActivateChanged" />
                                        <label class="form-check-label" for="import-activate">
                                            @Localizer["Also make the file's active key the active key here. The current active key is kept, and servers that trust it can still be updated."]
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <p class="small text-muted" data-testid="import-no-active">@Localizer["The file has no active key, so its keys can only be added to the history."]</p>
                                }

                                @if (importPlan.ChangesAnything)
                                {
                                    <input type="text" class="form-control form-control-sm mb-2" maxlength="500" data-testid="import-note"
                                           placeholder="@Localizer["Note for the audit log (optional)"]" @bind="importNote" />
                                    <button type="button" class="btn btn-sm @(importPlan.ChangesActiveKey ? "btn-danger" : "btn-primary")" data-testid="confirm-import"
                                            disabled="@busy" @onclick="ImportAsync">
                                        <i class="bi bi-box-arrow-in-down"></i> @(importPlan.ChangesActiveKey ? Localizer["Import and change the active key"] : Localizer["Import keys"])
                                    </button>
                                }
                                else
                                {
                                    <p class="small text-muted mb-0" data-testid="import-nothing">@Localizer["Nothing to import: this Panel already has everything in the file."]</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ============================ Releases ============================ *@
        <div class="card mb-4" data-testid="plugin-releases">
            <div class="card-body">
                <h2 class="h5">@Localizer["Plugin releases"]</h2>
                <p class="small text-muted">
                    @Localizer["Until a release is published, the Panel delivers the plugin built into it. An uploaded file is signed by this Panel and pushed to game servers that run it with full privileges, so it is only a draft until you publish it."]
                </p>

                @if (releases is not null)
                {
                    <ul class="list-unstyled small mb-3" data-testid="served">
                        <li>
                            <strong>@Localizer["Plugin"]</strong>:
                            @Localizer["serving"] <code>@(releases.Main.ServedVersion ?? "?")</code>
                            <span class="text-muted">(@(releases.Main.FromRelease ? Localizer["uploaded release"] : Localizer["built-in"]); @Localizer["built-in version"] @(releases.Main.EmbeddedVersion ?? "?"))</span>
                            @RolloutNote(releases.Main)
                        </li>
                        <li>
                            <strong>@Localizer["Updater"]</strong>:
                            @Localizer["serving"] <code>@(releases.Updater.ServedVersion ?? "?")</code>
                            <span class="text-muted">(@(releases.Updater.FromRelease ? Localizer["uploaded release"] : Localizer["built-in"]); @Localizer["built-in version"] @(releases.Updater.EmbeddedVersion ?? "?"))</span>
                            @RolloutNote(releases.Updater)
                        </li>
                    </ul>
                }

                <div class="border rounded p-3 mb-3" data-testid="sign-file">
                    <h3 class="h6">@Localizer["Sign a file without publishing it"]</h3>
                    <p class="small text-muted">
                        @Localizer["For a custom build of your own: this Panel checks the file exactly as it checks an upload, signs it with the active key and hands it back to install by hand on a server that trusts this Panel. Nothing is stored and nothing is delivered to any server. Who signed what, and why, is recorded in the audit log."]
                    </p>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small" for="sign-kind">@Localizer["Which file"]</label>
                            <select id="sign-kind" class="form-select form-select-sm" @bind="signKind">
                                <option value="main">RustArchon.cs</option>
                                <option value="updater">RustArchonUpdater.cs</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small" for="sign-file">@Localizer["Source file"]</label>
                            <InputFile id="sign-file" class="form-control form-control-sm" accept=".cs" OnChange="OnSignFileChosen" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small" for="sign-note">@Localizer["Why (required, recorded in the audit log)"]</label>
                            <input id="sign-note" class="form-control form-control-sm" maxlength="500" data-testid="sign-note" @bind="signNote" @bind:event="oninput" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-testid="sign-go"
                            disabled="@(busy || signFile is null || (signNote?.Trim().Length ?? 0) < MinSigningNoteLength)" @onclick="SignFileAsync">
                        <i class="bi bi-patch-check"></i> @Localizer["Sign and download"]
                    </button>
                </div>

                <div class="border rounded p-3 mb-3" data-testid="upload">
                    <h3 class="h6">@Localizer["Upload a release"]</h3>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small" for="upload-kind">@Localizer["Which file"]</label>
                            <select id="upload-kind" class="form-select form-select-sm" @bind="uploadKind">
                                <option value="main">RustArchon.cs</option>
                                <option value="updater">RustArchonUpdater.cs</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small" for="upload-file">@Localizer["Source file"]</label>
                            <InputFile id="upload-file" class="form-control form-control-sm" accept=".cs" OnChange="OnFileChosen" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small" for="upload-notes">@Localizer["Notes (optional)"]</label>
                            <input id="upload-notes" class="form-control form-control-sm" maxlength="500" @bind="uploadNotes" @bind:event="oninput" />
                        </div>
                    </div>
                    <p class="small text-muted mt-2 mb-2">
                        @Localizer["Upload the raw source, not a file downloaded from a Panel. It must not already be stamped or signed."]
                    </p>
                    <button type="button" class="btn btn-sm btn-primary" data-testid="upload-go" disabled="@(busy || chosenFile is null)"
                            @onclick="UploadAsync">
                        <i class="bi bi-upload"></i> @Localizer["Upload as draft"]
                    </button>
                </div>

                @if (confirm == Confirm.Publish && releaseTarget is not null)
                {
                    <div class="border rounded p-3 mb-3" data-testid="confirm-publish">
                        <p class="mb-2">
                            @Localizer["Publish"] <strong>@KindLabel(releaseTarget.Kind) @releaseTarget.Version</strong>?
                            @Localizer["Once published, servers can be updated to it."]
                        </p>
                        <button type="button" class="btn btn-primary btn-sm me-2" data-testid="confirm-publish-go" disabled="@busy" @onclick="PublishAsync">@Localizer["Publish"]</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelConfirm">@Localizer["Cancel"]</button>
                    </div>
                }

                @if (confirm == Confirm.Withdraw && releaseTarget is not null)
                {
                    <div class="border border-danger rounded p-3 mb-3" data-testid="confirm-withdraw">
                        <p class="mb-2">@Localizer["Withdraw"] <strong>@KindLabel(releaseTarget.Kind) @releaseTarget.Version</strong>? @Localizer["It is taken out of service for good. It is kept, never deleted."]</p>
                        <div class="mb-2">
                            <label class="form-label small" for="withdraw-reason">@Localizer["Reason (required)"]</label>
                            <input id="withdraw-reason" class="form-control form-control-sm" maxlength="500" @bind="reason" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-danger btn-sm me-2" data-testid="confirm-withdraw-go" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" @onclick="WithdrawAsync">@Localizer["Withdraw"]</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelConfirm">@Localizer["Cancel"]</button>
                    </div>
                }

                @if (releases is null || releases.Releases.Count == 0)
                {
                    <p class="small text-muted mb-0" data-testid="no-releases">@Localizer["No releases uploaded yet."]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@Localizer["File"]</th>
                                    <th>@Localizer["Version"]</th>
                                    <th>@Localizer["State"]</th>
                                    <th>@Localizer["Uploaded"]</th>
                                    <th>@Localizer["Checksum"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var release in releases.Releases)
                                {
                                    <tr data-testid="release-row" data-id="@release.Id">
                                        <td>@KindLabel(release.Kind)</td>
                                        <td><code>@release.Version</code></td>
                                        <td>
                                            @if (release.State == "published")
                                            {
                                                <span class="badge bg-success">@Localizer["Published"]</span>
                                                @if (release.IsServed)
                                                {
                                                    <span class="badge bg-primary" data-testid="release-served">@Localizer["Serving"]</span>
                                                }
                                            }
                                            else if (release.State == "draft")
                                            {
                                                <span class="badge bg-secondary">@Localizer["Draft"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" title="@release.WithdrawnReason">@Localizer["Withdrawn"]</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@release.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · @release.UploadedBy</td>
                                        <td class="small"><code>@release.Sha256[..12]</code></td>
                                        <td class="text-end">
                                            @if (release.State != "withdrawn")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-testid="download-release" disabled="@busy"
                                                        title="@Localizer["Download this release signed with the active key, to test it on a server before publishing"]"
                                                        @onclick="() => DownloadReleaseAsync(release)"><i class="bi bi-download"></i></button>
                                            }
                                            @if (release.State == "draft")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" data-testid="publish-release" disabled="@busy"
                                                        @onclick="() => StartPublish(release)">@Localizer["Publish"]</button>
                                            }
                                            @if (release.State != "withdrawn")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-testid="withdraw-release" disabled="@busy"
                                                        @onclick="() => StartWithdraw(release)">@Localizer["Withdraw"]</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* ============================ Audit log ============================ *@
        <div class="card mb-4" data-testid="plugin-events">
            <div class="card-body">
                <h2 class="h5">@Localizer["Audit log"]</h2>
                @if (events.Count == 0)
                {
                    <p class="small text-muted mb-0">@Localizer["Nothing has been done here yet."]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var e in events)
                                {
                                    <tr data-testid="event-row">
                                        <td class="small text-muted text-nowrap">@e.AtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                        <td>@EventLabel(e.Kind)</td>
                                        <td><code>@e.Subject</code></td>
                                        <td class="small">@e.Actor</td>
                                        <td class="small text-muted">@e.Detail</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private enum Confirm { None, Rotate, Revoke, Publish, Withdraw }

    private const long MaxFileBytes = 512 * 1024;

    private List<PluginKeyDto> keys = new();
    private PluginReleasesDto? releases;
    private List<PluginAdminEventDto> events = new();

    private bool loading = true;
    private bool accessDenied;
    private bool busy;
    private string? errorMessage;
    private string? successMessage;

    private Confirm confirm = Confirm.None;
    private string? note;
    private string? reason;
    private bool revokeCurrent;
    private string? revokeTarget;
    private PluginReleaseDto? releaseTarget;

    // Key export and import. The passphrases and the file's text are held only until the action finishes, and cleared then.
    private string? exportPassphrase;
    private string? exportPassphraseRepeat;
    private string? exportProblem;
    private string? importBundle;
    private string? importPassphrase;
    private string? importNote;
    private bool importActivate;
    private bool importHasActiveKey;
    private PluginKeyImportResultDto? importPlan;

    private string uploadKind = "main";
    private string? uploadNotes;
    private IBrowserFile? chosenFile;

    private const int MinSigningNoteLength = 3;
    private string signKind = "main";
    private string? signNote;
    private IBrowserFile? signFile;
    private PluginKeyReminderDto? reminder;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            keys = await Client.GetKeysAsync();
            releases = await Client.GetReleasesAsync();
            events = await Client.GetEventsAsync(50);
            accessDenied = false;

            // A reminder is a nicety: if it cannot be read the page is exactly as useful without it.
            try
            {
                reminder = await Client.GetKeyReminderAsync();
            }
            catch (Exception)
            {
                reminder = null;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            accessDenied = true;
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load the plugin page");
        }
        finally
        {
            loading = false;
        }
    }

    private void CancelConfirm()
    {
        confirm = Confirm.None;
        note = null;
        reason = null;
        revokeCurrent = false;
        revokeTarget = null;
        releaseTarget = null;
    }

    // Runs one action: shows its sentence on failure, reloads everything on success, never leaves the page stuck busy.
    private async Task RunAsync(Func<Task<string>> action, string failureAction)
    {
        busy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            successMessage = await action();
            CancelConfirm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, failureAction);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- keys ----------------------------------------------------------------------------------------------

    private void StartRotate()
    {
        CancelConfirm();
        confirm = Confirm.Rotate;
    }

    private Task RotateAsync() => RunAsync(async () =>
    {
        var created = await Client.RotateKeyAsync(new RotatePluginKeyRequestDto
        {
            Note = string.IsNullOrWhiteSpace(note) ? null : note.Trim(),
            RevokeCurrent = revokeCurrent,
            RevokeReason = revokeCurrent ? reason?.Trim() : null
        });
        return string.Format(Localizer["The signing key was rotated. The new active key is {0}."], created.Fingerprint);
    }, "rotate the key");

    private void StartRevoke(string fingerprint)
    {
        CancelConfirm();
        revokeTarget = fingerprint;
        confirm = Confirm.Revoke;
    }

    private Task RevokeAsync() => RunAsync(async () =>
    {
        var target = revokeTarget!;
        await Client.RevokeKeyAsync(target, new RevokePluginKeyRequestDto { Reason = reason!.Trim() });
        return string.Format(Localizer["Key {0} was revoked."], target);
    }, "revoke the key");

    // ---- exporting and importing keys ----------------------------------------------------------------------

    private const int MinPassphraseLength = 12;
    private const int MaxBundleBytes = 128 * 1024;

    private void ClearKeyTransfer()
    {
        exportPassphrase = exportPassphraseRepeat = exportProblem = null;
        importBundle = importPassphrase = importNote = null;
        importActivate = importHasActiveKey = false;
        importPlan = null;
    }

    private async Task ExportAsync()
    {
        exportProblem = null;
        if (string.IsNullOrEmpty(exportPassphrase) || exportPassphrase.Length < MinPassphraseLength)
        {
            exportProblem = string.Format(Localizer["The passphrase must be at least {0} characters."], MinPassphraseLength);
            return;
        }

        if (exportPassphrase != exportPassphraseRepeat)
        {
            exportProblem = Localizer["The two passphrases are not the same."];
            return;
        }

        busy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            using var response = await Client.ExportKeysAsync(new ExportPluginKeysRequestDto { Passphrase = exportPassphrase });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = response.StatusCode == HttpStatusCode.BadRequest
                    ? await response.Content.ReadAsStringAsync()
                    : ApiErrorMessage.For(new InvalidOperationException($"The Api answered {(int)response.StatusCode}."), "export the keys");
                return;
            }

            var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                ?? "rustarchon-signing-keys.json";
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
            await module.InvokeVoidAsync("downloadBytes", fileName, Convert.ToBase64String(bytes), "application/json");

            ClearKeyTransfer();
            successMessage = string.Format(
                Localizer["The keys were exported to {0}. Keep the file and its passphrase safe: together they can sign code for every server that trusts these keys."], fileName);
            events = await Client.GetEventsAsync(50);
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "export the keys");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnKeyFileChosen(InputFileChangeEventArgs e)
    {
        importPlan = null;
        importBundle = null;
        importActivate = false;
        errorMessage = null;

        if (e.File.Size > MaxBundleBytes)
        {
            errorMessage = Localizer["That file is too large to be a key file."];
            return;
        }

        try
        {
            await using var stream = e.File.OpenReadStream(MaxBundleBytes);
            using var reader = new StreamReader(stream);
            importBundle = await reader.ReadToEndAsync();
        }
        catch (Exception)
        {
            errorMessage = Localizer["That file could not be read."];
        }
    }

    // Asks the Api what importing would do (nothing is changed). Runs again whenever the "make it active" box is ticked or cleared.
    private async Task CheckImportAsync()
    {
        busy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            importPlan = await Client.ImportKeysAsync(new ImportPluginKeysRequestDto
            {
                Bundle = importBundle!, Passphrase = importPassphrase!, ActivateBundleKey = importActivate, DryRun = true
            });
            importHasActiveKey = importPlan.Items.Any(i => i.BundleState == "active");
        }
        catch (Exception ex)
        {
            importPlan = null;
            errorMessage = ApiErrorMessage.For(ex, "check the key file");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnActivateChanged(ChangeEventArgs e)
    {
        importActivate = e.Value is true;
        await CheckImportAsync();
    }

    private Task ImportAsync() => RunAsync(async () =>
    {
        var result = await Client.ImportKeysAsync(new ImportPluginKeysRequestDto
        {
            Bundle = importBundle!, Passphrase = importPassphrase!, ActivateBundleKey = importActivate, DryRun = false,
            Note = string.IsNullOrWhiteSpace(importNote) ? null : importNote.Trim()
        });
        ClearKeyTransfer();
        var added = result.Items.Count(i => i.Action == "added");
        return result.ChangesActiveKey
            ? string.Format(Localizer["Imported {0} key(s). The active key is now {1}."], added, result.ActiveAfter)
            : string.Format(Localizer["Imported {0} key(s). The active key is unchanged."], added);
    }, "import the keys");

    private string BundleStateLabel(string state) => state switch
    {
        "active" => Localizer["Active"],
        "retired" => Localizer["Retired"],
        "revoked" => Localizer["Revoked"],
        _ => Localizer["Not in the file"]
    };

    private string ActionLabel(string action) => action switch
    {
        "added" => Localizer["Added to the history (can sign an update for servers that trust it)"],
        "already_present" => Localizer["Already here"],
        "already_active" => Localizer["Already the active key"],
        "revoked" => Localizer["Revoked here too, as the file has it"],
        "activated" => Localizer["Becomes the active key"],
        "previous_active_retired" => Localizer["Was the active key here; kept in the history"],
        _ => action
    };

    // ---- releases ------------------------------------------------------------------------------------------

    private void OnFileChosen(InputFileChangeEventArgs e) => chosenFile = e.File;

    private Task UploadAsync() => RunAsync(async () =>
    {
        var file = chosenFile!;
        if (file.Size > MaxFileBytes)
        {
            throw new InvalidOperationException("too large");
        }

        await using var stream = file.OpenReadStream(MaxFileBytes);
        var created = await Client.UploadReleaseAsync(
            uploadKind, string.IsNullOrWhiteSpace(uploadNotes) ? null : uploadNotes.Trim(),
            new Refit.StreamPart(stream, file.Name, "text/plain"));
        chosenFile = null;
        uploadNotes = null;
        return string.Format(Localizer["Uploaded {0} {1} as a draft. Nothing is delivered until you publish it."], KindLabel(created.Kind), created.Version);
    }, "upload the release");

    private void StartPublish(PluginReleaseDto release)
    {
        CancelConfirm();
        releaseTarget = release;
        confirm = Confirm.Publish;
    }

    private Task PublishAsync() => RunAsync(async () =>
    {
        var published = await Client.PublishReleaseAsync(releaseTarget!.Id);
        return published.IsServed
            ? string.Format(Localizer["Published {0} {1}. It is now what this Panel delivers."], KindLabel(published.Kind), published.Version)
            : string.Format(Localizer["Published {0} {1}. It is not newer than what is already delivered, so nothing changes yet."], KindLabel(published.Kind), published.Version);
    }, "publish the release");

    private void StartWithdraw(PluginReleaseDto release)
    {
        CancelConfirm();
        releaseTarget = release;
        confirm = Confirm.Withdraw;
    }

    private Task WithdrawAsync() => RunAsync(async () =>
    {
        var target = releaseTarget!;
        await Client.WithdrawReleaseAsync(target.Id, new WithdrawPluginReleaseRequestDto { Reason = reason!.Trim() });
        return string.Format(Localizer["Withdrew {0} {1}."], KindLabel(target.Kind), target.Version);
    }, "withdraw the release");

    private string KindLabel(string kind) => kind == "main" ? "RustArchon.cs" : "RustArchonUpdater.cs";

    // ---- signing a file, and downloading a stored release signed ---------------------------------------------

    private void OnSignFileChosen(InputFileChangeEventArgs e) => signFile = e.File;

    private async Task SignFileAsync()
    {
        var file = signFile!;
        if (file.Size > MaxFileBytes)
        {
            errorMessage = string.Format(Localizer["That file is over {0} KiB."], MaxFileBytes / 1024);
            return;
        }

        busy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileBytes);
            using var response = await Client.SignFileAsync(signKind, signNote!.Trim(), new Refit.StreamPart(stream, file.Name, "text/plain"));
            var fileName = await HandOverFileAsync(response, KindLabel(signKind), "sign the file");
            if (fileName is not null)
            {
                signFile = null;
                signNote = null;
                successMessage = string.Format(Localizer["Signed {0} with the active key. Install it by hand on a server that trusts this Panel. It was recorded in the audit log."], fileName);
                events = await Client.GetEventsAsync(50);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "sign the file");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DownloadReleaseAsync(PluginReleaseDto release)
    {
        busy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            using var response = await Client.DownloadReleaseAsync(release.Id);
            var fileName = await HandOverFileAsync(response, KindLabel(release.Kind), "download the release");
            if (fileName is not null)
            {
                successMessage = string.Format(Localizer["Downloaded {0} {1}, signed with the active key, for a test install. It was recorded in the audit log."], KindLabel(release.Kind), release.Version);
                events = await Client.GetEventsAsync(50);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "download the release");
        }
        finally
        {
            busy = false;
        }
    }

    // Hands a signed file the Api returned to the browser byte for byte (the signature covers its exact bytes). Returns its name, or null after
    // putting the Api's sentence (or a generic one) on the page.
    private async Task<string?> HandOverFileAsync(HttpResponseMessage response, string fallbackName, string failureAction)
    {
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = response.StatusCode == HttpStatusCode.BadRequest
                ? await response.Content.ReadAsStringAsync()
                : ApiErrorMessage.For(new InvalidOperationException($"The Api answered {(int)response.StatusCode}."), failureAction);
            return null;
        }

        var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
            ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
            ?? fallbackName;
        var bytes = await response.Content.ReadAsByteArrayAsync();
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
        await module.InvokeVoidAsync("downloadBytes", fileName, Convert.ToBase64String(bytes), "text/plain");
        return fileName;
    }

    // How far a newly served version's staged roll-out has got, beside what is being served. Nothing when there is no ramp or it has not begun.
    private RenderFragment RolloutNote(PluginServedDto served) => builder =>
    {
        if (served.RolloutPercent is null || served.RolloutHours <= 0 || served.RolloutStartedUtc is null)
        {
            return;
        }

        var text = served.RolloutPercent >= 100
            ? string.Format(Localizer["rolled out to every server that updates automatically"])
            : string.Format(Localizer["rolling out: {0}% of servers that update automatically are eligible now, everyone by {1} UTC"], served.RolloutPercent, served.RolloutStartedUtc.Value.AddHours(served.RolloutHours).ToString("yyyy-MM-dd HH:mm"));
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "text-muted ms-3");
        builder.AddAttribute(2, "data-testid", "rollout-" + served.Kind);
        builder.AddContent(3, text);
        builder.CloseElement();
    };

    private string EventLabel(string kind) => kind switch
    {
        "KeyRotated" => Localizer["Key rotated"],
        "KeyRevoked" => Localizer["Key revoked"],
        "KeysExported" => Localizer["Keys exported"],
        "KeysImported" => Localizer["Keys imported"],
        "ReleaseUploaded" => Localizer["Release uploaded"],
        "ReleasePublished" => Localizer["Release published"],
        "ReleaseWithdrawn" => Localizer["Release withdrawn"],
        "KeyGenerated" => Localizer["Key generated"],
        "FileSigned" => Localizer["File signed"],
        "ReleaseSigned" => Localizer["Release downloaded signed"],
        _ => kind
    };
}
