@page "/Admin/Invoices"
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IBillingApiClient BillingClient
@rendermode RenderModes.NonPrerenderedServer

@*
    Deliberately not built on the reporting components. Those are for pages whose whole purpose is one
    result set; this one has actions on every row, which is exactly the mixed-content case they were
    scoped to exclude. Receivables is the read-only view of the same money.
*@
<PageTitle>@Localizer["Invoices"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@Localizer["Invoices"]</h1>
    <a class="btn btn-outline-secondary" href="Reports/Receivables">
        <i class="bi bi-cash-stack" aria-hidden="true"></i> @Localizer["Receivables report"]
    </a>
</div>

@if (accessDenied)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-lock"></i> @Localizer["You don't have access to manage billing."]
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="mb-3">
        <div class="btn-group" role="group">
            @foreach (var option in StatusFilters)
            {
                <button type="button"
                        class="btn btn-sm @(statusFilter == option.Value ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetFilter(option.Value)">
                    @option.Label
                </button>
            }
        </div>
    </div>

    @if (loading)
    {
        <p><em>@Localizer["Loading invoices..."]</em></p>
    }
    else if (invoices.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Localizer["No invoices match this filter."]
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Localizer["Invoice"]</th>
                        <th>@Localizer["Organization"]</th>
                        <th>@Localizer["Issued"]</th>
                        <th>@Localizer["Due"]</th>
                        <th class="text-end">@Localizer["Total"]</th>
                        <th class="text-end">@Localizer["Paid"]</th>
                        <th class="text-end">@Localizer["Credited"]</th>
                        <th class="text-end">@Localizer["Outstanding"]</th>
                        <th>@Localizer["Status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in invoices)
                    {
                        <tr>
                            <td><code>@invoice.Number</code></td>
                            <td>@invoice.OrganizationName</td>
                            <td>@Date(invoice.IssuedOn)</td>
                            <td>@Date(invoice.DueOn)</td>
                            <td class="text-end">@invoice.Total.ToString("C", Money)</td>
                            <td class="text-end">@Blank(invoice.AmountPaid)</td>
                            <td class="text-end">@Blank(invoice.AmountCredited)</td>
                            <td class="text-end fw-semibold">@Blank(invoice.Outstanding)</td>
                            <td>
                                <span class="badge @StatusClass(invoice)">@StatusText(invoice)</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => Toggle(invoice.Id)">
                                    @(expandedId == invoice.Id ? Localizer["Hide"] : Localizer["Details"])
                                </button>
                            </td>
                        </tr>

                        @if (expandedId == invoice.Id)
                        {
                            <tr class="table-light">
                                <td colspan="10">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <h6 class="text-muted text-uppercase small">@Localizer["Lines"]</h6>
                                            <table class="table table-sm mb-0">
                                                <tbody>
                                                    @foreach (var line in invoice.Lines)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @line.Description
                                                                <div class="text-muted small">
                                                                    @Date(line.ServiceStart) – @Date(line.ServiceEnd)
                                                                    @if (line.Quantity > 1)
                                                                    {
                                                                        <span>@Localizer["· {0} slots", line.Quantity]</span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td class="text-end">@line.Amount.ToString("C", Money)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                            @if (invoice.Settlements.Count > 0)
                                            {
                                                <h6 class="text-muted text-uppercase small mt-3">@Localizer["Settlements"]</h6>
                                                <table class="table table-sm mb-0">
                                                    <tbody>
                                                        @foreach (var settlement in invoice.Settlements)
                                                        {
                                                            <tr class="@(settlement.ReversedOn is not null ? "text-muted" : null)">
                                                                <td>
                                                                    @settlement.Kind
                                                                    @if (settlement.Method is { } method)
                                                                    {
                                                                        <span class="text-muted small">· @method</span>
                                                                    }
                                                                    @if (settlement.ReversedOn is not null)
                                                                    {
                                                                        <span class="badge bg-secondary ms-1">@Localizer["Reversed"]</span>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(settlement.Reference))
                                                                    {
                                                                        <div class="small">@settlement.Reference</div>
                                                                    }
                                                                </td>
                                                                <td class="text-end">
                                                                    <span class="@(settlement.ReversedOn is not null ? "text-decoration-line-through" : null)">
                                                                        @settlement.Amount.ToString("C", Money)
                                                                    </span>
                                                                    <div class="text-muted small">@Date(settlement.AppliedOn)</div>
                                                                </td>
                                                                <td class="text-end">
                                                                    @if (settlement.Kind == "Payment" && settlement.ReversedOn is null)
                                                                    {
                                                                        <button class="btn btn-sm btn-outline-danger"
                                                                                disabled="@working"
                                                                                @onclick="() => Reverse(settlement.Id, PaymentStatus.Refunded)">
                                                                            @Localizer["Refund"]
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>

                                        <div class="col-md-6">
                                            @if (invoice.Status == InvoiceStatus.Open)
                                            {
                                                <h6 class="text-muted text-uppercase small">@Localizer["Record a payment"]</h6>
                                                <div class="row g-2 align-items-end mb-3">
                                                    <div class="col-4">
                                                        <label class="form-label small">@Localizer["Amount"]</label>
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">$</span>
                                                            <input type="number" step="0.01" min="0.01" class="form-control"
                                                                   value="@paymentAmount.ToString(CultureInfo.InvariantCulture)"
                                                                   @onchange="e => SetAmount(e.Value?.ToString())" />
                                                        </div>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small">@Localizer["Method"]</label>
                                                        <select class="form-select form-select-sm"
                                                                @onchange="e => paymentMethod = Enum.Parse<PaymentMethod>(e.Value?.ToString() ?? nameof(PaymentMethod.Manual))">
                                                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                                                            {
                                                                <option value="@method" selected="@(paymentMethod == method)">@method</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small">@Localizer["Reference"]</label>
                                                        <input class="form-control form-control-sm"
                                                               value="@paymentReference"
                                                               @onchange="e => paymentReference = e.Value?.ToString()" />
                                                    </div>
                                                </div>
                                                <button class="btn btn-primary btn-sm" disabled="@working"
                                                        @onclick="() => RecordPayment(invoice)">
                                                    @Localizer["Record payment"]
                                                </button>

                                                <hr class="my-3" />

                                                <h6 class="text-muted text-uppercase small">@Localizer["Close without payment"]</h6>
                                                <div class="mb-2">
                                                    <input class="form-control form-control-sm" placeholder="@Localizer["Reason"]"
                                                           value="@closeReason"
                                                           @onchange="e => closeReason = e.Value?.ToString()" />
                                                </div>
                                                <div class="d-flex gap-2 flex-wrap">
                                                    <button class="btn btn-sm btn-outline-secondary" disabled="@working"
                                                            @onclick="() => Credit(invoice)">
                                                        @Localizer["Credit {0}", invoice.Outstanding.ToString("C", Money)]
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-warning" disabled="@working"
                                                            @onclick="() => WriteOff(invoice)"
                                                            title="@Localizer["The debt was real and you're giving up on it. Stays in the books as bad debt."]">
                                                        @Localizer["Write off"]
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" disabled="@working"
                                                            @onclick="() => Void(invoice)"
                                                            title="@Localizer["This invoice should never have existed. Removed from receivables entirely."]">
                                                        @Localizer["Void"]
                                                    </button>
                                                </div>
                                                <div class="form-text">
                                                    @Localizer["Writing off keeps the debt in the books as an expense; voiding says it was never owed. They are not interchangeable."]
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted">
                                                    @Localizer["This invoice is {0}.", StatusText(invoice)]@(invoice.Status == InvoiceStatus.Paid
                                                        ? " " + Localizer["Refund a payment above to reopen it."]
                                                        : string.Empty)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<InvoiceDto> invoices = [];
    private InvoiceStatus? statusFilter = InvoiceStatus.Open;
    private Guid? expandedId;

    private bool loading = true;
    private bool working;
    private bool accessDenied;
    private string? errorMessage;
    private string? successMessage;

    private decimal paymentAmount;
    private PaymentMethod paymentMethod = PaymentMethod.Manual;
    private string? paymentReference;
    private string? closeReason;

    private static readonly CultureInfo Money = CultureInfo.GetCultureInfo("en-US");
    private static readonly CultureInfo Dates = CultureInfo.InvariantCulture;

    // A property, not a field initializer - @inject properties like Localizer aren't populated yet
    // when field initializers run (see ConfirmationModal.razor for the same pattern).
    private (string Label, InvoiceStatus? Value)[] StatusFilters =>
    [
        (Localizer["Open"], InvoiceStatus.Open),
        (Localizer["Paid"], InvoiceStatus.Paid),
        (Localizer["Written off"], InvoiceStatus.Uncollectible),
        (Localizer["Void"], InvoiceStatus.Void),
        (Localizer["All"], null)
    ];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SetFilter(InvoiceStatus? status)
    {
        statusFilter = status;
        expandedId = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            invoices = await BillingClient.GetInvoicesAsync(statusFilter);
            accessDenied = false;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            accessDenied = true;
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load invoices");
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Opening a row pre-fills the payment box with the whole balance - the overwhelmingly common case
    /// is somebody paying what they owe, and a partial payment is then an edit rather than a full entry.
    /// </summary>
    private void Toggle(Guid invoiceId)
    {
        if (expandedId == invoiceId)
        {
            expandedId = null;
            return;
        }

        expandedId = invoiceId;
        paymentAmount = invoices.FirstOrDefault(i => i.Id == invoiceId)?.Outstanding ?? 0m;
        paymentReference = null;
        closeReason = null;
    }

    private void SetAmount(string? raw)
    {
        if (decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            paymentAmount = Math.Max(0m, value);
        }
    }

    private Task RecordPayment(InvoiceDto invoice) =>
        RunAsync(
            () => BillingClient.RecordPaymentAsync(new RecordPaymentRequestDto
            {
                InvoiceId = invoice.Id,
                Amount = paymentAmount,
                Method = paymentMethod,
                Reference = paymentReference
            }),
            Localizer["Recorded {0} against {1}.", paymentAmount.ToString("C", Money), invoice.Number],
            "record that payment");

    private Task Credit(InvoiceDto invoice) =>
        RunAsync(
            () => BillingClient.IssueCreditNoteAsync(new IssueCreditNoteRequestDto
            {
                InvoiceId = invoice.Id,
                Amount = invoice.Outstanding,
                Reason = string.IsNullOrWhiteSpace(closeReason) ? Localizer["Credit issued by an administrator"] : closeReason!
            }),
            Localizer["Credited {0} against {1}.", invoice.Outstanding.ToString("C", Money), invoice.Number],
            "issue that credit note");

    private Task WriteOff(InvoiceDto invoice) =>
        RunAsync(
            () => BillingClient.WriteOffInvoiceAsync(new CloseInvoiceRequestDto
            {
                InvoiceId = invoice.Id,
                Reason = closeReason
            }),
            Localizer["Wrote off {0}.", invoice.Number],
            "write off that invoice");

    private Task Void(InvoiceDto invoice) =>
        RunAsync(
            () => BillingClient.VoidInvoiceAsync(new CloseInvoiceRequestDto
            {
                InvoiceId = invoice.Id,
                Reason = closeReason
            }),
            Localizer["Voided {0}.", invoice.Number],
            "void that invoice");

    private Task Reverse(Guid paymentId, PaymentStatus status) =>
        RunAsync(
            () => BillingClient.ReversePaymentAsync(paymentId, status),
            Localizer["Payment reversed. Anything it settled is owed again."],
            "reverse that payment");

    /// <summary>
    /// Runs one billing action, then reloads from the server rather than patching the row in place -
    /// an operation can touch several invoices (a payment spilling onto older ones), so what changed
    /// isn't knowable from the response alone.
    /// </summary>
    private async Task RunAsync(Func<Task> action, string success, string what)
    {
        working = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await action();
            successMessage = success;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, what);
        }
        finally
        {
            working = false;
        }
    }

    private static string Date(DateTimeOffset? value) =>
        value is { } v ? v.UtcDateTime.ToString("d MMM yyyy", Dates) : string.Empty;

    private static string Blank(decimal amount) =>
        amount == 0m ? string.Empty : amount.ToString("C", Money);

    private string StatusText(InvoiceDto invoice) => invoice.Status switch
    {
        InvoiceStatus.Open when invoice.DaysOverdue > 0 => Localizer["{0}d overdue", invoice.DaysOverdue],
        InvoiceStatus.Open when invoice.AmountPaid > 0m => Localizer["Part paid"],
        InvoiceStatus.Uncollectible => Localizer["Written off"],
        _ => invoice.Status.ToString()
    };

    private static string StatusClass(InvoiceDto invoice) => invoice.Status switch
    {
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Open when invoice.DaysOverdue > 0 => "bg-danger",
        InvoiceStatus.Open => "bg-warning text-dark",
        InvoiceStatus.Uncollectible => "bg-dark",
        _ => "bg-secondary"
    };
}
