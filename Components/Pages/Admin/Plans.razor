@page "/Admin/Plans"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IPlanApiClient PlanClient
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>Plans</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Plans</h1>
    @if (accessDenied != true)
    {
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> New Plan
        </button>
    }
</div>

@if (accessDenied == true)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-lock"></i> You don't have access to manage plans.
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (creating)
    {
        <div class="card mb-4">
            <div class="card-header">New Plan</div>
            <div class="card-body">
                <EditForm Model="createForm" OnValidSubmit="SaveCreate">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="create-name">Name</label>
                            <InputText id="create-name" class="form-control" @bind-Value="createForm.Name" placeholder="e.g. Wood, Starter, Pro" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="create-color">Color</label>
                            <input id="create-color" type="color" class="form-control form-control-color" @bind="createForm.ColorCode" @bind:event="oninput" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="create-monthly">Monthly Price</label>
                            <InputNumber id="create-monthly" class="form-control" @bind-Value="createForm.MonthlyPrice" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="create-quarterly">Quarterly Price</label>
                            <InputNumber id="create-quarterly" class="form-control" @bind-Value="createForm.QuarterlyPrice" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="create-annual">Annual Price</label>
                            <InputNumber id="create-annual" class="form-control" @bind-Value="createForm.AnnualPrice" />
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RecalculatePrices(createForm)">
                                <i class="bi bi-arrow-repeat"></i> Recalculate Quarterly/Annual from Monthly (×2.75 / ×10)
                            </button>
                        </div>
                        @foreach (var warning in GetPriceWarnings(createForm.MonthlyPrice, createForm.QuarterlyPrice, createForm.AnnualPrice))
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 mb-0"><i class="bi bi-exclamation-triangle"></i> @warning</div>
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="create-retention">Retention (days)</label>
                            <InputNumber id="create-retention" class="form-control" @bind-Value="createForm.RetentionHistory" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="create-servers">Maximum Servers</label>
                            <InputNumber id="create-servers" class="form-control" @bind-Value="createForm.MaximumServers" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="create-users">Maximum Users</label>
                            <InputNumber id="create-users" class="form-control" @bind-Value="createForm.MaximumUsers" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox id="create-roles" class="form-check-input" @bind-Value="createForm.HasRoles" />
                                <label class="form-check-label" for="create-roles">Role separation</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox id="create-active" class="form-check-input" @bind-Value="createForm.Active" />
                                <label class="form-check-label" for="create-active">Active</label>
                            </div>
                        </div>
                    </div>

                    @if (createForm.Active)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-info-circle"></i> Marking this Active will deactivate any other
                            active plan named "@createForm.Name".
                        </div>
                    }

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Creating..." : "Create Plan")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelCreate" disabled="@saving">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (editingPlan != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <span class="plan-color-dot" style="background-color: @editingPlan.ColorCode"></span>
                Edit @editingPlan.Name Plan
            </div>
            <div class="card-body">
                @if (editingPlan.SubscriberCount > 0)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> @editingPlan.SubscriberCount organization(s) are on
                        this plan. Saving changes here will create a new "@editingPlan.Name" plan with these
                        terms and deactivate the current one - existing subscribers stay on their current
                        terms.
                    </div>
                }

                <EditForm Model="editForm" OnValidSubmit="SubmitEdit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="edit-color">Color</label>
                            <input id="edit-color" type="color" class="form-control form-control-color" @bind="editForm.ColorCode" @bind:event="oninput" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="edit-monthly">Monthly Price</label>
                            <InputNumber id="edit-monthly" class="form-control" @bind-Value="editForm.MonthlyPrice" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="edit-quarterly">Quarterly Price</label>
                            <InputNumber id="edit-quarterly" class="form-control" @bind-Value="editForm.QuarterlyPrice" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="edit-annual">Annual Price</label>
                            <InputNumber id="edit-annual" class="form-control" @bind-Value="editForm.AnnualPrice" />
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RecalculatePrices(editForm)">
                                <i class="bi bi-arrow-repeat"></i> Recalculate Quarterly/Annual from Monthly (×2.75 / ×10)
                            </button>
                        </div>
                        @foreach (var warning in GetPriceWarnings(editForm.MonthlyPrice, editForm.QuarterlyPrice, editForm.AnnualPrice))
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 mb-0"><i class="bi bi-exclamation-triangle"></i> @warning</div>
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="edit-retention">Retention (days)</label>
                            <InputNumber id="edit-retention" class="form-control" @bind-Value="editForm.RetentionHistory" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="edit-servers">Maximum Servers</label>
                            <InputNumber id="edit-servers" class="form-control" @bind-Value="editForm.MaximumServers" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="edit-users">Maximum Users</label>
                            <InputNumber id="edit-users" class="form-control" @bind-Value="editForm.MaximumUsers" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox id="edit-roles" class="form-check-input" @bind-Value="editForm.HasRoles" />
                                <label class="form-check-label" for="edit-roles">Role separation</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox id="edit-active" class="form-check-input" @bind-Value="editForm.Active" />
                                <label class="form-check-label" for="edit-active">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : "Save")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@saving">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (loading)
    {
        <p><em>Loading plans...</em></p>
    }
    else if (plans != null)
    {
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="show-inactive-plans" @bind="showInactive" />
            <label class="form-check-label" for="show-inactive-plans">Show inactive plans</label>
        </div>

        @if (VisiblePlans.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Name</th>
                            <th>Monthly</th>
                            <th>Quarterly</th>
                            <th>Annual</th>
                            <th>Retention</th>
                            <th>Roles</th>
                            <th>Max Servers</th>
                            <th>Max Users</th>
                            <th>Subscribers</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in VisiblePlans)
                        {
                            <tr>
                                <td>
                                    @if (plan.Active)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="plan-name-cell">
                                        <span class="plan-color-dot" style="background-color: @plan.ColorCode"></span>
                                        @plan.Name
                                    </span>
                                </td>
                                <td>@plan.MonthlyPrice.ToString("C")</td>
                                <td>@plan.QuarterlyPrice.ToString("C")</td>
                                <td>@plan.AnnualPrice.ToString("C")</td>
                                <td>@plan.RetentionHistory days</td>
                                <td>@(plan.HasRoles ? "Yes" : "No")</td>
                                <td>@plan.MaximumServers</td>
                                <td>@plan.MaximumUsers</td>
                                <td>@plan.SubscriberCount</td>
                                <td>@plan.CreatedOn.LocalDateTime.ToString("g")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowEditForm(plan)">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        @if (plan.SubscriberCount == 0)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(plan)">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (!plans.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No plans yet. Create one to get started - every new
                Organization needs at least one active plan to sign up (new signups land on the cheapest
                active plan, or the site's configured default).
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No active plans. Check "Show inactive plans" above to
                see historical ones.
            </div>
        }
    }

    @if (showSupersedeConfirmation && editingPlan != null)
    {
        <RustArchon.Panel.Components.Shared.ConfirmationModal
            Title="Create New Plan?"
            ConfirmButtonText="Create and Deactivate Current"
            ConfirmButtonClass="btn-primary"
            OnClose="HandleSupersedeModalClose">
            <Message>
                @editingPlan.SubscriberCount organization(s) are on the current "@editingPlan.Name" plan.
                Saving will create a new "@editingPlan.Name" plan with these terms and deactivate the
                current one. Existing subscribers keep their current terms. Proceed?
            </Message>
        </RustArchon.Panel.Components.Shared.ConfirmationModal>
    }

    @if (showDeleteConfirmation && planToDelete != null)
    {
        <RustArchon.Panel.Components.Shared.ConfirmationModal
            Title="Delete Plan"
            ConfirmButtonText="Delete"
            ConfirmButtonClass="btn-danger"
            OnClose="HandleDeleteModalClose">
            <Message>
                Are you sure you want to permanently delete this "@planToDelete.Name" plan
                (@planToDelete.MonthlyPrice.ToString("C")/mo, created @planToDelete.CreatedOn.LocalDateTime.ToString("g"))?
                This cannot be undone.
            </Message>
        </RustArchon.Panel.Components.Shared.ConfirmationModal>
    }
}

@code {
    private List<PlanDto>? plans;
    private bool loading = true;
    private bool saving;
    private bool? accessDenied;
    private string? errorMessage;
    private string? successMessage;

    private bool showInactive;

    private bool creating;
    private CreateFormModel createForm = new();

    private PlanDto? editingPlan;
    private EditFormModel editForm = new();
    private bool showSupersedeConfirmation;

    private bool showDeleteConfirmation;
    private PlanDto? planToDelete;

    // Same "start out with, then stays independently editable" ratios the user specified - not a
    // live-synced relationship, just what the Recalculate button applies on demand so an admin isn't
    // doing the arithmetic by hand.
    private const decimal QuarterlyMultiplier = 2.75m;
    private const decimal AnnualMultiplier = 10m;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlans();
    }

    // Active-only by default (showInactive off) - a single flat grid, not one table per Name, since
    // Name is no longer a fixed enum with a small known set of values (see Plan.Name's remarks) and an
    // admin could plausibly have many. Ordered by Name so same-named historical rows still land next
    // to each other, newest first within that.
    private IEnumerable<PlanDto> VisiblePlans =>
        (plans ?? Enumerable.Empty<PlanDto>())
            .Where(p => showInactive || p.Active)
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ThenByDescending(p => p.CreatedOn);

    private async Task LoadPlans()
    {
        loading = true;
        errorMessage = null;
        try
        {
            plans = await PlanClient.GetAllPlansAsync();
            accessDenied = false;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            accessDenied = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load plans: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateForm()
    {
        createForm = new CreateFormModel();
        creating = true;
    }

    private void CancelCreate()
    {
        creating = false;
    }

    // Applied to whichever form (create or edit) the admin clicked the button on - overwrites
    // Quarterly/Annual with the standard ratios against the form's current Monthly price. Both fields
    // stay plain, independently-editable inputs afterward.
    private void RecalculatePrices(PriceFormModel form)
    {
        form.QuarterlyPrice = Math.Round(form.MonthlyPrice * QuarterlyMultiplier, 2);
        form.AnnualPrice = Math.Round(form.MonthlyPrice * AnnualMultiplier, 2);
    }

    // Non-blocking sanity checks, not validation errors - a plan can still be saved with "worse than
    // monthly" pricing if that's genuinely what the admin wants (e.g. a deliberately-unappealing
    // Quarterly option meant to push people to Annual instead).
    private static List<string> GetPriceWarnings(decimal monthly, decimal quarterly, decimal annual)
    {
        var warnings = new List<string>();

        if (quarterly > monthly * 3m)
        {
            warnings.Add("Quarterly price is more than 3× the monthly price - a subscriber would pay less just paying monthly for 3 months.");
        }

        if (annual > monthly * 12m)
        {
            warnings.Add("Annual price is more than 12× the monthly price - a subscriber would pay less just paying monthly for 12 months.");
        }

        if (annual > quarterly * 4m)
        {
            warnings.Add("Annual price is more than 4× the quarterly price - a subscriber would pay less just paying quarterly four times.");
        }

        return warnings;
    }

    private async Task SaveCreate()
    {
        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var created = await PlanClient.CreateAsync(new CreatePlanDto
            {
                Name = createForm.Name,
                ColorCode = createForm.ColorCode,
                MonthlyPrice = createForm.MonthlyPrice,
                QuarterlyPrice = createForm.QuarterlyPrice,
                AnnualPrice = createForm.AnnualPrice,
                RetentionHistory = createForm.RetentionHistory,
                HasRoles = createForm.HasRoles,
                MaximumServers = createForm.MaximumServers,
                MaximumUsers = createForm.MaximumUsers,
                Active = createForm.Active
            });
            successMessage = $"{created.Name} plan created.";
            creating = false;
            await LoadPlans();
        }
        catch (Refit.ApiException ex)
        {
            errorMessage = $"Failed to create plan: {ex.Message}{(string.IsNullOrEmpty(ex.Content) ? "" : $" — {ex.Content}")}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create plan: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowEditForm(PlanDto plan)
    {
        editingPlan = plan;
        editForm = new EditFormModel
        {
            ColorCode = plan.ColorCode,
            MonthlyPrice = plan.MonthlyPrice,
            QuarterlyPrice = plan.QuarterlyPrice,
            AnnualPrice = plan.AnnualPrice,
            RetentionHistory = plan.RetentionHistory,
            HasRoles = plan.HasRoles,
            MaximumServers = plan.MaximumServers,
            MaximumUsers = plan.MaximumUsers,
            Active = plan.Active
        };
    }

    private void CancelEdit()
    {
        editingPlan = null;
        showSupersedeConfirmation = false;
    }

    // Zero subscribers: edit in place directly. One or more: hand off to the confirmation modal first -
    // see HandleSupersedeModalClose - per the confirmed admin UX (editing a subscribed plan forks a new
    // Plan row rather than silently rewriting terms out from under existing subscribers).
    private async Task SubmitEdit()
    {
        if (editingPlan == null)
        {
            return;
        }

        if (editingPlan.SubscriberCount > 0)
        {
            showSupersedeConfirmation = true;
            return;
        }

        await SaveEditInPlace();
    }

    private async Task SaveEditInPlace()
    {
        if (editingPlan == null)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await PlanClient.UpdateAsync(editingPlan.Id, new UpdatePlanDto
            {
                Id = editingPlan.Id,
                ColorCode = editForm.ColorCode,
                MonthlyPrice = editForm.MonthlyPrice,
                QuarterlyPrice = editForm.QuarterlyPrice,
                AnnualPrice = editForm.AnnualPrice,
                RetentionHistory = editForm.RetentionHistory,
                HasRoles = editForm.HasRoles,
                MaximumServers = editForm.MaximumServers,
                MaximumUsers = editForm.MaximumUsers,
                Active = editForm.Active
            });
            successMessage = $"{editingPlan.Name} plan updated.";
            editingPlan = null;
            await LoadPlans();
        }
        catch (Refit.ApiException ex)
        {
            errorMessage = $"Failed to update plan: {ex.Message}{(string.IsNullOrEmpty(ex.Content) ? "" : $" — {ex.Content}")}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update plan: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task HandleSupersedeModalClose(bool confirmed)
    {
        showSupersedeConfirmation = false;

        if (!confirmed || editingPlan == null)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var superseded = await PlanClient.SupersedeAsync(editingPlan.Id, new SupersedePlanDto
            {
                ColorCode = editForm.ColorCode,
                MonthlyPrice = editForm.MonthlyPrice,
                QuarterlyPrice = editForm.QuarterlyPrice,
                AnnualPrice = editForm.AnnualPrice,
                RetentionHistory = editForm.RetentionHistory,
                HasRoles = editForm.HasRoles,
                MaximumServers = editForm.MaximumServers,
                MaximumUsers = editForm.MaximumUsers
            });
            successMessage = $"A new {superseded.Name} plan was created and the previous one deactivated.";
            editingPlan = null;
            await LoadPlans();
        }
        catch (Refit.ApiException ex)
        {
            errorMessage = $"Failed to create new plan: {ex.Message}{(string.IsNullOrEmpty(ex.Content) ? "" : $" — {ex.Content}")}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create new plan: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void ConfirmDelete(PlanDto plan)
    {
        planToDelete = plan;
        showDeleteConfirmation = true;
    }

    private async Task HandleDeleteModalClose(bool confirmed)
    {
        showDeleteConfirmation = false;

        if (!confirmed || planToDelete == null)
        {
            planToDelete = null;
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            await PlanClient.DeleteAsync(planToDelete.Id);
            successMessage = $"{planToDelete.Name} plan deleted.";
            await LoadPlans();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            errorMessage = ex.Content ?? "That plan has subscribers and can't be deleted. Deactivate it instead.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete plan: {ex.Message}";
        }
        finally
        {
            planToDelete = null;
        }
    }

    // Common base so RecalculatePrices can operate on either form model without two overloads.
    private abstract class PriceFormModel
    {
        [Range(0, double.MaxValue)]
        public decimal MonthlyPrice { get; set; }

        [Range(0, double.MaxValue)]
        public decimal QuarterlyPrice { get; set; }

        [Range(0, double.MaxValue)]
        public decimal AnnualPrice { get; set; }
    }

    private sealed class CreateFormModel : PriceFormModel
    {
        [Required]
        [MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Must be a 6-digit hex color.")]
        public string ColorCode { get; set; } = "#888888";

        [Range(0, int.MaxValue)]
        public int RetentionHistory { get; set; } = 30;

        public bool HasRoles { get; set; }

        [Range(0, int.MaxValue)]
        public int MaximumServers { get; set; } = 1;

        [Range(0, int.MaxValue)]
        public int MaximumUsers { get; set; } = 1;

        public bool Active { get; set; }
    }

    private sealed class EditFormModel : PriceFormModel
    {
        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Must be a 6-digit hex color.")]
        public string ColorCode { get; set; } = "#888888";

        [Range(0, int.MaxValue)]
        public int RetentionHistory { get; set; }

        public bool HasRoles { get; set; }

        [Range(0, int.MaxValue)]
        public int MaximumServers { get; set; }

        [Range(0, int.MaxValue)]
        public int MaximumUsers { get; set; }

        public bool Active { get; set; }
    }
}
