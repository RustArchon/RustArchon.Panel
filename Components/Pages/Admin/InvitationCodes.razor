@page "/Admin/InvitationCodes"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IInvitationCodeApiClient InvitationCodeClient
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>@Localizer["Invitation Codes"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Localizer["Invitation Codes"]</h1>
    @if (accessDenied != true)
    {
        <button class="btn btn-primary" @onclick="ShowMintForm">
            <i class="bi bi-plus-circle"></i> @Localizer["Mint Code"]
        </button>
    }
</div>

@if (accessDenied == true)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-lock"></i> @Localizer["You don't have access to manage invitation codes."]
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (minting)
    {
        <div class="card mb-4">
            <div class="card-header">@Localizer["Mint Invitation Code"]</div>
            <div class="card-body">
                <EditForm Model="mintForm" OnValidSubmit="SaveMint">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="code-note">@Localizer["Note"]</label>
                            <InputText id="code-note" class="form-control" @bind-Value="mintForm.Note" placeholder="e.g. Discord mods batch" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="code-email">@Localizer["Bind to email (optional)"]</label>
                            <InputText id="code-email" class="form-control" @bind-Value="mintForm.BoundEmail" placeholder="@Localizer["Leave blank to let anyone redeem it first"]" />
                            <ValidationMessage For="() => mintForm.BoundEmail" class="text-danger" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? Localizer["Minting..."] : Localizer["Mint Code"])
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelMint" disabled="@saving">
                            @Localizer["Cancel"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (loading)
    {
        <p><em>@Localizer["Loading invitation codes..."]</em></p>
    }
    else if (codes != null)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Localizer["Code"]</th>
                        <th>@Localizer["Note"]</th>
                        <th>@Localizer["Bound Email"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Created"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in codes.OrderByDescending(c => c.CreatedOn))
                    {
                        <tr>
                            <td><code>@invite.Code</code></td>
                            <td>@invite.Note</td>
                            <td>@(invite.BoundEmail ?? Localizer["Anyone"])</td>
                            <td>@StatusLabel(invite)</td>
                            <td>@invite.CreatedOn.LocalDateTime.ToString("g")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    @if (invite.RedeemedAtUtc == null && invite.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActive(invite, false)">
                                            <i class="bi bi-slash-circle"></i> @Localizer["Revoke"]
                                        </button>
                                    }
                                    else if (invite.RedeemedAtUtc == null && !invite.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActive(invite, true)">
                                            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reactivate"]
                                        </button>
                                    }
                                    @if (invite.RedeemedAtUtc == null)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(invite)">
                                            <i class="bi bi-trash"></i> @Localizer["Delete"]
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!codes.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Localizer["No invitation codes yet. Mint one to invite someone to sign up."]
            </div>
        }
    }

    @if (showDeleteConfirmation && codeToDelete != null)
    {
        <RustArchon.Panel.Components.Shared.ConfirmationModal
            Title="@Localizer["Delete Invitation Code"]"
            ConfirmButtonText="@Localizer["Delete"]"
            ConfirmButtonClass="btn-danger"
            OnClose="HandleDeleteModalClose">
            <Message>
                @Localizer["Are you sure you want to permanently delete code '{0}'? This cannot be undone.", codeToDelete.Code]
            </Message>
        </RustArchon.Panel.Components.Shared.ConfirmationModal>
    }
}

@code {
    private IEnumerable<InvitationCodeDto>? codes;
    private bool loading = true;
    private bool saving;
    private bool minting;
    private bool? accessDenied;
    private string? errorMessage;
    private string? successMessage;
    private MintFormModel mintForm = new();
    private bool showDeleteConfirmation;
    private InvitationCodeDto? codeToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadCodes();
    }

    private async Task LoadCodes()
    {
        loading = true;
        errorMessage = null;
        try
        {
            var result = await InvitationCodeClient.GetAllAsync();
            codes = result.Items;
            accessDenied = false;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            accessDenied = true;
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load invitation codes");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowMintForm()
    {
        mintForm = new MintFormModel();
        minting = true;
    }

    private void CancelMint()
    {
        minting = false;
    }

    private async Task SaveMint()
    {
        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var created = await InvitationCodeClient.CreateAsync(new CreateInvitationCodeDto
            {
                Note = string.IsNullOrWhiteSpace(mintForm.Note) ? null : mintForm.Note,
                BoundEmail = string.IsNullOrWhiteSpace(mintForm.BoundEmail) ? null : mintForm.BoundEmail
            });
            successMessage = Localizer["Code '{0}' was minted.", created.Code];
            minting = false;
            await LoadCodes();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "mint code");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActive(InvitationCodeDto code, bool isActive)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            await InvitationCodeClient.UpdateAsync(code.Id, new UpdateInvitationCodeDto
            {
                Id = code.Id,
                Note = code.Note,
                IsActive = isActive
            });
            successMessage = isActive
                ? Localizer["Code '{0}' was reactivated.", code.Code]
                : Localizer["Code '{0}' was revoked.", code.Code];
            await LoadCodes();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "update code");
        }
    }

    private void ConfirmDelete(InvitationCodeDto code)
    {
        codeToDelete = code;
        showDeleteConfirmation = true;
    }

    private async Task HandleDeleteModalClose(bool confirmed)
    {
        showDeleteConfirmation = false;

        if (!confirmed || codeToDelete == null)
        {
            codeToDelete = null;
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            await InvitationCodeClient.DeleteAsync(codeToDelete.Id);
            successMessage = Localizer["Code '{0}' was deleted.", codeToDelete.Code];
            await LoadCodes();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "delete code");
        }
        finally
        {
            codeToDelete = null;
        }
    }

    private string StatusLabel(InvitationCodeDto code)
    {
        if (code.RedeemedAtUtc != null)
        {
            return Localizer["Redeemed by {0} on {1}", code.RedeemedByEmail, code.RedeemedAtUtc.Value.LocalDateTime.ToString("g")];
        }

        return code.IsActive ? Localizer["Active"] : Localizer["Revoked"];
    }

    private sealed class MintFormModel
    {
        [MaxLength(200)]
        public string? Note { get; set; }

        [EmailAddress]
        [MaxLength(256)]
        public string? BoundEmail { get; set; }
    }
}
