@page "/Admin/Discounts"
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IDiscountApiClient DiscountClient
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>@Localizer["Discounts"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Localizer["Discounts"]</h1>
</div>

@if (loading)
{
    <p class="text-muted">@Localizer["Loading..."]</p>
}
else if (accessDenied)
{
    <div class="alert alert-danger">@Localizer["You don't have permission to view this."]</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@Localizer["Code"]</th>
                            <th>@Localizer["Amount"]</th>
                            <th>@Localizer["Usage"]</th>
                            <th>@Localizer["Restrictions"]</th>
                            <th>@Localizer["Expires"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var discount in discounts)
                        {
                            var expired = discount.ExpiresOn is { } e && e <= DateTimeOffset.UtcNow;
                            <tr class="@(discount.IsActive && !expired ? null : "text-muted")">
                                <td>
                                    <span class="font-monospace">@discount.Code</span>
                                    @if (!discount.IsActive)
                                    {
                                        <span class="badge bg-secondary ms-1">@Localizer["Off"]</span>
                                    }
                                    else if (expired)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">@Localizer["Expired"]</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(discount.Description))
                                    {
                                        <div class="small text-muted">@discount.Description</div>
                                    }
                                </td>
                                <td>
                                    @(discount.AmountType == DiscountAmountType.PercentOff
                                        ? $"{discount.AmountValue:0.##}%"
                                        : discount.AmountValue.ToString("C", Money))
                                </td>
                                <td>
                                    @discount.TimesRedeemed / @(discount.MaxRedemptions?.ToString() ?? Localizer["open"].ToString())
                                    @if (discount.OncePerOrganization)
                                    {
                                        <div class="small text-muted">@Localizer["once per org"]</div>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(discount.RestrictedToOrganizationName ?? Localizer["General consumption"].ToString())
                                </td>
                                <td class="small text-muted">
                                    @(discount.ExpiresOn?.UtcDateTime.ToString("d MMM yyyy", Dates) ?? Localizer["Never"].ToString())
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@working"
                                            @onclick="() => ToggleActiveAsync(discount)">
                                        @(discount.IsActive ? Localizer["Turn off"] : Localizer["Turn on"])
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (discounts.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted">@Localizer["No discounts yet."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small">@Localizer["New discount"]</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Code"]</label>
                            <input class="form-control form-control-sm" @bind="newCode" placeholder="SPRING24" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Type"]</label>
                            <select class="form-select form-select-sm" @bind="newAmountType">
                                <option value="@DiscountAmountType.PercentOff">@Localizer["% off"]</option>
                                <option value="@DiscountAmountType.FlatAmountOff">@Localizer["$ off"]</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Amount"]</label>
                            <input type="number" step="0.01" min="0.01" class="form-control form-control-sm"
                                   value="@newAmountValue.ToString(CultureInfo.InvariantCulture)"
                                   @onchange="e => decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out newAmountValue)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Max redemptions"]</label>
                            <input type="number" min="1" class="form-control form-control-sm" placeholder="@Localizer["Open"]"
                                   @bind="newMaxRedemptions" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Expires"]</label>
                            <input type="date" class="form-control form-control-sm" @bind="newExpiresOn" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Localizer["Restrict to org (id)"]</label>
                            <input class="form-control form-control-sm" @bind="newRestrictedToTenantId" placeholder="@Localizer["Optional"]" />
                        </div>
                        <div class="col-12 form-check">
                            <input type="checkbox" class="form-check-input" id="oncePerOrg" @bind="newOncePerOrganization" />
                            <label class="form-check-label small" for="oncePerOrg">@Localizer["Once per organization"]</label>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-sm btn-primary" disabled="@working" @onclick="CreateAsync">
                                @Localizer["Create"]
                            </button>
                        </div>
                        @if (createError is not null)
                        {
                            <div class="col-12"><div class="alert alert-danger py-1 px-2 small mb-0">@createError</div></div>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small">@Localizer["Redeem for an organization"]</h6>
                    <p class="text-muted small">@Localizer["Paste the Organization id from its own admin URL."]</p>
                    <div class="row g-2">
                        <div class="col-6">
                            <input class="form-control form-control-sm" @bind="redeemTenantId" placeholder="@Localizer["Organization id"]" />
                        </div>
                        <div class="col-6">
                            <input class="form-control form-control-sm" @bind="redeemCode" placeholder="@Localizer["Code"]" />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-sm btn-outline-primary" disabled="@working" @onclick="RedeemForOrgAsync">
                                @Localizer["Redeem"]
                            </button>
                        </div>
                        @if (redeemResult is not null)
                        {
                            <div class="col-12">
                                <div class="alert @(redeemSucceeded ? "alert-success" : "alert-danger") py-1 px-2 small mb-0">
                                    @redeemResult
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DiscountDto> discounts = [];
    private bool loading = true;
    private bool accessDenied;
    private bool working;
    private string? errorMessage;

    private static readonly CultureInfo Money = CultureInfo.GetCultureInfo("en-US");
    private static readonly CultureInfo Dates = CultureInfo.InvariantCulture;

    private string newCode = string.Empty;
    private DiscountAmountType newAmountType = DiscountAmountType.PercentOff;
    private decimal newAmountValue;
    private int? newMaxRedemptions;
    private DateTime? newExpiresOn;
    private string newRestrictedToTenantId = string.Empty;
    private bool newOncePerOrganization;
    private string? createError;

    private string redeemTenantId = string.Empty;
    private string redeemCode = string.Empty;
    private string? redeemResult;
    private bool redeemSucceeded;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            discounts = await DiscountClient.GetAllAsync();
            accessDenied = false;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            accessDenied = true;
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load the discount catalog");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateAsync()
    {
        createError = null;

        if (string.IsNullOrWhiteSpace(newCode) || newAmountValue <= 0m)
        {
            createError = Localizer["A code and a positive amount are required."];
            return;
        }

        Guid? restrictedToTenantId = null;
        if (!string.IsNullOrWhiteSpace(newRestrictedToTenantId))
        {
            if (!Guid.TryParse(newRestrictedToTenantId, out var parsed))
            {
                createError = Localizer["That organization id isn't valid."];
                return;
            }
            restrictedToTenantId = parsed;
        }

        working = true;
        try
        {
            await DiscountClient.CreateAsync(new CreateDiscountRequestDto
            {
                Code = newCode.Trim(),
                AmountType = newAmountType,
                AmountValue = newAmountValue,
                MaxRedemptions = newMaxRedemptions,
                OncePerOrganization = newOncePerOrganization,
                RestrictedToTenantId = restrictedToTenantId,
                ExpiresOn = newExpiresOn is { } d ? new DateTimeOffset(d, TimeSpan.Zero) : null
            });

            newCode = string.Empty;
            newAmountValue = 0m;
            newMaxRedemptions = null;
            newExpiresOn = null;
            newRestrictedToTenantId = string.Empty;
            newOncePerOrganization = false;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            createError = ApiErrorMessage.For(ex, "create the discount");
        }
        finally
        {
            working = false;
        }
    }

    private async Task ToggleActiveAsync(DiscountDto discount)
    {
        working = true;
        try
        {
            await DiscountClient.SetActiveAsync(discount.Id, !discount.IsActive);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "update the discount");
        }
        finally
        {
            working = false;
        }
    }

    private async Task RedeemForOrgAsync()
    {
        redeemResult = null;

        if (!Guid.TryParse(redeemTenantId, out var tenantId) || string.IsNullOrWhiteSpace(redeemCode))
        {
            redeemSucceeded = false;
            redeemResult = Localizer["Enter a valid organization id and a code."];
            return;
        }

        working = true;
        try
        {
            var result = await DiscountClient.RedeemAsync(
                new AdminRedeemDiscountRequestDto { TenantId = tenantId, Code = redeemCode.Trim() });
            redeemSucceeded = result.Success;
            redeemResult = result.Success
                ? Localizer["Redeemed - it'll apply to that organization's next invoice."]
                : result.ErrorMessage;
        }
        catch (Exception ex)
        {
            redeemSucceeded = false;
            redeemResult = ApiErrorMessage.For(ex, "redeem the discount");
        }
        finally
        {
            working = false;
        }
    }
}
