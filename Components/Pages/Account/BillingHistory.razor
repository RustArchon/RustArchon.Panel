@page "/Account/BillingHistory"
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Components.Shared.Reporting
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject ISubscriptionApiClient SubscriptionClient
@inject NavigationManager NavigationManager
@rendermode RenderModes.NonPrerenderedServer

@*
    The one customer-facing report. Everything else built on these components is platform-admin and
    lives under /Reports; this is a member looking at their own Organization, so it sits under /Account
    alongside Subscription and is deliberately absent from the reports index.

    Nothing here scopes the query to a tenant. The API resolves the tenant from the caller's token and
    JumpStart's global filter does the rest, which is the point of proving the components on this one:
    they behave the same inside the tenant boundary as outside it.
*@

@if (Paid == true)
{
    @* Stripe's own success_url redirect - see SubscriptionController.CreateCheckoutSession. Not proof
       the payment settled: that's StripeWebhookHandler's job (RustArchon.Panel), on its own schedule
       (usually seconds, but never guaranteed instant), so this says "we're processing it" rather than
       "paid." The grid below already reloaded once on this same page load - which may have landed
       before the webhook did - so this points at Refresh rather than promising the row below is
       already showing the real status. *@
    <div class="alert alert-success alert-dismissible" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        @Localizer["Thanks - your payment is being processed. If it doesn't show as paid below within a minute, click Refresh."]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
    </div>
}
@if (payNowError is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @payNowError
        <button type="button" class="btn-close" @onclick="() => payNowError = null" aria-label="@Localizer["Close"]"></button>
    </div>
}

<ReportPage Title="@Localizer["Billing History"]"
            Description="@Localizer["Every billing period your organization has been charged for, newest first."]"
            OnRun="RunAsync"
            Loading="loading"
            ErrorMessage="@errorMessage"
            Result="result"
            OnExport="ExportAsync"
            ExportDisabled="@(entries.Count == 0)">
    <Toolbar>
        <a class="btn btn-outline-secondary" href="Account/Subscription">
            <i class="bi bi-credit-card" aria-hidden="true"></i> @Localizer["Subscription"]
        </a>
    </Toolbar>
    <ChildContent>
        <ReportGrid @ref="grid"
                    TRow="BillingHistoryEntryDto"
                    Rows="entries"
                    Columns="columns"
                    FileName="billing-history"
                    EmptyMessage="@Localizer["Nothing has been billed yet."]" />
    </ChildContent>
</ReportPage>

@code {
    /// <summary>
    /// Set by Stripe's own <c>success_url</c> redirect (see <c>SubscriptionController.CreateCheckoutSession</c>)
    /// - shows the "thanks, processing" banner. Not itself proof of payment; see that banner's own remarks.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "paid")]
    public bool? Paid { get; set; }

    private ReportGrid<BillingHistoryEntryDto>? grid;
    private ReportResult<BillingHistoryEntryDto>? result;

    private bool loading = true;
    private string? errorMessage;

    // ---- "Pay now" (Stripe Checkout) ----
    private Guid? payingInvoiceId;
    private string? payNowError;

    private static readonly CultureInfo Money = CultureInfo.GetCultureInfo("en-US");
    private static readonly CultureInfo Dates = CultureInfo.InvariantCulture;

    private IReadOnlyList<ReportColumn<BillingHistoryEntryDto>> columns = [];

    private IReadOnlyList<BillingHistoryEntryDto> entries => result?.Rows ?? [];

    protected override void OnInitialized() => columns = BuildColumns();

    private Task ExportAsync() => grid?.ExportCsvAsync() ?? Task.CompletedTask;

    /// <summary>
    /// The endpoint predates the reporting components and returns a plain list, so the summary is built
    /// here rather than server-side.
    /// </summary>
    /// <remarks>
    /// This is the exception the rule tolerates, not a second way of doing things: the whole history is
    /// always loaded, so there is no paging for a client-side total to disagree with. Any report that
    /// can be truncated has to total on the server - see <see cref="ReportResultBase.Truncated"/>.
    /// </remarks>
    private async Task RunAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var rows = await SubscriptionClient.GetBillingHistoryAsync();

            result = new ReportResult<BillingHistoryEntryDto>
            {
                Rows = rows,
                GeneratedOn = DateTimeOffset.UtcNow,
                RowLimit = int.MaxValue,
                Summary =
                [
                    new ReportSummaryValueDto
                    {
                        Label = Localizer["Periods billed"],
                        Value = rows.Count.ToString("N0", Money),
                        Detail = rows.Count(r => !r.IsWholePeriod) is var partial && partial > 0
                            ? Localizer["{0} prorated", partial]
                            : Localizer["all full periods"]
                    },
                    new ReportSummaryValueDto
                    {
                        Label = Localizer["Total charged"],
                        Value = rows.Sum(r => r.Amount).ToString("C", Money),
                        Detail = Localizer["since sign-up"]
                    },
                    // Real now that invoices exist: what's actually still owed, not every period ever
                    // earned. A period with no invoice - a free plan - contributes nothing.
                    new ReportSummaryValueDto
                    {
                        Label = Localizer["Outstanding"],
                        Value = rows.Sum(r => r.Outstanding).ToString("C", Money),
                        Detail = rows.Count(r => r.Outstanding > 0m) is var unpaid && unpaid > 0
                            ? Localizer["across {0} invoice(s)", unpaid]
                            : Localizer["nothing owed"]
                    }
                ]
            };
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            // No subscription yet - an empty history is the right answer, not an error.
            result = new ReportResult<BillingHistoryEntryDto> { GeneratedOn = DateTimeOffset.UtcNow };
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load your billing history");
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Starts a Stripe-hosted checkout for one open invoice and redirects the browser there. A full
    /// (non-SPA) navigation, deliberately - Checkout is a page on Stripe's own domain, not something
    /// this circuit can render inline.
    /// </summary>
    private async Task PayNowAsync(Guid invoiceId)
    {
        payNowError = null;
        payingInvoiceId = invoiceId;

        try
        {
            var checkoutUrl = await SubscriptionClient.CreateCheckoutSessionAsync(invoiceId);
            NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            payNowError = ApiErrorMessage.For(ex, "start checkout for this invoice");
            payingInvoiceId = null;
        }
    }

    private IReadOnlyList<ReportColumn<BillingHistoryEntryDto>> BuildColumns() =>
    [
        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Period"],
            value: r => r.StartDate,
            template: r =>
                @<span>
                    @r.StartDate.UtcDateTime.ToString("d MMM yyyy", Dates)
                    <span class="text-muted">–</span>
                    @r.EndDate.UtcDateTime.ToString("d MMM yyyy", Dates)
                    @if (!r.IsWholePeriod)
                    {
                        @* Without this, a $1.61 line next to a $4.95 one looks like a billing error
                           rather than the partial period a mid-period plan change creates. *@
                        <span class="badge bg-secondary ms-1"
                              title="@Localizer["A plan change part-way through this period split it in two."]">
                            @Localizer["Prorated"]
                        </span>
                    }
                </span>),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Plan"],
            value: r => r.PlanName),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Term"],
            value: r => r.TermMonths,
            display: r => BillingTerms.Describe(r.TermMonths)),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Slots"],
            value: r => r.Quantity,
            align: ReportAlign.Right),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Amount"],
            value: r => r.Amount,
            display: r => r.Amount.ToString("C", Money),
            align: ReportAlign.Right),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Invoice"],
            value: r => r.InvoiceNumber),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Due"],
            value: r => r.DueOn,
            display: r => r.DueOn is { } on ? on.UtcDateTime.ToString("d MMM yyyy", Dates) : string.Empty),

        // Screen furniture - no raw value, so it stays out of the CSV. Everything it summarises is
        // exported by the columns either side of it.
        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Status"],
            template: r =>
                @<span>
                    @if (r.InvoiceStatus is null)
                    {
                        @* A free period raises no document at all - see IInvoiceService. Saying so beats
                           an empty cell that reads like something went missing. *@
                        <span class="text-muted small">@Localizer["No charge"]</span>
                    }
                    else if (r.InvoiceStatus == RustArchon.Shared.DTOs.InvoiceStatus.Paid)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Paid"]
                        </span>
                    }
                    else if (r.InvoiceStatus == RustArchon.Shared.DTOs.InvoiceStatus.Open)
                    {
                        <span class="badge @(r.DueOn < DateTimeOffset.UtcNow ? "bg-danger" : "bg-warning text-dark")">
                            @(r.DueOn < DateTimeOffset.UtcNow ? Localizer["Overdue"] : Localizer["Due"])
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@r.InvoiceStatus</span>
                    }
                </span>),

        new ReportColumn<BillingHistoryEntryDto>(
            header: Localizer["Outstanding"],
            value: r => r.Outstanding,
            display: r => r.Outstanding == 0m ? string.Empty : r.Outstanding.ToString("C", Money),
            align: ReportAlign.Right),

        // Screen furniture, same reasoning as the Status column - no raw value, out of the CSV.
        new ReportColumn<BillingHistoryEntryDto>(
            header: string.Empty,
            template: r =>
                @<span>
                    @if (r.InvoiceStatus == RustArchon.Shared.DTOs.InvoiceStatus.Open
                        && r.InvoiceId is { } invoiceId && r.Outstanding > 0m)
                    {
                        <button type="button" class="btn btn-sm btn-primary"
                                disabled="@(payingInvoiceId == invoiceId)"
                                @onclick="() => PayNowAsync(invoiceId)">
                            @if (payingInvoiceId == invoiceId)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-credit-card" aria-hidden="true"></i>
                            }
                            @Localizer["Pay now"]
                        </button>
                    }
                </span>)
    ];
}
