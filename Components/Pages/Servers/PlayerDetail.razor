@page "/servers/{ServerId:guid}/players/{SteamId}"
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IRustServerApiClient RustServerClient
@inject SiteBrandingService Branding
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>@(detail?.DisplayName ?? Localizer["Player"]) — @siteName</PageTitle>

@if (loading)
{
    <p><em>@Localizer["Loading player..."]</em></p>
}
else if (detail is null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Localizer["This player has no history on this server."]
    </div>
    <a class="btn btn-outline-secondary" href="@BackHref"><i class="bi bi-arrow-left"></i> @Localizer["Back to Server"]</a>
}
else
{
    <a href="@BackHref" class="link-arrow d-inline-block mb-2"><i class="bi bi-arrow-left"></i> @Localizer["Back to Server"]</a>

    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h1 class="mb-0">@detail.DisplayName</h1>
            <p class="text-muted mb-0">
                <code>@detail.SteamId</code>
                — <a href="@SteamProfileUrl" target="_blank" rel="noopener">@Localizer["Steam profile"]</a>
            </p>
        </div>
        @if (detail.IsCurrentlyConnected)
        {
            <span class="badge status-badge status-connected"><i class="bi bi-check-circle-fill"></i> @Localizer["Currently connected"]</span>
        }
        else
        {
            <span class="badge status-badge status-disconnected"><i class="bi bi-x-circle-fill"></i> @Localizer["Not connected"]</span>
        }
    </div>

    <div class="card card-body mb-4">
        <h2 class="h6 text-muted text-uppercase mb-3">@Localizer["Actions"]</h2>

        @if (actionError is not null)
        {
            <div class="alert alert-danger alert-dismissible py-2 px-3 small mb-3">
                @actionError
                <button type="button" class="btn-close" @onclick="() => actionError = null"></button>
            </div>
        }
        @if (actionSuccessMessage is not null)
        {
            <div class="alert alert-success py-2 px-3 small mb-3">@actionSuccessMessage</div>
        }

        <div class="d-flex flex-wrap gap-4">
            <div>
                <label class="form-label small text-muted mb-1">@Localizer["Give Item"]</label>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" style="width:10rem" placeholder="@Localizer["Item shortname"]" @bind="giveItemShortname" />
                    <input type="number" class="form-control form-control-sm" style="width:5rem" min="1" @bind="giveItemAmount" />
                    <button class="btn btn-sm btn-outline-primary" @onclick="GiveItemAsync" disabled="@(actionBusy || string.IsNullOrWhiteSpace(giveItemShortname))">@Localizer["Give"]</button>
                </div>
            </div>

            <div>
                <label class="form-label small text-muted mb-1">@Localizer["Teleport To"]</label>
                <div class="d-flex gap-2">
                    <input type="number" class="form-control form-control-sm" style="width:5rem" placeholder="X" @bind="teleportX" />
                    <input type="number" class="form-control form-control-sm" style="width:5rem" placeholder="Y" @bind="teleportY" />
                    <input type="number" class="form-control form-control-sm" style="width:5rem" placeholder="Z" @bind="teleportZ" />
                    <button class="btn btn-sm btn-outline-primary" @onclick="TeleportAsync" disabled="@actionBusy">@Localizer["Teleport"]</button>
                </div>
            </div>

            <div>
                <label class="form-label small text-muted mb-1">@Localizer["Kill"]</label>
                <div>
                    <button class="btn btn-sm btn-outline-danger" @onclick="KillAsync" disabled="@actionBusy">@Localizer["Kill Player"]</button>
                </div>
            </div>

            <div>
                <label class="form-label small text-muted mb-1">@Localizer["Kick"]</label>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" style="width:12rem" placeholder="@Localizer["Reason"]" @bind="kickReason" />
                    <button class="btn btn-sm btn-outline-danger" @onclick="KickAsync" disabled="@actionBusy">@Localizer["Kick"]</button>
                </div>
            </div>

            <div>
                <label class="form-label small text-muted mb-1">@Localizer["Ban"]</label>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" style="width:12rem" placeholder="@Localizer["Reason"]" @bind="banReason" />
                    <button class="btn btn-sm btn-outline-danger" @onclick="BanAsync" disabled="@actionBusy">@Localizer["Ban + Kick"]</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["Country"]</div>
                <div class="fs-5">@CountrySummary(detail)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["VPN"]</div>
                <div class="fs-5">@VpnStatus(detail.IsVpn)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["VAC / Game Bans"]</div>
                <div class="fs-5 @(HasAnyBan(detail) ? "text-danger fw-semibold" : "")">
                    @(detail.VacBanned.HasValue ? $"{detail.NumberOfVacBans ?? 0} / {detail.NumberOfGameBans ?? 0}" : "—")
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["Hours on Record"]</div>
                <div class="fs-5">@FormatHoursOnRecord(detail.SteamMinutesPlayedForever)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["Hours on Server"]</div>
                <div class="fs-5">@FormatDurationLong(detail.HoursOnServer)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["Sessions"]</div>
                <div class="fs-5">@detail.SessionCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["First Seen"]</div>
                <div class="fs-5">@detail.FirstConnectedAtUtc.ToLocalTime().ToString("g")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-body h-100">
                <div class="text-muted small text-uppercase">@Localizer["Last Seen"]</div>
                <div class="fs-5">@detail.LastConnectedAtUtc.ToLocalTime().ToString("g")</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h6 text-muted text-uppercase">@Localizer["Session history"]</h2>
            @if (loadingSessions && sessions.Count == 0)
            {
                <p><em>@Localizer["Loading..."]</em></p>
            }
            else if (sessions.Count == 0)
            {
                <p class="text-muted">@Localizer["No sessions recorded."]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm player-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Connected"]</th>
                                <th>@Localizer["Duration"]</th>
                                <th>@Localizer["IP address"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in sessions)
                            {
                                <tr>
                                    <td>@s.ConnectedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td>@FormatDurationLong((s.DisconnectedAtUtc ?? DateTimeOffset.UtcNow) - s.ConnectedAtUtc)@(s.DisconnectedAtUtc is null ? " " + Localizer["(ongoing)"] : "")</td>
                                    <td><code>@s.IpAddress</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (sessions.Count < sessionsTotalCount)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadSessionsAsync(append: true)" disabled="@loadingSessions">
                        @(loadingSessions ? Localizer["Loading..."] : Localizer["Load more ({0} of {1})", sessions.Count, sessionsTotalCount])
                    </button>
                }
            }
        </div>

        <div class="col-lg-6">
            <h2 class="h6 text-muted text-uppercase">@Localizer["Kills"]</h2>
            @if (loadingKills && kills.Count == 0)
            {
                <p><em>@Localizer["Loading..."]</em></p>
            }
            else if (kills.Count == 0)
            {
                <p class="text-muted">@Localizer["No kills recorded."]</p>
            }
            else
            {
                <div class="console-log">
                    @foreach (var k in kills)
                    {
                        <div class="console-line">
                            <span class="console-line-time">@k.OccurredAtUtc.ToLocalTime().ToString("g")</span>
                            <span class="console-line-message">@KillSummary(k)</span>
                        </div>
                    }
                </div>

                @if (kills.Count < killsTotalCount)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => LoadKillsAsync(append: true)" disabled="@loadingKills">
                        @(loadingKills ? Localizer["Loading..."] : Localizer["Load more ({0} of {1})", kills.Count, killsTotalCount])
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ServerId { get; set; }

    [Parameter]
    public string SteamId { get; set; } = string.Empty;

    private string BackHref => $"servers/{ServerId}?tab=players";
    private string SteamProfileUrl => $"https://steamcommunity.com/profiles/{SteamId}";

    private PlayerDetailDto? detail;
    private string siteName = "RustArchon";
    private bool loading = true;

    private readonly List<PlayerSessionDto> sessions = new();
    private bool loadingSessions = true;
    private int sessionsPageNumber;
    private int sessionsTotalCount;

    private readonly List<PlayerKillEventDto> kills = new();
    private bool loadingKills = true;
    private int killsPageNumber;
    private int killsTotalCount;

    private const int PageSize = 50;

    // ---- Actions ----
    private bool actionBusy;
    private string? actionError;
    private string? actionSuccessMessage;

    private string giveItemShortname = string.Empty;
    private int giveItemAmount = 1;

    private double teleportX;
    private double teleportY;
    private double teleportZ;

    private string kickReason = string.Empty;
    private string banReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        siteName = (await Branding.GetAsync()).SiteName;

        try
        {
            detail = await RustServerClient.GetPlayerDetailAsync(ServerId, SteamId);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            detail = null;
        }
        catch (Exception)
        {
            detail = null;
        }

        loading = false;

        if (detail is not null)
        {
            await LoadSessionsAsync();
            await LoadKillsAsync();
        }
    }

    private async Task LoadSessionsAsync(bool append = false)
    {
        loadingSessions = true;
        StateHasChanged();

        try
        {
            var pageNumber = append ? sessionsPageNumber + 1 : 1;
            var result = await RustServerClient.GetPlayerSessionsAsync(ServerId, SteamId, pageNumber, PageSize);

            if (!append)
            {
                sessions.Clear();
            }

            sessions.AddRange(result.Items);
            sessionsPageNumber = result.PageNumber;
            sessionsTotalCount = result.TotalCount;
        }
        catch (Exception)
        {
            // Leave whatever was already on screen in place, same reasoning as ServerDetail's loads.
        }
        finally
        {
            loadingSessions = false;
        }

        StateHasChanged();
    }

    private async Task LoadKillsAsync(bool append = false)
    {
        loadingKills = true;
        StateHasChanged();

        try
        {
            var pageNumber = append ? killsPageNumber + 1 : 1;
            var result = await RustServerClient.GetPlayerKillsAsync(ServerId, SteamId, pageNumber, PageSize);

            if (!append)
            {
                kills.Clear();
            }

            kills.AddRange(result.Items);
            killsPageNumber = result.PageNumber;
            killsTotalCount = result.TotalCount;
        }
        catch (Exception)
        {
        }
        finally
        {
            loadingKills = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Runs a per-player moderation command through the same generic command pathway
    /// ServerDetail.razor's Console/Control tabs use, with the same NotConnected/GatewayTimeout
    /// handling. Command syntax for every action below (including the two-step ban) was confirmed by
    /// watching a real third-party RCON client's actual traffic through RustArchon.RconEmulator, not
    /// guessed from documentation - see that repo's commands.log/README.
    /// </summary>
    private async Task<bool> RunPlayerCommandAsync(string command)
    {
        actionBusy = true;
        actionError = null;
        actionSuccessMessage = null;
        StateHasChanged();

        try
        {
            var result = await RustServerClient.SendCommandAsync(ServerId, new SendCommandRequest { Command = command });
            if (!result.Success)
            {
                actionError = result.Error switch
                {
                    "NotConnected" => Localizer["This server isn't connected right now - the command wasn't sent."],
                    _ => result.Error ?? Localizer["The command failed."]
                };
                return false;
            }

            actionSuccessMessage = Localizer["Sent: {0}", command];
            return true;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            actionError = Localizer["No worker responded in time - this server may not have an active connection."];
            return false;
        }
        catch (Exception)
        {
            actionError = Localizer["Something went wrong sending that command."];
            return false;
        }
        finally
        {
            actionBusy = false;
            StateHasChanged();
        }
    }

    private Task GiveItemAsync() =>
        RunPlayerCommandAsync($"inventory.giveto \"{SteamId}\" \"{giveItemShortname}\" \"{giveItemAmount}\"");

    private Task TeleportAsync() =>
        RunPlayerCommandAsync(
            $"teleport.topos \"{SteamId}\" \"{teleportX.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" " +
            $"\"{teleportY.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" \"{teleportZ.ToString(System.Globalization.CultureInfo.InvariantCulture)}\"");

    private Task KillAsync() => RunPlayerCommandAsync($"killplayer {SteamId}");

    private Task KickAsync() => RunPlayerCommandAsync($"kick \"{SteamId}\" \"{kickReason}\"");

    /// <summary>
    /// Bans, then kicks with the same reason - a ban alone doesn't disconnect an already-connected
    /// player, and the real client observed via RustArchon.RconEmulator always followed its own ban
    /// with a kick for exactly that reason.
    /// </summary>
    private async Task BanAsync()
    {
        if (await RunPlayerCommandAsync($"ban \"{SteamId}\" \"{banReason}\""))
        {
            await RunPlayerCommandAsync($"kick \"{SteamId}\" \"{banReason}\"");
        }
    }

    private static bool HasAnyBan(PlayerDetailDto p) => (p.NumberOfVacBans ?? 0) > 0 || (p.NumberOfGameBans ?? 0) > 0;

    private static string CountrySummary(PlayerDetailDto p)
    {
        if (string.IsNullOrEmpty(p.Country))
        {
            return "—";
        }

        return !string.IsNullOrEmpty(p.CountryCode) ? $"{p.Country} ({p.CountryCode})" : p.Country;
    }

    private string VpnStatus(bool? isVpn) => isVpn switch
    {
        true => Localizer["Yes"],
        false => Localizer["No"],
        null => "—"
    };

    private static string FormatHoursOnRecord(int? minutesPlayedForever) =>
        minutesPlayedForever.HasValue ? FormatDurationLong(TimeSpan.FromMinutes(minutesPlayedForever.Value)) : "—";

    private static string FormatDurationLong(TimeSpan duration) =>
        $"{duration.Days:00}d, {duration.Hours:00}:{duration.Minutes:00}:{duration.Seconds:00}";

    // Mirrors ServerDetail.razor's own KillSummary - kept as a plain victim/killer summary rather than
    // "you" framing, since a reader lands here specifically because they already recognize this name.
    private string KillSummary(PlayerKillEventDto kill)
    {
        var weaponSuffix = string.IsNullOrEmpty(kill.Weapon) ? string.Empty : $" ({kill.Weapon})";

        if (string.IsNullOrEmpty(kill.KillerName))
        {
            return Localizer["{0} died{1}", kill.VictimName, weaponSuffix];
        }

        return Localizer["{0} was killed by {1}{2}", kill.VictimName, kill.KillerName, weaponSuffix];
    }
}
