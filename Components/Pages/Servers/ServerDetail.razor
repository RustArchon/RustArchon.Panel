                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="bases-refresh" disabled="@loadingBases" @onclick="LoadBasesAsync">
                            <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                        </button>
                        @if (bases?.CapturedAtUtc is not null)
                        {
                            <span class="small text-muted" data-testid="bases-captured">
                                @Localizer["As of"] @bases.CapturedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            </span>
                        }
                    </div>

                    @if (basesError is not null)
                    {
                        <div class="alert alert-danger py-2 small" data-testid="bases-error">@basesError</div>
                    }

                    @if (bases is not null && bases.CapturedAtUtc is not null && !bases.Ready)
                    {
                        <div class="alert alert-info py-2 small" data-testid="bases-not-ready">
                            @Localizer["The plugin is still scanning the world for bases, so this list may be incomplete."]
                        </div>
                    }

                    @if (loadingBases && bases is null)
                    {
                        <p><em>@Localizer["Loading..."]</em></p>
                    }
                    else if (bases is null || bases.Tcs.Count == 0)
                    {
                        <p class="text-muted" data-testid="bases-empty">@Localizer["No bases found yet."]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" data-testid="bases-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Owner"]</th>
                                        <th>@Localizer["Location"]</th>
                                        <th>@Localizer["Authorized"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tc in bases.Tcs.OrderBy(x => x.OwnerId).ThenBy(x => x.Id))
                                    {
                                        <tr data-testid="base-row">
                                            <td>
                                                <span>@BaseOwnerName(tc)</span>
                                                <br />
                                                <span class="text-muted small">@tc.OwnerId</span>
                                            </td>
                                            <td class="text-nowrap small">
                                                x @tc.X.ToString("0", System.Globalization.CultureInfo.InvariantCulture),
                                                z @tc.Z.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
                                                <span class="text-muted">(@Localizer["height"] @tc.Y.ToString("0", System.Globalization.CultureInfo.InvariantCulture))</span>
                                            </td>
                                            <td class="small" data-testid="base-authorized">
                                                @if (tc.Authorized.Count == 0)
                                                {
                                                    <span class="text-muted">@Localizer["Nobody"]</span>
                                                }
                                                else
                                                {
                                                    @string.Join(", ", tc.Authorized.Select(a => string.IsNullOrEmpty(a.Name) ? a.PlayerId : a.Name))
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Plugins)
        {
            <div class="plugins-pane">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-muted text-uppercase mb-0">
                        @Localizer["Plugins"]
                        @if (pluginFramework is not null)
                        {
                            <span class="badge text-bg-secondary ms-1">@pluginFramework</span>
                        }
                    </h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPluginsAsync" disabled="@loadingPlugins">
                        <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                    </button>
                </div>

                @* The optional RustArchon companion plugin. Fail closed: nothing here is offered unless the plugin
                   is positively in the plugin list AND has answered its handshake, and each feature only claims to
                   work when the plugin reported that capability. *@
                <div class="card mb-3 rustarchon-plugin-card">
                    <div class="card-body">
                        <h3 class="h6 mb-2"><i class="bi bi-plug"></i> @Localizer["RustArchon plugin"]</h3>
                        @if (!PluginListed)
                        {
                            <p class="small text-muted mb-2" data-testid="plugin-not-detected">
                                @Localizer["Not detected on this server. Plugin features (recording, combat log) need it and stay off until it is installed."]
                            </p>
                            @DownloadPluginButton
                        }
                        else if (pluginStatus is null)
                        {
                            <p class="small text-muted mb-0" data-testid="plugin-no-handshake">
                                @Localizer["Detected, but it has not answered yet. This can take a few minutes after it loads. Plugin features stay off until it does."]
                            </p>
                        }
                        else
                        {
                            <p class="small mb-2" data-testid="plugin-version">
                                @Localizer["Version"] @pluginStatus.PluginVersion
                                <span class="text-muted">· @Localizer["Protocol"] @pluginStatus.ProtocolVersion</span>
                            </p>

                            @* Whether the installed file is one THIS Panel signed. The plugin checks itself; the Panel
                               only compares the key it reports with its own. *@
                            @if (pluginStatus.SigningState == PluginSigningStates.Valid && pluginStatus.SigningKeyMatchesThisPanel == true)
                            {
                                <p class="small text-success mb-2" data-testid="plugin-signing-ok">
                                    <i class="bi bi-patch-check"></i> @Localizer["Signed by this Panel"]
                                    <span class="text-muted">· @Localizer["Key"] <code>@pluginStatus.SigningKeyFingerprint</code></span>
                                </p>
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Valid && pluginStatus.SigningKeyState == "retired")
                            {
                                @* An earlier key of THIS Panel: still updatable, and the update moves it to the current key. *@
                                <p class="small text-muted mb-2" data-testid="plugin-signing-retired">
                                    <i class="bi bi-patch-check"></i> @Localizer["Signed by an earlier key of this Panel. An update will move it to the current key."]
                                    <span class="text-muted">· @Localizer["Key"] <code>@pluginStatus.SigningKeyFingerprint</code></span>
                                </p>
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Valid && pluginStatus.SigningKeyState == "revoked")
                            {
                                <p class="small text-danger mb-2" data-testid="plugin-signing-revoked">
                                    @Localizer["Signed with a key that has been revoked. Updates from this Panel are refused. Download the plugin from this Panel and install it by hand."]
                                    <span class="text-muted">· @Localizer["Key"] <code>@pluginStatus.SigningKeyFingerprint</code></span>
                                </p>
                                @DownloadPluginButton
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Valid && pluginStatus.SigningKeyMatchesThisPanel == false)
                            {
                                <p class="small text-warning mb-2" data-testid="plugin-signing-other-panel">
                                    @Localizer["Signed by a different Panel. Updates from this Panel will be refused. Download the plugin from this Panel to change that."]
                                    <span class="text-muted">· @Localizer["Key"] <code>@pluginStatus.SigningKeyFingerprint</code></span>
                                </p>
                                @DownloadPluginButton
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Valid)
                            {
                                <p class="small text-muted mb-2" data-testid="plugin-signing-valid-unmatched">
                                    @Localizer["Signed"]
                                    <span class="text-muted">· @Localizer["Key"] <code>@pluginStatus.SigningKeyFingerprint</code></span>
                                </p>
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Invalid)
                            {
                                <p class="small text-danger mb-2" data-testid="plugin-signing-invalid">
                                    @Localizer["The plugin file does not match its signature. It was altered, or copied in a way that changed it (for example an FTP client in text mode). Download it again and upload it in binary mode."]
                                </p>
                                @DownloadPluginButton
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Unsigned)
                            {
                                <p class="small text-muted mb-2" data-testid="plugin-signing-unsigned">
                                    @Localizer["Unsigned copy (for example a developer build). Download the plugin from this Panel to enable signed updates."]
                                </p>
                                @DownloadPluginButton
                            }
                            else if (pluginStatus.SigningState == PluginSigningStates.Unknown)
                            {
                                @* A build from before signing existed: it cannot say. Replacing it is the fix. *@
                                <p class="small text-muted mb-2" data-testid="plugin-signing-predates">
                                    @Localizer["This plugin build does not report its signature. Download the current plugin from this Panel to get signed updates."]
                                </p>
                                @DownloadPluginButton
                            }
                            else
                            {
                                @* unlocated / error: the plugin could not check, and a fresh download would not change that. *@
                                <p class="small text-muted mb-2" data-testid="plugin-signing-unchecked">
                                    @Localizer["Signature not checked."]
                                </p>
                            }
                            @if (pluginDownloadError is not null)
                            {
                                <p class="small text-danger mb-2" data-testid="plugin-download-error">@pluginDownloadError</p>
                            }

                            @* Updates. Only ever offered for a plugin this Panel signed - the Api re-checks everything, this
                               just does not dangle a button that would be refused. *@
                            @if (PluginSignedByThisPanel && server is not null)
                            {
                                <div class="border-top pt-2 mt-2 mb-2" data-testid="plugin-updates">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="plugin-updates"
                                               checked="@server.PluginUpdatesEnabled"
                                               disabled="@savingPluginSettings"
                                               @onchange="e => SavePluginSettingsAsync(server.PluginRecordingEnabled, server.PluginCombatLogEnabled, (bool)e.Value!)" />
                                        <label class="form-check-label" for="plugin-updates">@Localizer["Allow updates from this Panel"]</label>
                                        <div class="form-text">@Localizer["Lets an administrator update the plugin from here. Off by default."]</div>
                                    </div>

                                    @if (server.PluginUpdatesEnabled)
                                    {
                                        <div class="form-check form-switch ms-4 mt-2" data-testid="plugin-auto-update-setting">
                                            <input class="form-check-input" type="checkbox" role="switch" id="plugin-auto-update"
                                                   checked="@server.PluginAutoUpdateEnabled"
                                                   disabled="@savingPluginSettings"
                                                   @onchange="e => SavePluginSettingsAsync(server.PluginRecordingEnabled, server.PluginCombatLogEnabled, server.PluginUpdatesEnabled, (bool)e.Value!)" />
                                            <label class="form-check-label" for="plugin-auto-update">@Localizer["Update automatically"]</label>
                                            <div class="form-text">@Localizer["Installs the newest plugin and Updater this Panel serves by itself, one at a time, and puts the old one back if the new one does not start. Off by default."]</div>
                                        </div>
                                    }

                                    @if (!pluginStatus.UpdaterInstalled)
                                    {
                                        @if (UpdaterSelfUpdateOffered)
                                        {
                                            <p class="small text-muted mt-2 mb-1" data-testid="plugin-updater-missing">
                                                @Localizer["Updating needs a small second plugin, the RustArchon Updater. It is not installed on this server, but the RustArchon plugin can install it for you."]
                                            </p>
                                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" data-testid="plugin-install-updater"
                                                    @onclick="StartUpdaterUpdateAsync" disabled="@updatingUpdater">
                                                @if (updatingUpdater)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                }
                                                @Localizer["Install Updater"]
                                            </button>
                                        }
                                        else
                                        {
                                            <p class="small text-muted mt-2 mb-1" data-testid="plugin-updater-missing">
                                                @Localizer["Updating needs a small second plugin, the RustArchon Updater. Install it once by hand, or update the plugin first: a newer plugin can install and update the Updater itself."]
                                            </p>
                                            @if (UpdaterSelfUpdateBlockedByUpdatesOff)
                                            {
                                                <p class="small text-muted mb-1" data-testid="plugin-updater-enable-hint">@Localizer["Turn on Allow updates from this Panel and the plugin can do this for you."]</p>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" data-testid="plugin-download-updater"
                                                    @onclick="DownloadPluginUpdaterAsync" disabled="@downloadingPlugin">
                                                <i class="bi bi-download"></i> @Localizer["Download Updater"]
                                            </button>
                                        }
                                    }

                                    @if (pluginStatus.UpdaterInstalled && pluginStatus.UpdaterUpdateAvailable)
                                    {
                                        @if (UpdaterSelfUpdateOffered)
                                        {
                                            <p class="small text-muted mt-2 mb-1" data-testid="plugin-updater-outdated">
                                                @Localizer["A newer Updater is available"]: @pluginStatus.UpdaterVersion → @pluginStatus.LatestUpdaterVersion.
                                                @Localizer["The RustArchon plugin will replace it, and put the old one back if the new one does not start."]
                                            </p>
                                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" data-testid="plugin-update-updater"
                                                    @onclick="StartUpdaterUpdateAsync" disabled="@updatingUpdater">
                                                @if (updatingUpdater)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                }
                                                @Localizer["Update Updater"]
                                            </button>
                                        }
                                        else
                                        {
                                            <p class="small text-muted mt-2 mb-1" data-testid="plugin-updater-outdated">
                                                @Localizer["A newer Updater is available"]: @pluginStatus.UpdaterVersion → @pluginStatus.LatestUpdaterVersion.
                                                @Localizer["Install it by hand, or update the plugin first: a newer plugin can update the Updater itself. Servers whose signing key has changed need the newer Updater before they can be updated from here."]
                                            </p>
                                            @if (UpdaterSelfUpdateBlockedByUpdatesOff)
                                            {
                                                <p class="small text-muted mb-1" data-testid="plugin-updater-enable-hint">@Localizer["Turn on Allow updates from this Panel and the plugin can do this for you."]</p>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-primary mb-2" data-testid="plugin-download-updater"
                                                    @onclick="DownloadPluginUpdaterAsync" disabled="@downloadingPlugin">
                                                <i class="bi bi-download"></i> @Localizer["Download Updater"]
                                            </button>
                                        }
                                    }

                                    @if (pluginStatus.UpdateAvailable)
                                    {
                                        <p class="small mt-2 mb-1" data-testid="plugin-update-available">
                                            <i class="bi bi-arrow-up-circle"></i>
                                            @Localizer["Update available"]: @pluginStatus.PluginVersion → @pluginStatus.LatestPluginVersion
                                        </p>
                                        @if (server.PluginUpdatesEnabled && pluginStatus.UpdaterInstalled)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary mb-1" data-testid="plugin-update"
                                                    @onclick="StartPluginUpdateAsync" disabled="@updatingPlugin">
                                                @if (updatingPlugin)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                }
                                                @Localizer["Update plugin"]
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <p class="small text-muted mt-2 mb-1" data-testid="plugin-up-to-date">@Localizer["Up to date."]</p>
                                    }

                                    @if (pluginUpdateMessage is not null)
                                    {
                                        <p class="small @(pluginUpdateStarted ? "text-success" : "text-danger") mt-1 mb-0" data-testid="plugin-update-result">@pluginUpdateMessage</p>
                                    }

                                    @if (pluginAttempts.Count > 0)
                                    {
                                        <div class="small mt-2" data-testid="plugin-update-attempts">
                                            <div class="text-muted">@Localizer["Recent updates"]</div>
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var attempt in pluginAttempts.Take(5))
                                                {
                                                    <li data-testid="plugin-update-attempt" data-state="@attempt.State">@AttemptText(attempt)</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }

                            @if (!PluginCanBeConfigured)
                            {
                                <p class="small text-muted mb-0" data-testid="plugin-not-configurable">
                                    @Localizer["This plugin version cannot be configured from the panel."]
                                </p>
                            }
                            else if (server is not null)
                            {
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="plugin-recording"
                                           checked="@server.PluginRecordingEnabled"
                                           disabled="@savingPluginSettings"
                                           @onchange="e => SavePluginSettingsAsync((bool)e.Value!, server.PluginCombatLogEnabled)" />
                                    <label class="form-check-label" for="plugin-recording">@Localizer["Recording"]</label>
                                    <div class="form-text">@Localizer["Records player positions and events."]</div>
                                    @if (!PluginReports(RustArchonPlugin.RecordingCapability))
                                    {
                                        <div class="form-text" data-testid="plugin-recording-unavailable">@Localizer["Not available in this plugin version yet."]</div>
                                    }
                                    @if (pluginStatus.RecordingEnabled != server.PluginRecordingEnabled)
                                    {
                                        <div class="form-text" data-testid="plugin-recording-pending">@Localizer["Applying..."]</div>
                                    }
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="plugin-combat"
                                           checked="@server.PluginCombatLogEnabled"
                                           disabled="@savingPluginSettings"
                                           @onchange="e => SavePluginSettingsAsync(server.PluginRecordingEnabled, (bool)e.Value!)" />
                                    <label class="form-check-label" for="plugin-combat">@Localizer["Combat log"]</label>
                                    <div class="form-text">@Localizer["Tracks damage for the combat log."]</div>
                                    @if (!PluginReports(RustArchonPlugin.CombatCapability))
                                    {
                                        <div class="form-text" data-testid="plugin-combat-unavailable">@Localizer["Not available in this plugin version yet."]</div>
                                    }
                                    @if (pluginStatus.CombatLogEnabled != server.PluginCombatLogEnabled)
                                    {
                                        <div class="form-text" data-testid="plugin-combat-pending">@Localizer["Applying..."]</div>
                                    }
                                </div>
                                @if (!pluginStatus.SettingsPersisted)
                                {
                                    <p class="small text-warning mt-2 mb-0" data-testid="plugin-not-persisted">
                                        @Localizer["The plugin could not save its settings, so they revert if it reloads. The panel re-applies them."]
                                    </p>
                                }
                                @if (pluginSettingsError is not null)
                                {
                                    <p class="small text-danger mt-2 mb-0" data-testid="plugin-settings-error">@pluginSettingsError</p>
                                }
                            }
                        }
                    </div>
                </div>

                @if (pluginsError is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-0">@pluginsError</div>
                }
                else if (loadingPlugins && plugins.Count == 0)
                {
                    <p><em>@Localizer["Loading plugins..."]</em></p>
                }
                else if (plugins.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-puzzle"></i>
                        <p>@Localizer["No Oxide or Carbon plugins have been reported for this server."]</p>
                    </div>
                }
                else
                {
                    if (pluginUpdates.Count > 0)
                    {
                        <p class="small mb-2" data-testid="plugin-updates-summary">
                            <span class="badge text-bg-warning">@pluginUpdates.Count</span>
                            @Localizer["plugins have updates available, according to the UpdateChecker plugin on this server."]
                        </p>
                    }
                    <div class="table-responsive">
                        <table class="table table-sm player-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Name"]</th>
                                    <th>@Localizer["Author"]</th>
                                    <th>@Localizer["Version"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in plugins)
                                {
                                    var update = UpdateFor(p);
                                    <tr data-testid="plugin-row">
                                        <td>@p.Name</td>
                                        <td>@p.Author</td>
                                        <td>
                                            @p.Version
                                            @if (update is not null)
                                            {
                                                <div class="small mt-1" data-testid="plugin-update">
                                                    <span class="badge text-bg-warning" data-testid="plugin-update-badge"
                                                          title="@UpdateDetail(update)">@Localizer["Update available: {0}", update.LatestVersion]</span>
                                                    @if (IsWebAddress(update.Url))
                                                    {
                                                        <a href="@update.Url" target="_blank" rel="noopener noreferrer nofollow" class="ms-1" data-testid="plugin-update-link">
                                                            @(string.IsNullOrEmpty(update.Marketplace) ? Localizer["View update page"] : Localizer["View on {0}", update.Marketplace])
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                        </a>
                                                    }
                                                    else if (!string.IsNullOrEmpty(update.Marketplace))
                                                    {
                                                        <span class="text-muted ms-1" data-testid="plugin-update-marketplace">@update.Marketplace</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    // Query string, not a URL fragment - a fragment never reaches the server at all (it's stripped
    // before the HTTP request is even made), so a hard refresh on e.g. "#players" can't restore
    // anything without extra client-side JS to read window.location.hash. A query string round-trips
    // through Blazor's own routing normally and SupplyParameterFromQuery reads it directly.
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private RustServerDto? server;
    private string siteName = "RustArchon";
    private bool loading = true;
    private Tab activeTab = Tab.Console;
    private RconConnectionStatus status;
    private readonly List<RconEventDto> consoleEvents = new();
    private readonly List<RconEventDto> chatEvents = new();
    private string commandText = string.Empty;
    private bool sendingCommand;
    private string? commandError;
    private string chatText = string.Empty;
    private bool sendingChat;
    private string? chatError;

    // ---- Players tab ----
    private readonly List<PlayerSessionDto> currentPlayers = new();
    private readonly List<PlayerKillEventDto> recentKills = new();
    private bool loadingPlayers = true;
    private bool loadingKills = true;
    private const int MaxRecentKills = 50;

    private readonly List<InactivePlayerDto> inactivePlayers = new();
    private bool loadingInactivePlayers = true;
    private int inactivePlayersPageNumber;
    private int inactivePlayersTotalCount;
    private const int InactivePlayersPageSize = 50;

    private readonly List<BanListEntry> banList = new();
    private bool loadingBanList = true;
    private string? banListError;

    private record BanListEntry(string SteamId, string Name, string Reason, bool IsPermanent, string Expiry);

    // ---- Bases tab ----
    private BasesDto? bases;
    private bool loadingBases;
    private bool basesForbidden;
    private string? basesError;

    /// <summary>The owner's name as the Api resolved it (the plugin's, else the last session's), falling back to a name listed on their own cupboard, else just their id.</summary>
    private static string BaseOwnerName(BaseTcDto tc)
    {
        if (!string.IsNullOrEmpty(tc.OwnerName))
        {
            return tc.OwnerName;
        }

        var owner = tc.Authorized.FirstOrDefault(a => a.PlayerId == tc.OwnerId);
        return owner is null || string.IsNullOrEmpty(owner.Name) ? tc.OwnerId : owner.Name;
    }

    /// <summary>
    /// Loads the server's bases. Sensitive: the Api answers 403 to anyone without the bases permission, and that is shown
    /// as "you are not allowed" rather than as a failure. Nothing is asked unless the plugin is here and reports the
    /// capability (fail closed, like every plugin feature).
    /// </summary>
    private async Task LoadBasesAsync()
    {
        if (!PluginListed || !PluginReports(RustArchonPlugin.TcsCapability))
        {
            return;
        }

        loadingBases = true;
        basesError = null;
        basesForbidden = false;
        StateHasChanged();

        try
        {
            bases = await RustServerClient.GetBasesAsync(Id);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            basesForbidden = true;
            bases = null;
        }
        catch (Exception)
        {
            basesError = Localizer["Failed to load the bases."];
        }
        finally
        {
            loadingBases = false;
        }

        StateHasChanged();
    }

    // ---- Positions tab ----
    private static readonly TimeSpan PositionsLiveWindow = TimeSpan.FromMinutes(10);
    private static readonly TimeSpan PositionsTrackWindow = TimeSpan.FromHours(1);
    private const int PositionsQueryLimit = 2000;

    private PositionsDto? positions;
    private DateTimeOffset? positionsLoadedAt;
    private bool loadingPositions;
    private bool positionsForbidden;
    private string? positionsError;

    private string? selectedPlayerId;
    private PositionsDto? selectedTrack;
    private bool loadingTrack;
    private string? trackError;

    private sealed record PositionRow(string PlayerId, string Name, PositionSampleDto Latest, bool Online);

    /// <summary>
    /// One row per player seen in the recent window: their newest sample, their name (the plugin includes it only on some
    /// samples, so the newest one that has it), and whether that newest sample is the "left" marker.
    /// </summary>
    private IReadOnlyList<PositionRow> PositionRows() =>
        positions is null
            ? []
            : positions.Samples
                .GroupBy(s => s.PlayerId)
                .Select(g =>
                {
                    var newest = g.OrderByDescending(s => s.OccurredAtUtc).ThenByDescending(s => s.Sequence).First();
                    var name = g.OrderByDescending(s => s.OccurredAtUtc).Select(s => s.PlayerName).FirstOrDefault(n => !string.IsNullOrEmpty(n));
                    return new PositionRow(g.Key, string.IsNullOrEmpty(name) ? g.Key : name, newest, newest.Marker != "off");
                })
                .OrderByDescending(r => r.Online)
                .ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

    private string PlayerNameFor(string playerId) => PositionRows().FirstOrDefault(r => r.PlayerId == playerId)?.Name ?? playerId;

    private static readonly string[] CompassPoints = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"];

    /// <summary>The compass point for a yaw in degrees (0 is north, 90 east).</summary>
    private static string Compass(int yaw) => CompassPoints[(int)Math.Round((((yaw % 360) + 360) % 360) / 45.0) % 8];

    /// <summary>How far the player travelled along the track, flat distance (height is ignored), oldest sample to newest.</summary>
    private static double TrackDistance(PositionsDto track)
    {
        double total = 0;
        var ordered = track.Samples.OrderBy(s => s.OccurredAtUtc).ThenBy(s => s.Sequence).ToList();
        for (var i = 1; i < ordered.Count; i++)
        {
            var dx = ordered[i].X - ordered[i - 1].X;
            var dz = ordered[i].Z - ordered[i - 1].Z;
            total += Math.Sqrt(dx * dx + dz * dz);
        }

        return total;
    }

    /// <summary>
    /// Loads who was seen in the last few minutes. Sensitive: the Api answers 403 to anyone without the positions permission,
    /// shown as "you are not allowed" rather than as a failure. Nothing is asked unless the plugin is here and reports the
    /// capability (fail closed, like every plugin feature).
    /// </summary>
    private async Task LoadPositionsAsync()
    {
        if (!PluginListed || !PluginReports(RustArchonPlugin.PositionsCapability))
        {
            return;
        }

        loadingPositions = true;
        positionsError = null;
        positionsForbidden = false;
        StateHasChanged();

        try
        {
            var now = DateTimeOffset.UtcNow;
            positions = await RustServerClient.GetPositionsAsync(Id, since: now - PositionsLiveWindow, limit: PositionsQueryLimit);
            positionsLoadedAt = now;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            positionsForbidden = true;
            positions = null;
        }
        catch (Exception)
        {
            positionsError = Localizer["Failed to load positions."];
        }
        finally
        {
            loadingPositions = false;
        }

        StateHasChanged();

        if (selectedPlayerId is not null && !positionsForbidden)
        {
            await SelectPlayerAsync(selectedPlayerId);
        }
    }

    private async Task SelectPlayerAsync(string playerId)
    {
        selectedPlayerId = playerId;
        loadingTrack = true;
        trackError = null;
        StateHasChanged();

        try
        {
            selectedTrack = await RustServerClient.GetPositionsAsync(
                Id, since: DateTimeOffset.UtcNow - PositionsTrackWindow, playerId: playerId, limit: PositionsQueryLimit);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            positionsForbidden = true;
            selectedTrack = null;
        }
        catch (Exception)
        {
            trackError = Localizer["Failed to load positions."];
            selectedTrack = null;
        }
        finally
        {
            loadingTrack = false;
        }

        StateHasChanged();
    }

    private void CloseTrack()
    {
        selectedPlayerId = null;
        selectedTrack = null;
        trackError = null;
    }

    // ---- Combat tab ----
    private readonly List<CombatEventDto> combatEvents = new();
    private bool combatHasMore;
    private bool loadingCombat;
    private string? combatError;
    private string combatWindow = "24h";
    private string? combatPlayerId;
    private int combatLimit = 100;

    /// <summary>What a party in a fight looks like: a player's name with their SteamID underneath, or just the entity's name.</summary>
    private RenderFragment CombatParty(string name, string id, bool isPlayer) => @<span>
        @if (isPlayer)
        {
            <span>@(string.IsNullOrEmpty(name) ? id : name)</span>
            <br />
            <span class="text-muted small">@id</span>
        }
        else
        {
            <span class="text-muted">@(string.IsNullOrEmpty(id) ? "-" : id)</span>
        }
    </span>;

    private Task ReloadCombatAsync()
    {
        combatLimit = 100;
        return LoadCombatAsync();
    }

    private Task ShowMoreCombatAsync()
    {
        combatLimit = Math.Min(combatLimit + 100, 500);
        return LoadCombatAsync();
    }

    /// <summary>
    /// Loads the combat log for the chosen window and player. Read from the Api's stored copy (the Worker drains the
    /// plugin into it every ~30 seconds), so this is a plain database read. A player id that is not a SteamID64 is not
    /// sent at all: the Api would refuse it, and saying so here is kinder than a generic error.
    /// </summary>
    private async Task LoadCombatAsync()
    {
        // Fail closed, like every plugin feature: nothing is asked of the Api unless the plugin is here and reports the capability.
        if (!PluginListed || !PluginReports(RustArchonPlugin.CombatCapability))
        {
            return;
        }

        loadingCombat = true;
        combatError = null;
        StateHasChanged();

        var player = combatPlayerId?.Trim();
        if (!string.IsNullOrEmpty(player) && (player.Length > 20 || !player.All(char.IsAsciiDigit)))
        {
            combatError = Localizer["A player id is a SteamID64: digits only."];
            loadingCombat = false;
            return;
        }

        DateTimeOffset? since = combatWindow switch
        {
            "1h" => DateTimeOffset.UtcNow.AddHours(-1),
            "24h" => DateTimeOffset.UtcNow.AddDays(-1),
            "7d" => DateTimeOffset.UtcNow.AddDays(-7),
            _ => null
        };

        try
        {
            var log = await RustServerClient.GetCombatLogAsync(Id, since, null, string.IsNullOrEmpty(player) ? null : player, combatLimit);
            combatEvents.Clear();
            combatEvents.AddRange(log.Events);
            combatHasMore = log.HasMore;
        }
        catch (Exception)
        {
            combatError = Localizer["Failed to load the combat log."];
        }
        finally
        {
            loadingCombat = false;
        }

        StateHasChanged();
    }

