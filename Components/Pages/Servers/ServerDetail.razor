@* Copyright ©2026 Scott Blomfield *@

@page "/servers/{Id:guid}"
@using System.IdentityModel.Tokens.Jwt
@using System.Linq
@using System.Net
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using JumpStart.Services.Authentication
@using JumpStart.Services.Authentication.Controllers
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Messaging.Contracts
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IRustServerApiClient RustServerClient
@inject IRconHubClient HubClient
@inject ITokenStore TokenStore
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject SiteBrandingService Branding
@rendermode RenderModes.NonPrerenderedServer
@implements IAsyncDisposable

<PageTitle>@(server?.Name ?? Localizer["Server"]) — @siteName</PageTitle>

@if (loading)
{
    <p><em>@Localizer["Loading server..."]</em></p>
}
else if (server is null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Localizer["Server not found, or it's not one of yours."]
    </div>
    <a class="btn btn-outline-secondary" href="servers"><i class="bi bi-arrow-left"></i> @Localizer["Back to Servers"]</a>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <a href="servers" class="link-arrow d-inline-block mb-2"><i class="bi bi-arrow-left"></i> @Localizer["All Servers"]</a>
            <h1 class="mb-0">@server.Name</h1>
            <p class="text-muted mb-0">
                <code>@server.Host:@server.Port</code>
                @if (!string.IsNullOrEmpty(server.Description))
                {
                    <span> — @server.Description</span>
                }
            </p>
        </div>
        <span class="badge status-badge @StatusBadgeClass(status)">
            <i class="bi @StatusIcon(status)"></i> @StatusText(status)
        </span>
    </div>

    <ul class="nav nav-tabs console-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Console ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Console)">
                <i class="bi bi-terminal"></i> @Localizer["Console"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Chat ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Chat)">
                <i class="bi bi-chat-dots"></i> @Localizer["Chat"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Players ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Players)">
                <i class="bi bi-people"></i> @Localizer["Players"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Stats ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Stats)">
                <i class="bi bi-graph-up"></i> @Localizer["Stats"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Logs ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Logs)">
                <i class="bi bi-journal-text"></i> @Localizer["Logs"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Combat ? "active" : "")" data-testid="tab-combat" @onclick="() => SwitchTabAsync(Tab.Combat)">
                <i class="bi bi-crosshair"></i> @Localizer["Combat"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Map ? "active" : "")" data-testid="tab-map" @onclick="() => SwitchTabAsync(Tab.Map)">
                <i class="bi bi-map"></i> @Localizer["Map"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Positions ? "active" : "")" data-testid="tab-positions" @onclick="() => SwitchTabAsync(Tab.Positions)">
                <i class="bi bi-geo-alt"></i> @Localizer["Positions"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Bases ? "active" : "")" data-testid="tab-bases" @onclick="() => SwitchTabAsync(Tab.Bases)">
                <i class="bi bi-house-door"></i> @Localizer["Bases"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Reports ? "active" : "")" data-testid="tab-reports" @onclick="() => SwitchTabAsync(Tab.Reports)">
                <i class="bi bi-flag"></i> @Localizer["Reports"]
                @if (newReportCount > 0)
                {
                    <span class="badge text-bg-danger ms-1" data-testid="reports-badge">@newReportCount</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Plugins ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Plugins)">
                <i class="bi bi-puzzle"></i> @Localizer["Plugins"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Control ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Control)">
                <i class="bi bi-sliders"></i> @Localizer["Control"]
            </button>
        </li>
    </ul>

    <div class="console-pane">
        @if (activeTab == Tab.Console)
        {
            <div class="console-toolbar">
                <label>
                    @Localizer["Lines"]
                    <select class="form-select form-select-sm" @bind="consoleLineCount">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </label>
                <label>
                    @Localizer["From"]
                    <input type="datetime-local" class="form-control form-control-sm" @bind="consoleSince" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <label>
                    @Localizer["To"]
                    <input type="datetime-local" class="form-control form-control-sm" @bind="consoleUntil" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadConsoleHistoryAsync()" disabled="@loadingConsoleHistory">
                    <i class="bi bi-arrow-clockwise"></i> @Localizer["Load"]
                </button>
                @if (consoleFilterActive)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetConsoleFilterAsync" disabled="@loadingConsoleHistory">
                        <i class="bi bi-x-circle"></i> @Localizer["Reset to latest"]
                    </button>
                }
                @* Only ever offered to a site admin currently acting as this tenant - see
                   IsActingAsTenant's remarks. Nobody else can turn this on: RustServersController.GetEvents
                   and RconHub.JoinUnfilteredServerGroup both independently re-check the same claim
                   server-side, so this checkbox existing at all is not itself what grants anything. *@
                @if (isActingAsTenant)
                {
                    <label class="console-unfiltered-toggle" title="@Localizer["Also shows sent commands and background (worker-initiated) activity normally hidden from tenant users - e.g. a poll that may include privileged data."]">
                        <input type="checkbox" class="form-check-input" role="switch" @bind="unfilteredConsole" @bind:after="OnUnfilteredConsoleToggledAsync" disabled="@loadingConsoleHistory" />
                        @Localizer["Unfiltered (site admin)"]
                    </label>
                }
            </div>

            @if (consoleEvents.Count == 0)
            {
                <div class="console-empty">
                    <i class="bi bi-broadcast"></i>
                    <p>@Localizer["No console activity captured yet."]</p>
                    <p class="text-muted small">@Localizer["Once this server's connection is live, every console line will stream here in real time, and history will still be here the next time you check back - even if nobody was watching when it happened."]</p>
                </div>
            }
            else
            {
                <div class="console-log" @ref="consoleLogRef">
                    @foreach (var evt in consoleEvents)
                    {
                        <div class="console-line @(!evt.Interactive ? "console-line-background" : "")">
                            <span class="console-line-time">@evt.CapturedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            @if (evt.Direction == RconEventDirection.Sent)
                            {
                                <span class="console-line-badge console-line-badge-sent">@Localizer["Sent"]</span>
                            }
                            @if (!evt.Interactive)
                            {
                                <span class="console-line-badge console-line-badge-background">@Localizer["Background"]</span>
                            }
                            <span class="console-line-message">@LinkifyConsoleLine(evt.Message)</span>
                        </div>
                    }
                </div>
            }
            <div class="console-input">
                <input type="text" class="form-control" placeholder="@Localizer["Send a command..."]"
                       @bind="commandText" @bind:event="oninput" @onkeydown="OnCommandKeyDown"
                       disabled="@sendingCommand" />
                <button class="btn btn-primary" @onclick="SendCommandAsync" disabled="@(sendingCommand || string.IsNullOrWhiteSpace(commandText))">
                    @Localizer["Send"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(commandError))
            {
                <p class="text-danger small mt-2">@commandError</p>
            }
        }
        else if (activeTab == Tab.Chat)
        {
            <div class="console-toolbar">
                <label>
                    @Localizer["Lines"]
                    <select class="form-select form-select-sm" @bind="chatLineCount">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </label>
                <label>
                    @Localizer["From"]
                    <input type="datetime-local" class="form-control form-control-sm" @bind="chatSince" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <label>
                    @Localizer["To"]
                    <input type="datetime-local" class="form-control form-control-sm" @bind="chatUntil" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadChatHistoryAsync()" disabled="@loadingChatHistory">
                    <i class="bi bi-arrow-clockwise"></i> @Localizer["Load"]
                </button>
                @if (chatFilterActive)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetChatFilterAsync" disabled="@loadingChatHistory">
                        <i class="bi bi-x-circle"></i> @Localizer["Reset to latest"]
                    </button>
                }
            </div>

            @if (chatEvents.Count == 0)
            {
                <div class="console-empty">
                    <i class="bi bi-chat-dots"></i>
                    <p>@Localizer["No chat activity captured yet."]</p>
                    <p class="text-muted small">@Localizer["In-game chat will show up here once this server's connection is live."]</p>
                </div>
            }
            else
            {
                <div class="console-log" @ref="chatLogRef">
                    @foreach (var evt in chatEvents)
                    {
                        var chat = ParseChatMessage(evt.Message);
                        <div class="console-line">
                            <span class="console-line-time">@evt.CapturedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            @if (chat is not null)
                            {
                                <span class="console-line-message">
                                    @if (IsSteamId(chat.UserId))
                                    {
                                        <a class="chat-username" style="@ChatUsernameStyle(chat.Color)" href="@PlayerHref(chat.UserId!)">@chat.Username</a>
                                    }
                                    else
                                    {
                                        <span class="chat-username" style="@ChatUsernameStyle(chat.Color)">@chat.Username</span>
                                    }
                                    : @chat.Message
                                </span>
                            }
                            else
                            {
                                <span class="console-line-message">@evt.Message</span>
                            }
                        </div>
                    }
                </div>
            }
            <div class="console-input">
                <input type="text" class="form-control" placeholder="@Localizer["Send a chat message..."]"
                       @bind="chatText" @bind:event="oninput" @onkeydown="OnChatKeyDown"
                       disabled="@sendingChat" />
                <button class="btn btn-primary" @onclick="SendChatAsync" disabled="@(sendingChat || string.IsNullOrWhiteSpace(chatText))">
                    @Localizer["Send"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(chatError))
            {
                <p class="text-danger small mt-2">@chatError</p>
            }
        }
        else if (activeTab == Tab.Players)
        {
            <div class="players-columns">
                <div class="players-current">
                    <h2 class="h6 text-muted text-uppercase">@Localizer["Currently connected"]</h2>
                    @if (loadingPlayers)
                    {
                        <p><em>@Localizer["Loading players..."]</em></p>
                    }
                    else if (currentPlayers.Count == 0)
                    {
                        <div class="console-empty">
                            <i class="bi bi-people"></i>
                            <p>@Localizer["Nobody is connected right now."]</p>
                            <p class="text-muted small">@Localizer["Players show up here the moment they join, and drop off the moment they disconnect."]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm player-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Player"]</th>
                                        <th>@Localizer["Steam ID"]</th>
                                        <th>@Localizer["IP address"]</th>
                                        <th>@Localizer["Connected"]</th>
                                        <th>@Localizer["Location"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in currentPlayers)
                                    {
                                        <tr>
                                            <td><a href="@PlayerHref(p.SteamId)">@p.DisplayName</a></td>
                                            <td><code>@p.SteamId</code></td>
                                            <td><code>@p.IpAddress</code></td>
                                            <td>@FormatDuration(p.ConnectedAtUtc)</td>
                                            <td>@GeolocationSummary(p)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="players-kills">
                    <h2 class="h6 text-muted text-uppercase">@Localizer["Recent kills"]</h2>
                    @if (loadingKills)
                    {
                        <p><em>@Localizer["Loading kill history..."]</em></p>
                    }
                    else if (recentKills.Count == 0)
                    {
                        <div class="console-empty">
                            <i class="bi bi-crosshair"></i>
                            <p>@Localizer["No kills captured yet."]</p>
                            <p class="text-muted small">@Localizer["Kills are detected heuristically from console text, so this may miss some and shouldn't be treated as authoritative."]</p>
                        </div>
                    }
                    else
                    {
                        <div class="console-log">
                            @foreach (var k in recentKills)
                            {
                                <div class="console-line">
                                    <span class="console-line-time">@k.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span class="console-line-message">@KillSummary(k)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="players-inactive">
                <h2 class="h6 text-muted text-uppercase">@Localizer["Inactive players"]</h2>
                @if (loadingInactivePlayers && inactivePlayers.Count == 0)
                {
                    <p><em>@Localizer["Loading player history..."]</em></p>
                }
                else if (inactivePlayers.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-clock-history"></i>
                        <p>@Localizer["No player history yet."]</p>
                        <p class="text-muted small">@Localizer["Everyone who has ever connected and since disconnected will show up here, along with their playtime and account info."]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm player-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Nickname"]</th>
                                    <th>@Localizer["Steam ID"]</th>
                                    <th>@Localizer["Country"]</th>
                                    <th>@Localizer["VAC Bans"]</th>
                                    <th>@Localizer["Game Bans"]</th>
                                    <th>@Localizer["Violations"]</th>
                                    <th>@Localizer["Hours on Record"]</th>
                                    <th>@Localizer["Hours on Server"]</th>
                                    <th>@Localizer["Last Ping"]</th>
                                    <th>@Localizer["Last Session"]</th>
                                    <th>@Localizer["IP Address"]</th>
                                    <th>@Localizer["VPN"]</th>
                                    <th>@Localizer["Last Connected"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in inactivePlayers)
                                {
                                    <tr>
                                        <td><a href="@PlayerHref(p.SteamId)">@p.DisplayName</a></td>
                                        <td><code>@p.SteamId</code></td>
                                        <td>@CountrySummary(p)</td>
                                        <td class="@(p.NumberOfVacBans is > 0 ? "text-danger fw-semibold" : "")">@(p.VacBanned.HasValue ? p.NumberOfVacBans ?? 0 : (object)"—")</td>
                                        <td class="@(p.NumberOfGameBans is > 0 ? "text-danger fw-semibold" : "")">@(p.VacBanned.HasValue ? p.NumberOfGameBans ?? 0 : (object)"—")</td>
                                        <td>@(p.LastViolationLevel?.ToString("0.00") ?? "—")</td>
                                        <td>@FormatHoursOnRecord(p.SteamMinutesPlayedForever)</td>
                                        <td>@FormatDurationLong(p.HoursOnServer)</td>
                                        <td>@(p.LastPing.HasValue ? $"{p.LastPing}ms" : "—")</td>
                                        <td>@FormatDurationLong(p.LastConnectionDuration)</td>
                                        <td><code>@p.IpAddress</code></td>
                                        <td>@VpnStatus(p.IsVpn)</td>
                                        <td>@p.LastConnectedAtUtc.ToLocalTime().ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (inactivePlayers.Count < inactivePlayersTotalCount)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadInactivePlayersAsync(append: true)" disabled="@loadingInactivePlayers">
                            @(loadingInactivePlayers ? Localizer["Loading..."] : Localizer["Load more ({0} of {1})", inactivePlayers.Count, inactivePlayersTotalCount])
                        </button>
                    }
                }
            </div>

            <div class="players-banlist">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h6 text-muted text-uppercase mb-0">@Localizer["Ban list"]</h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBanListAsync" disabled="@loadingBanList">
                        <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                    </button>
                </div>
                @if (banListError is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small mt-2 mb-0">@banListError</div>
                }
                else if (loadingBanList && banList.Count == 0)
                {
                    <p><em>@Localizer["Loading ban list..."]</em></p>
                }
                else if (banList.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-slash-circle"></i>
                        <p>@Localizer["No one is banned."]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm player-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Steam ID"]</th>
                                    <th>@Localizer["Name"]</th>
                                    <th>@Localizer["Reason"]</th>
                                    <th>@Localizer["Expires"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in banList)
                                {
                                    <tr>
                                        <td><code>@b.SteamId</code></td>
                                        <td>@b.Name</td>
                                        <td>@b.Reason</td>
                                        <td>@(b.IsPermanent ? Localizer["Permanent"] : b.Expiry)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* A standalone @if here, not a further "else if" chained onto the Console/Chat/Players
           block above - deliberately, not stylistically. Chaining it that way compiled fine but
           the Razor compiler emitted this transition's own "else if (...) { " line as literal
           markup text instead of recognizing it as code (confirmed via the generated
           BuildRenderTree - it showed up as a literal AddMarkupContent(...) string, not a real
           C# branch), immediately after the Players block above's own deep @if/@foreach nesting.
           A standalone @if sidesteps whatever specific parser state that triggers - still
           mutually exclusive with every other tab in practice, since activeTab only ever holds
           one value at a time. *@
        @if (activeTab == Tab.Stats)
        {
            <div class="stats-pane">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-muted text-uppercase mb-0">@Localizer["Server info"]</h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadLiveServerInfoAsync()" disabled="@loadingLiveServerInfo">
                        <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                    </button>
                </div>

                @if (liveServerInfoError is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3">@liveServerInfoError</div>
                }

                @if (loadingLiveServerInfo && liveServerInfo is null)
                {
                    <p><em>@Localizer["Loading server info..."]</em></p>
                }
                else if (liveServerInfo is not null)
                {
                    <dl class="server-info-grid mb-4">
                        <div><dt>@Localizer["Hostname"]</dt><dd>@liveServerInfo.Hostname</dd></div>
                        <div><dt>@Localizer["Map"]</dt><dd>@liveServerInfo.Map</dd></div>
                        <div><dt>@Localizer["Players"]</dt><dd>@liveServerInfo.Players / @liveServerInfo.MaxPlayers @(liveServerInfo.ReservedSlots > 0 ? Localizer["({0} reserved)", liveServerInfo.ReservedSlots] : "")</dd></div>
                        <div><dt>@Localizer["Queued / Joining"]</dt><dd>@liveServerInfo.Queued / @liveServerInfo.Joining</dd></div>
                        <div><dt>@Localizer["Entity Count"]</dt><dd>@liveServerInfo.EntityCount.ToString("N0")</dd></div>
                        <div><dt>@Localizer["Framerate"]</dt><dd>@liveServerInfo.Framerate.ToString("0.0") @Localizer["fps"]</dd></div>
                        <div><dt>@Localizer["Memory"]</dt><dd>@liveServerInfo.Memory @Localizer["MB"] @(liveServerInfo.MemoryUsageSystem > 0 ? Localizer["({0} MB system)", liveServerInfo.MemoryUsageSystem] : "")</dd></div>
                        <div><dt>@Localizer["Collections"]</dt><dd>@liveServerInfo.Collections</dd></div>
                        <div><dt>@Localizer["Uptime"]</dt><dd>@FormatUptime(liveServerInfo.Uptime)</dd></div>
                        <div><dt>@Localizer["Game Time"]</dt><dd>@liveServerInfo.GameTime</dd></div>
                        <div><dt>@Localizer["Save Created"]</dt><dd>@liveServerInfo.SaveCreatedTime</dd></div>
                        <div><dt>@Localizer["Version"]</dt><dd>@liveServerInfo.Version <span class="text-muted">@Localizer["(protocol {0})", liveServerInfo.Protocol]</span></dd></div>
                        <div><dt>@Localizer["Restarting"]</dt><dd>@(liveServerInfo.Restarting ? Localizer["Yes"] : Localizer["No"])</dd></div>
                    </dl>
                }

                <h2 class="h6 text-muted text-uppercase mb-2">@Localizer["Trends"]</h2>
                @if (serverInfoHistoryError is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3">@serverInfoHistoryError</div>
                }
                @if (loadingServerInfoHistory && serverInfoHistory.Count == 0)
                {
                    <p><em>@Localizer["Loading history..."]</em></p>
                }
                else if (serverInfoHistory.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-graph-up"></i>
                        <p>@Localizer["No history captured yet."]</p>
                        <p class="text-muted small">@Localizer["RustArchon.Worker polls"] <code>serverinfo</code> @Localizer["every 60 seconds while connected - check back shortly after the server comes online."]</p>
                    </div>
                }
                else
                {
                    <div class="stats-charts">
                        <div class="chart-card">
                            <h3 class="h6">@Localizer["Player Count"]</h3>
                            <div class="chart-wrap"><canvas id="playersChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <h3 class="h6">@Localizer["Network In/Out (bytes/s)"]</h3>
                            <div class="chart-wrap"><canvas id="networkChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <h3 class="h6">@Localizer["Memory (MB)"]</h3>
                            <div class="chart-wrap"><canvas id="memoryChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <h3 class="h6">@Localizer["Server FPS"]</h3>
                            <div class="chart-wrap"><canvas id="fpsChart"></canvas></div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Logs)
        {
            <div class="logs-pane">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-muted text-uppercase mb-0">@Localizer["Connection Log"]</h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadConnectionLogAsync()" disabled="@loadingConnectionLog">
                        <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                    </button>
                </div>

                @if (connectionLogError is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3">@connectionLogError</div>
                }

                @if (loadingConnectionLog && connectionLog.Count == 0)
                {
                    <p><em>@Localizer["Loading connection log..."]</em></p>
                }
                else if (connectionLog.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-plug"></i>
                        <p>@Localizer["No log entries in the last 24 hours."]</p>
                    </div>
                }
                else
                {
                    <div class="connection-log" @ref="logsLogRef">
                        @foreach (var entry in connectionLog)
                        {
                            <div class="connection-log-entry">
                                <span class="connection-log-time">@entry.OccurredAtUtc.ToLocalTime().ToString("MM/dd HH:mm:ss")</span>
                                @if (entry.Status is { } entryStatus)
                                {
                                    <span class="badge status-badge @StatusBadgeClass(entryStatus)">
                                        <i class="bi @StatusIcon(entryStatus)"></i> @StatusText(entryStatus)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge status-badge @LevelBadgeClass(entry.Level)">
                                        <i class="bi @LevelIcon(entry.Level)"></i> @LevelText(entry.Level)
                                    </span>
                                }
                                <span class="connection-log-detail">@entry.Message</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Control)
        {
            <div class="control-pane">
                @if (controlError is not null)
                {
                    <div class="alert alert-danger alert-dismissible py-2 px-3 small mb-3">
                        @controlError
                        <button type="button" class="btn-close" @onclick="() => controlError = null"></button>
                    </div>
                }
                @if (controlSuccessMessage is not null)
                {
                    <div class="alert alert-success py-2 px-3 small mb-3">@controlSuccessMessage</div>
                }

                <div class="control-grid">
                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["Time"]</h2>
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" class="form-control form-control-sm" style="width:5rem" min="0" max="24" step="0.5" @bind="controlTimeValue" />
                            <button class="btn btn-sm btn-outline-primary" @onclick="SetTimeAsync" disabled="@controlBusy">@Localizer["Set Time"]</button>
                        </div>
                        <p class="control-card-hint">@Localizer["0-24, e.g. 12 for noon"]</p>
                    </div>

                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["Weather"]</h2>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Rain"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.rain", "1")' disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.rain", "0")' disabled="@controlBusy">@Localizer["Off"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.rain", "*")' disabled="@controlBusy">@Localizer["Auto"]</button>
                            </div>
                        </div>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Fog"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.fog", "1")' disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.fog", "0")' disabled="@controlBusy">@Localizer["Off"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.fog", "*")' disabled="@controlBusy">@Localizer["Auto"]</button>
                            </div>
                        </div>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Clouds"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.clouds", "1")' disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.clouds", "0")' disabled="@controlBusy">@Localizer["Off"]</button>
                                <button class="btn btn-outline-secondary" @onclick='() => SetWeatherAsync("weather.clouds", "*")' disabled="@controlBusy">@Localizer["Auto"]</button>
                            </div>
                        </div>
                    </div>

                    @* Radiation + Animals share this card, not two separate ones - all three rows are
                       the same "fire an on/off convar" shape as Weather's rows above, so splitting them
                       into their own single/double-row cards just multiplied border/padding chrome
                       without adding information density. *@
                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["World"]</h2>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Radiation"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-success" @onclick="() => SetRadiationAsync(true)" disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-danger" @onclick="() => SetRadiationAsync(false)" disabled="@controlBusy">@Localizer["Off"]</button>
                            </div>
                        </div>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Animal Move"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-success" @onclick='() => SetAiConvarAsync("ai.move", true)' disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-danger" @onclick='() => SetAiConvarAsync("ai.move", false)' disabled="@controlBusy">@Localizer["Off"]</button>
                            </div>
                        </div>
                        <div class="control-row">
                            <span class="control-row-label">@Localizer["Animal AI"]</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-success" @onclick='() => SetAiConvarAsync("ai.think", true)' disabled="@controlBusy">@Localizer["On"]</button>
                                <button class="btn btn-outline-danger" @onclick='() => SetAiConvarAsync("ai.think", false)' disabled="@controlBusy">@Localizer["Off"]</button>
                            </div>
                        </div>
                    </div>

                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["World Reset"]</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-warning" @onclick="ResetAnimalsAsync" disabled="@controlBusy">
                                <i class="bi bi-arrow-repeat"></i> @Localizer["Animals"]
                            </button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="ResetResourcesAsync" disabled="@controlBusy">
                                <i class="bi bi-arrow-repeat"></i> @Localizer["Resources"]
                            </button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="ResetCollectiblesAsync" disabled="@controlBusy">
                                <i class="bi bi-arrow-repeat"></i> @Localizer["Collectibles"]
                            </button>
                        </div>
                    </div>

                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["Configuration"]</h2>
                        <button class="btn btn-sm btn-outline-primary align-self-start" @onclick="SaveConfigAsync" disabled="@controlBusy">
                            <i class="bi bi-save"></i> @Localizer["Save server.cfg"]
                        </button>
                        <p class="control-card-hint">@Localizer["Writes the server's current convars to"] <code>server.cfg</code> @Localizer["so they survive a restart."]</p>
                    </div>

                    <div class="control-card">
                        <h2 class="h6 text-muted text-uppercase">@Localizer["Notice"]</h2>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control form-control-sm flex-grow-1" placeholder="@Localizer["Message to pop up for everyone"]" @bind="noticeMessage" />
                            <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="SendNoticeAsync" disabled="@(controlBusy || string.IsNullOrWhiteSpace(noticeMessage))">
                                <i class="bi bi-megaphone"></i> @Localizer["Send Notice"]
                            </button>
                        </div>
                        <p class="control-card-hint">@Localizer["A server-wide popup, distinct from a plain chat message - see the Chat tab for that."]</p>
                    </div>
                </div>
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Combat)
        {
            <div class="combat-pane" data-testid="combat-pane">
                @if (!PluginListed)
                {
                    <div class="alert alert-secondary" data-testid="combat-needs-plugin">
                        <i class="bi bi-plug"></i>
                        @Localizer["The combat log needs the RustArchon plugin, which is not detected on this server. Install it from the Plugins tab."]
                    </div>
                }
                else if (pluginStatus is null)
                {
                    <div class="alert alert-secondary" data-testid="combat-no-handshake">
                        @Localizer["The RustArchon plugin is loaded but has not answered yet. This can take a few minutes after it loads."]
                    </div>
                }
                else if (!PluginReports(RustArchonPlugin.CombatCapability))
                {
                    <div class="alert alert-secondary" data-testid="combat-not-supported">
                        @Localizer["This version of the RustArchon plugin cannot record combat yet. Update it from the Plugins tab."]
                    </div>
                }
                else
                {
                    @if (server is not null && !server.PluginCombatLogEnabled)
                    {
                        <div class="alert alert-warning py-2 small" data-testid="combat-switched-off">
                            @Localizer["The combat log is switched off, so nothing new is being recorded. Turn it on in the Plugins tab. What was recorded before is shown below."]
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-end mb-3" data-testid="combat-filters">
                        <div>
                            <label class="form-label small mb-1" for="combat-window">@Localizer["Time window"]</label>
                            <select id="combat-window" class="form-select form-select-sm" @bind="combatWindow" @bind:after="ReloadCombatAsync">
                                <option value="1h">@Localizer["Last hour"]</option>
                                <option value="24h">@Localizer["Last 24 hours"]</option>
                                <option value="7d">@Localizer["Last 7 days"]</option>
                                <option value="all">@Localizer["Everything"]</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-1" for="combat-player">@Localizer["Player (SteamID64)"]</label>
                            <input id="combat-player" class="form-control form-control-sm" maxlength="20" placeholder="7656119..."
                                   @bind="combatPlayerId" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" data-testid="combat-apply" disabled="@loadingCombat" @onclick="ReloadCombatAsync">
                            @Localizer["Apply"]
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="combat-refresh" disabled="@loadingCombat" @onclick="ReloadCombatAsync">
                            <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                        </button>
                    </div>

                    @if (combatError is not null)
                    {
                        <div class="alert alert-danger py-2 small" data-testid="combat-error">@combatError</div>
                    }

                    @if (loadingCombat && combatEvents.Count == 0)
                    {
                        <p><em>@Localizer["Loading..."]</em></p>
                    }
                    else if (combatEvents.Count == 0)
                    {
                        <p class="text-muted" data-testid="combat-empty">@Localizer["No combat recorded in this window."]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" data-testid="combat-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Time"]</th>
                                        <th>@Localizer["Attacker"]</th>
                                        <th>@Localizer["Victim"]</th>
                                        <th>@Localizer["Weapon"]</th>
                                        <th class="text-end">@Localizer["Damage"]</th>
                                        <th class="text-end">@Localizer["Distance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in combatEvents)
                                    {
                                        <tr data-testid="combat-row" data-kind="@e.Kind">
                                            <td class="text-nowrap small">@e.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                                            <td>
                                                @CombatParty(e.AttackerName, e.AttackerId, e.AttackerIsPlayer)
                                            </td>
                                            <td>
                                                @CombatParty(e.VictimName, e.VictimId, e.VictimIsPlayer)
                                                @if (e.Kind == "death")
                                                {
                                                    <span class="badge bg-danger ms-1" data-testid="combat-death">@Localizer["killed"]</span>
                                                }
                                            </td>
                                            <td class="small">@e.Weapon</td>
                                            <td class="text-end">
                                                @e.Damage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
                                                @if (!string.IsNullOrEmpty(e.DamageType))
                                                {
                                                    <span class="text-muted small">@e.DamageType</span>
                                                }
                                                @if (e.Headshot)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1" data-testid="combat-headshot">@Localizer["headshot"]</span>
                                                }
                                            </td>
                                            <td class="text-end small">
                                                @(e.Distance is null ? "" : e.Distance.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " m")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (combatHasMore && combatLimit < 500)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="combat-more" disabled="@loadingCombat" @onclick="ShowMoreCombatAsync">
                                @Localizer["Show older"]
                            </button>
                        }
                        else if (combatHasMore)
                        {
                            <p class="small text-muted" data-testid="combat-capped">@Localizer["Showing the newest 500. Narrow the time window or pick a player to see more."]</p>
                        }
                    }
                }
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Map)
        {
            <ServerMapPane ServerId="Id" PluginListed="PluginListed" PluginSupportsMap="PluginReports(RustArchonPlugin.MapCapability)" />
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Reports)
        {
            <ServerReportsPane ServerId="Id" RefreshToken="reportsRefreshToken" NewCountChanged="OnNewReportCountChanged" />
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Positions)
        {
            <div class="positions-pane" data-testid="positions-pane">
                @if (!PluginListed)
                {
                    <div class="alert alert-secondary" data-testid="positions-needs-plugin">
                        <i class="bi bi-plug"></i>
                        @Localizer["The positions view needs the RustArchon plugin, which is not detected on this server. Install it from the Plugins tab."]
                    </div>
                }
                else if (pluginStatus is null)
                {
                    <div class="alert alert-secondary" data-testid="positions-no-handshake">
                        @Localizer["The RustArchon plugin is loaded but has not answered yet. This can take a few minutes after it loads."]
                    </div>
                }
                else if (!PluginReports(RustArchonPlugin.PositionsCapability))
                {
                    <div class="alert alert-secondary" data-testid="positions-not-supported">
                        @Localizer["This version of the RustArchon plugin cannot record positions yet. Update it from the Plugins tab."]
                    </div>
                }
                else if (positionsForbidden)
                {
                    <div class="alert alert-warning" data-testid="positions-forbidden">
                        <i class="bi bi-shield-lock"></i>
                        @Localizer["You don't have permission to see where players are. The organization's owner can grant it to a role."]
                    </div>
                }
                else
                {
                    @if (server is not null && !server.PluginRecordingEnabled)
                    {
                        <div class="alert alert-warning py-2 small" data-testid="positions-recording-off">
                            @Localizer["Recording is switched off, so positions are not being recorded. Turn it on in the Plugins tab."]
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="positions-refresh" disabled="@loadingPositions" @onclick="LoadPositionsAsync">
                            <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh"]
                        </button>
                        @if (positionsLoadedAt is not null)
                        {
                            <span class="small text-muted" data-testid="positions-captured">
                                @Localizer["As of"] @positionsLoadedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            </span>
                        }
                    </div>

                    @if (positionsError is not null)
                    {
                        <div class="alert alert-danger py-2 small" data-testid="positions-error">@positionsError</div>
                    }

                    @if (loadingPositions && positions is null)
                    {
                        <p><em>@Localizer["Loading..."]</em></p>
                    }
                    else if (PositionRows().Count == 0)
                    {
                        <p class="text-muted" data-testid="positions-empty">@Localizer["No players seen in the last 10 minutes."]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" data-testid="positions-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Player"]</th>
                                        <th>@Localizer["Status"]</th>
                                        <th>@Localizer["Location"]</th>
                                        <th>@Localizer["Facing"]</th>
                                        <th>@Localizer["Last seen"]</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in PositionRows())
                                    {
                                        <tr data-testid="position-row">
                                            <td>
                                                <span>@row.Name</span>
                                                <br />
                                                <span class="text-muted small">@row.PlayerId</span>
                                            </td>
                                            <td data-testid="position-status">@(row.Online ? Localizer["Online"] : Localizer["Left"])</td>
                                            <td class="text-nowrap small">
                                                x @row.Latest.X.ToString("0", System.Globalization.CultureInfo.InvariantCulture),
                                                z @row.Latest.Z.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
                                                <span class="text-muted">(@Localizer["height"] @row.Latest.Y.ToString("0", System.Globalization.CultureInfo.InvariantCulture))</span>
                                            </td>
                                            <td class="text-nowrap small" data-testid="position-facing">@Compass(row.Latest.Yaw) (@row.Latest.Yaw°)</td>
                                            <td class="text-nowrap small">@row.Latest.OccurredAtUtc.ToString("HH:mm:ss") UTC</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-testid="position-track" @onclick="() => SelectPlayerAsync(row.PlayerId)">
                                                    @Localizer["Show track"]
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (selectedPlayerId is not null)
                    {
                        <div class="card mt-3" data-testid="track-pane">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>@Localizer["Movement in the last hour"]: <strong>@PlayerNameFor(selectedPlayerId)</strong></span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="track-close" @onclick="CloseTrack">@Localizer["Close"]</button>
                            </div>
                            <div class="card-body">
                                @if (trackError is not null)
                                {
                                    <div class="alert alert-danger py-2 small" data-testid="track-error">@trackError</div>
                                }
                                else if (loadingTrack)
                                {
                                    <p><em>@Localizer["Loading..."]</em></p>
                                }
                                else if (selectedTrack is null || selectedTrack.Samples.Count == 0)
                                {
                                    <p class="text-muted" data-testid="track-empty">@Localizer["No movement recorded for this player in the last hour."]</p>
                                }
                                else
                                {
                                    <p class="small" data-testid="track-total">@Localizer["Total distance"]: @TrackDistance(selectedTrack).ToString("0", System.Globalization.CultureInfo.InvariantCulture) m</p>
                                    @if (selectedTrack.HasMore)
                                    {
                                        <p class="small text-muted" data-testid="track-truncated">@Localizer["Only the most recent points are shown."]</p>
                                    }
                                    <div class="table-responsive">
                                        <table class="table table-sm" data-testid="track-table">
                                            <thead>
                                                <tr><th>@Localizer["Time"]</th><th>@Localizer["Location"]</th><th></th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in selectedTrack.Samples.Take(100))
                                                {
                                                    <tr data-testid="track-row">
                                                        <td class="text-nowrap small">@s.OccurredAtUtc.ToString("HH:mm:ss") UTC</td>
                                                        <td class="text-nowrap small">
                                                            x @s.X.ToString("0", System.Globalization.CultureInfo.InvariantCulture),
                                                            z @s.Z.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
                                                        </td>
                                                        <td class="small text-muted">@(s.Marker == "on" ? Localizer["Joined"] : s.Marker == "off" ? Localizer["Left"] : "")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* Standalone @if, not "else if" - see the identical note on the Stats block above. *@
        @if (activeTab == Tab.Bases)
        {
            <div class="bases-pane" data-testid="bases-pane">
