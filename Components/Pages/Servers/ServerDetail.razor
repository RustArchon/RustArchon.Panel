    /// <summary>
    /// Loads the Plugins tab's list - the plugins the Worker last polled from this server (see
    /// <c>ServerPluginsCaptured</c>), read from the Api's stored copy rather than asked of the live
    /// server, so this is a plain database read like the other history loads, not an RCON round-trip.
    /// </summary>
    private async Task LoadPluginsAsync()
    {
        loadingPlugins = true;
        pluginsError = null;
        StateHasChanged();

        try
        {
            var result = await RustServerClient.GetPluginsAsync(Id);
            plugins.Clear();
            plugins.AddRange(result);
            pluginFramework = result.Count > 0 ? result[0].Framework : null;
        }
        catch (Exception)
        {
            pluginsError = Localizer["Failed to load the plugin list."];
        }
        finally
        {
            loadingPlugins = false;
        }

        // The recent update attempts, separately again: they only ever add to the card.
        try
        {
            var recent = await RustServerClient.GetPluginUpdateAttemptsAsync(Id);
            pluginAttempts.Clear();
            pluginAttempts.AddRange(recent);
        }
        catch (Exception)
        {
            pluginAttempts.Clear();
        }

        // Separate from the list so a failure here (or a server that has never reported one) simply shows no update notices.
        try
        {
            var updates = await RustServerClient.GetPluginUpdatesAsync(Id);
            pluginUpdates.Clear();
            pluginUpdates.AddRange(updates);
        }
        catch (Exception)
        {
            pluginUpdates.Clear();
        }

        // Separate from the list above so a failure here cannot hide the list. A failure just means "no
        // handshake known", which leaves every plugin feature off - the safe direction.
        try
        {
            var response = await RustServerClient.GetPluginStatusAsync(Id);
            pluginStatus = response is { IsSuccessStatusCode: true } ? response.Content : null;
        }
        catch (Exception)
        {
            pluginStatus = null;
        }

        StateHasChanged();
    }

    /// <summary>One recent update, in plain words: who started it, what, from and to which version, how it went and when.</summary>
    private string AttemptText(PluginUpdateAttemptDto a)
    {
        var who = a.Trigger == "auto" ? Localizer["Automatic"] : Localizer["Manual"];
        var what = a.Kind == "updater" ? Localizer["Updater"] : Localizer["Plugin"];
        var outcome = a.State switch
        {
            "succeeded" => Localizer["succeeded"],
            "started" => Localizer["in progress"],
            "failed" => Localizer["did not take effect and was put back"],
            "refused" => Localizer["refused"],
            _ => Localizer[a.State]
        };
        var from = string.IsNullOrEmpty(a.FromVersion) ? "-" : a.FromVersion;
        var code = string.IsNullOrEmpty(a.Code) ? "" : $" ({a.Code})";
        return $"{who} · {what} {from} → {a.ToVersion} · {outcome}{code} · {a.StartedAtUtc:yyyy-MM-dd HH:mm} UTC";
    }

