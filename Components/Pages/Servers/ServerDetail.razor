    /// <summary>
    /// Parses <c>global.banlistex</c>'s raw text, one entry per non-empty line. Quoted fields
    /// (name, reason) may contain spaces, so this walks the line manually rather than a plain
    /// <c>Split(' ')</c> - a naive split would break on any name or reason containing a space, which
    /// real-world data does constantly.
    /// </summary>
    private static IEnumerable<BanListEntry> ParseBanList(string raw)
    {
        foreach (var line in raw.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmed = line.Trim();
            if (trimmed.Length == 0)
            {
                continue;
            }

            var fields = new List<string>();
            var i = 0;
            while (i < trimmed.Length && fields.Count < 5)
            {
                while (i < trimmed.Length && trimmed[i] == ' ')
                {
                    i++;
                }

                if (i >= trimmed.Length)
                {
                    break;
                }

                if (trimmed[i] == '"')
                {
                    var end = trimmed.IndexOf('"', i + 1);
                    if (end < 0)
                    {
                        break;
                    }

                    fields.Add(trimmed.Substring(i + 1, end - i - 1));
                    i = end + 1;
                }
                else
                {
                    var end = trimmed.IndexOf(' ', i);
                    if (end < 0)
                    {
                        end = trimmed.Length;
                    }

                    fields.Add(trimmed.Substring(i, end - i));
                    i = end;
                }
            }

            // <index> <steamid> "<name>" "<reason>" <expiry>
            if (fields.Count == 5)
            {
                var expiry = fields[4];
                yield return new BanListEntry(fields[1], fields[2], fields[3], expiry == "-1", expiry);
            }
        }
    }

