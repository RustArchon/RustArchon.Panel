    /// <summary>
    /// Whether the current session's API token carries <see cref="TokenController.ActingAsClaimType"/>
    /// - i.e. this is a site admin currently acting as this server's own tenant (see
    /// <c>SiteAdminCrossTenantPolicy</c>), the only audience the unfiltered-console toggle is ever
    /// offered to.
    /// </summary>
    /// <remarks>
    /// Decoded from the raw token client-side rather than asked of the API - this only ever decides
    /// whether the Panel *offers* the toggle. Both places that actually enforce it
    /// (<c>RustServersController.GetEvents</c>, <c>RconHub.JoinUnfilteredServerGroup</c>) independently
    /// re-derive the same fact from the token themselves, so a forged or stale client-side read here
    /// costs nothing beyond showing (or hiding) a checkbox that does nothing on its own. Safe to call
    /// once <see cref="RustServerClient"/>'s own token exchange has already run (see this page's
    /// <c>OnInitializedAsync</c> - the same ordering <see cref="RconHubClient"/>'s own remarks rely on).
    /// </remarks>
    private bool IsActingAsTenant()
    {
        var token = TokenStore.GetToken();
        if (string.IsNullOrEmpty(token))
        {
            return false;
        }

        try
        {
            var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);
            return jwt.Claims.Any(c => c.Type == TokenController.ActingAsClaimType && c.Value == "true");
        }
        catch (ArgumentException)
        {
            // Malformed/non-JWT token - treat the same as "not acting as anyone" rather than throwing
            // out of a page load over what is, at worst, a hidden checkbox.
            return false;
        }
    }

    /// <summary>
    /// Switches the Console tab between the ordinary (interactive-only) view and the unfiltered one -
    /// re-joins the right SignalR group for live events going forward, and reloads history so what's
    /// already on screen matches too.
    /// </summary>
    private async Task OnUnfilteredConsoleToggledAsync()
    {
        await HubClient.SetUnfilteredAsync(unfilteredConsole);
        await LoadConsoleHistoryAsync();
    }

    private Task ResetChatFilterAsync()
    {
        chatSince = null;
        chatUntil = null;
        return LoadChatHistoryAsync();
    }

    // <input type="datetime-local"> gives a plain wall-clock value with no offset - interpreted here
    // as the server's own local time zone, matching how CapturedAtUtc is already displayed elsewhere
    // on this page (.ToLocalTime(), which for a Blazor Server app means the server's zone, not the
    // viewer's browser). Good enough for "show me roughly what happened around this time" filtering.
    private static DateTimeOffset? ToServerLocalUtc(DateTime? localValue) =>
        localValue.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(localValue.Value, DateTimeKind.Local)).ToUniversalTime()
            : null;

    private void Classify(RconEventDto evt)
    {
        if (string.Equals(evt.Type, ChatFrameType, StringComparison.OrdinalIgnoreCase))
        {
            chatEvents.Add(evt);
        }
        else
        {
            consoleEvents.Add(evt);
        }
    }

    private void OnEventReceived(RconEventDto evt)
    {
        var isChat = string.Equals(evt.Type, ChatFrameType, StringComparison.OrdinalIgnoreCase);

        InvokeAsync(async () =>
        {
            // Only worth asking "is the pane already scrolled to the bottom" when that pane is the
            // one currently on screen - the other tab's log isn't in the DOM at all right now, so
            // there's nothing to check (it gets its own scroll-to-bottom when the user switches to
            // it). And only when its log div actually exists yet - an empty list renders the
            // empty-state placeholder instead, leaving consoleLogRef/chatLogRef unbound; invoking JS
            // interop against an unbound ElementReference throws. This new event is about to become
            // that list's very first item, so there's nothing to be "not at the bottom of" anyway.
            if (isChat && activeTab == Tab.Chat)
            {
                pendingChatScroll = chatEvents.Count == 0
                    || await JS.InvokeAsync<bool>("consoleScroll.isNearBottom", chatLogRef);
            }
            else if (!isChat && activeTab == Tab.Console)
            {
                pendingConsoleScroll = consoleEvents.Count == 0
                    || await JS.InvokeAsync<bool>("consoleScroll.isNearBottom", consoleLogRef);
            }

            Classify(evt);
            StateHasChanged();
        });
    }

    private void OnStatusChanged(Guid serverId, RconConnectionStatus newStatus, string? detail)
    {
        if (serverId != Id)
        {
            return;
        }

        // Only the live badge (header pill, ServersList's icons elsewhere) - the Logs tab's own list is
        // handled separately by OnLogEntryReceived below, which carries the server's real Level/Message
        // for this same transition rather than this handler re-deriving an approximation of it.
        InvokeAsync(() =>
        {
            status = newStatus;
            StateHasChanged();
        });
    }

    /// <summary>
    /// Appends a Logs-tab entry live - fires for both a connection-status transition (relayed
    /// alongside OnStatusChanged above, from the same server-side event) and a worker-side diagnostic
    /// that isn't one - see <see cref="RconHubClient.LogEntryReceived"/>'s remarks.
    /// </summary>
    private void OnLogEntryReceived(Guid serverId, ConnectionLogLevel level, string message, RconConnectionStatus? entryStatus, DateTimeOffset occurredAtUtc)
    {
        if (serverId != Id)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            // Appended live, not just refetched on the next Logs-tab visit - the whole point of this
            // log is answering "what just happened" while it's still fresh, same reasoning as the
            // Console/Chat tabs' own live-append handlers - and the same near-bottom check those use
            // (see OnEventReceived) before mutating the list, so this doesn't yank someone back to the
            // bottom while they've scrolled up to read older entries.
            if (activeTab == Tab.Logs)
            {
                pendingLogsScroll = connectionLog.Count == 0
                    || await JS.InvokeAsync<bool>("consoleScroll.isNearBottom", logsLogRef);
            }

            // Inserted by OccurredAtUtc, not always appended at the end - ConnectionStatusConsumer
            // deliberately allows more than one transition for this server to be in flight concurrently
            // (see its own remarks; no ConcurrentMessageLimit/partitioner is configured for it), and the
            // atomic per-row guard that protects RustServer.ConnectionStatus from ever regressing says
            // nothing about the order two *different*, both-valid transitions' own log-write-then-push
            // steps finish in relative to each other - a genuinely newer transition's push can still
            // land before an older one's. A blind end-of-list append would then show it out of order,
            // even though every row's own OccurredAtUtc (and the DB, which always sorts by it - see
            // ConnectionLogRepository.GetForServerAsync) has the true order the whole time.
            var entry = new ConnectionLogEntryDto
            {
                Level = level,
                Message = message,
                Status = entryStatus,
                OccurredAtUtc = occurredAtUtc
            };
            var index = connectionLog.FindIndex(existing => existing.OccurredAtUtc > entry.OccurredAtUtc);
            if (index < 0)
            {
                connectionLog.Add(entry);
            }
            else
            {
                connectionLog.Insert(index, entry);
            }

            StateHasChanged();
        });
    }

    private async Task OnCommandKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommandAsync();
        }
    }

    private async Task SendCommandAsync()
    {
        if (string.IsNullOrWhiteSpace(commandText) || sendingCommand)
        {
            return;
        }

        sendingCommand = true;
        commandError = null;
        var command = commandText;
        commandText = string.Empty;

        try
        {
            // Interactive: true - a human typed this into the Console tab and hit Enter/Send.
            var result = await RustServerClient.SendCommandAsync(
                Id, new SendCommandRequest { Command = command, Interactive = true });
            if (!result.Success)
            {
                commandError = result.Error switch
                {
                    "NotConnected" => Localizer["This server isn't connected right now - the command wasn't sent."],
                    _ => result.Error ?? Localizer["The command failed."]
                };
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            commandError = Localizer["No worker responded in time - this server may not have an active connection."];
        }
        catch (Exception)
        {
            commandError = Localizer["Something went wrong sending that command."];
        }
        finally
        {
            sendingCommand = false;
        }
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendChatAsync();
        }
    }

    private async Task SendChatAsync()
    {
        if (string.IsNullOrWhiteSpace(chatText) || sendingChat)
        {
            return;
        }

        sendingChat = true;
        chatError = null;
        var message = chatText;
        chatText = string.Empty;

        try
        {
            // Rust's own console command for broadcasting to every player's in-game chat - there's no
            // separate "chat" RCON verb, so this rides the exact same command channel/endpoint the
            // Console tab uses. The server echoes it back as its own Chat-typed frame, so it'll appear
            // in this list via the live tail rather than being added optimistically here.
            // Interactive: true - a human typed and sent this chat message.
            var result = await RustServerClient.SendCommandAsync(
                Id, new SendCommandRequest { Command = BuildSayCommand(message), Interactive = true });
            if (!result.Success)
            {
                chatError = result.Error switch
                {
                    "NotConnected" => Localizer["This server isn't connected right now - the message wasn't sent."],
                    _ => result.Error ?? Localizer["The message failed to send."]
                };
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            chatError = Localizer["No worker responded in time - this server may not have an active connection."];
        }
        catch (Exception)
        {
            chatError = Localizer["Something went wrong sending that message."];
        }
        finally
        {
            sendingChat = false;
        }
    }

    // Rust's WebRCON reports an unsolicited chat frame's Type as "Chat" and its Message as a
    // JSON-encoded object (Username/Message/Color/...), not plain text - this is the protocol's own
    // wire format (vanilla Rust, not a Carbon/Oxide quirk), and RustArchon's capture pipeline
    // (RustArchon.Worker's ServerConnectionActor) stores every frame's Message verbatim by design,
    // deferring exactly this kind of parsing to a reader-side layer - see RconEvent's remarks.
    // RustArchon.Rcon already has a ChatParser/ChatMessage pair for this shape, but it's built for
    // chat.tail's *array* response, not a single live frame's bare object - rather than pull that
    // library in here (this project only ever reaches RustArchon entities through DTOs/API clients,
    // never their lower-level implementation types) and adapt it for a shape it wasn't built for,
    // this is a small, display-only parse: falls back to the raw text on anything that doesn't match,
    // so an unexpected shape (or a genuinely plain-text "Chat" frame from some other setup) still
    // shows something instead of an empty line.
    private static readonly JsonSerializerOptions ChatPayloadJsonOptions = new() { PropertyNameCaseInsensitive = true };

    private sealed class ChatPayload
    {
        public string Username { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string? Color { get; set; }

        /// <summary>The chatter's Steam64 ID - Rust's own chat frame includes this alongside
        /// Username/Message/Color, confirmed live. Powers the username link to their player detail
        /// page; left null/unlinked for anything that doesn't look like a real Steam64 ID (see
        /// KillFeedTextParser's AsSteamId remarks for the same 17-digit heuristic).</summary>
        public string? UserId { get; set; }
    }

    private static ChatPayload? ParseChatMessage(string rawMessage)
    {
        try
        {
            var payload = JsonSerializer.Deserialize<ChatPayload>(rawMessage, ChatPayloadJsonOptions);
            return !string.IsNullOrEmpty(payload?.Username) ? payload : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    // Rust reports colors as plain hex ("#eeeeee") or a handful of named values - allowlisting the
    // shape before it lands in a style attribute is cheap insurance against a malformed/unexpected
    // value breaking the CSS declaration, not a defense against HTML injection (Blazor already
    // HTML-encodes attribute values regardless).
    private static string ChatUsernameStyle(string? color) =>
        !string.IsNullOrWhiteSpace(color) && System.Text.RegularExpressions.Regex.IsMatch(color, "^#?[0-9a-zA-Z]{1,10}$")
            ? $"color: {color};"
            : string.Empty;

    // Rust's "say" console command takes the rest of the line as the message verbatim - it does not
    // treat quotes as argument delimiters. Wrapping the message in quotes (an earlier version of this
    // method did) doesn't protect anything; it just makes the quote characters part of what gets
    // spoken, confirmed live: sending `say "hello"` broadcasts the literal text `"hello"`, quotes and
    // all. So this is intentionally a bare passthrough, not an escaping no-op.
    private static string BuildSayCommand(string message) => $"say {message}";

    private string FormatDuration(DateTimeOffset connectedAtUtc)
    {
        var elapsed = DateTimeOffset.UtcNow - connectedAtUtc;
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return elapsed.TotalHours >= 1
            ? Localizer["{0}h {1}m", (int)elapsed.TotalHours, elapsed.Minutes]
            : Localizer["{0}m", Math.Max(0, (int)elapsed.TotalMinutes)];
    }

    // Every IGeolocationProvider is currently a stub that always returns null (see the Providers/
    // remarks), so in practice this always falls through to "—" today - it's written against the
    // real shape now so nothing here needs to change once a provider is actually wired up.
    private string GeolocationSummary(PlayerSessionDto player)
    {
        if (string.IsNullOrEmpty(player.GeolocationCountry))
        {
            return "—";
        }

        var label = !string.IsNullOrEmpty(player.GeolocationCountryCode)
            ? $"{player.GeolocationCountry} ({player.GeolocationCountryCode})"
            : player.GeolocationCountry;

        var flags = new List<string>();
        if (player.GeolocationIsVpn == true)
        {
            flags.Add(Localizer["VPN"]);
        }
        if (player.GeolocationIsProxy == true)
        {
            flags.Add(Localizer["Proxy"]);
        }

        return flags.Count > 0 ? $"{label} — {string.Join(", ", flags)}" : label!;
    }

    private string PlayerHref(string steamId) => $"servers/{Id}/players/{steamId}";

    // Same 17-digit heuristic as KillFeedTextParser.AsSteamId - an NPC's network/entity ID never gets
    // remotely close to that length, so this reliably tells a real player apart from one without
    // needing to know anything about where the value came from.
    private static bool IsSteamId(string? value) => value is { Length: 17 } && value.All(char.IsDigit);

    // Finds every "<name>[<17-digit-steamid>]" occurrence in a raw console line (the shape used by
    // kill lines, "has spawned", etc. - see KillFeedTextParser's remarks) and turns just the name
    // portion into a link to that player's detail page, leaving the rest of the line as plain text.
    // Deliberately narrow rather than an attempt at universal name detection - lines that don't
    // happen to carry a bracketed Steam64 ID (e.g. the "ip:port/steamid/name joined" shape) simply
    // stay unlinked, same as they'd read today.
    private static readonly Regex ConsoleNameWithSteamIdPattern = new(@"(?<name>[^\[\]\r\n]+?)\[(?<id>\d{17})\]", RegexOptions.Compiled);

    private MarkupString LinkifyConsoleLine(string message)
    {
        if (string.IsNullOrEmpty(message))
        {
            return new MarkupString(string.Empty);
        }

        var matches = ConsoleNameWithSteamIdPattern.Matches(message);
        if (matches.Count == 0)
        {
            return new MarkupString(WebUtility.HtmlEncode(message));
        }

        var builder = new StringBuilder();
        var lastIndex = 0;

        foreach (Match match in matches)
        {
            builder.Append(WebUtility.HtmlEncode(message[lastIndex..match.Index]));

            var name = match.Groups["name"].Value;
            var steamId = match.Groups["id"].Value;
            builder.Append("<a href=\"").Append(WebUtility.HtmlEncode(PlayerHref(steamId))).Append("\">")
                   .Append(WebUtility.HtmlEncode(name))
                   .Append("</a>[").Append(steamId).Append(']');

            lastIndex = match.Index + match.Length;
        }

        builder.Append(WebUtility.HtmlEncode(message[lastIndex..]));

        return new MarkupString(builder.ToString());
    }

    private static string CountrySummary(InactivePlayerDto player)
    {
        if (string.IsNullOrEmpty(player.Country))
        {
            return "—";
        }

        return !string.IsNullOrEmpty(player.CountryCode)
            ? $"{player.Country} ({player.CountryCode})"
            : player.Country;
    }

    private string VpnStatus(bool? isVpn) => isVpn switch
    {
        true => Localizer["Yes"],
        false => Localizer["No"],
        null => "—"
    };

    // Every provider is currently a stub (see Infrastructure/Geolocation/Providers's remarks), so in
    // practice this always shows "—" today - written against the real shape now so nothing here needs
    // to change once a provider is actually wired up.
    private static string FormatHoursOnRecord(int? minutesPlayedForever) =>
        minutesPlayedForever.HasValue ? FormatDurationLong(TimeSpan.FromMinutes(minutesPlayedForever.Value)) : "—";

    // "00d, HH:mm:ss" - used for every duration-shaped column in the inactive-players table (hours on
    // server, hours on record, last session length) so they read consistently side by side.
    private static string FormatDurationLong(TimeSpan duration) =>
        $"{duration.Days:00}d, {duration.Hours:00}:{duration.Minutes:00}:{duration.Seconds:00}";

    // VictimSteamId/KillerSteamId being null means "NPC" (see KillFeedTextParser's remarks) - this
    // only cares about names for display, since the Players tab's job is showing what happened, not
    // re-deriving who's a player vs. an NPC (the Worker already filtered NPC-vs-NPC noise out before
    // publishing PlayerKilled at all).
    private string KillSummary(PlayerKillEventDto kill)
    {
        var weaponSuffix = string.IsNullOrEmpty(kill.Weapon) ? string.Empty : $" ({kill.Weapon})";

        if (string.IsNullOrEmpty(kill.KillerName))
        {
            // No killer identified means this came from the "died (reason)" shape, not "was killed
            // by" - confirmed live for a real player death ("CyberKnet[...] died (Fall)"), not just
            // NPCs. Weapon holds that reason here (see KillFeedTextParser's DiedPattern remarks), and
            // dropping it silently threw away the one piece of information the event actually has.
            return Localizer["{0} died{1}", kill.VictimName, weaponSuffix];
        }

        return Localizer["{0} was killed by {1}{2}", kill.VictimName, kill.KillerName, weaponSuffix];
    }

    private static string StatusBadgeClass(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "status-connected",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "status-pending",
        _ => "status-disconnected"
    };

    private static string StatusIcon(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "bi-check-circle-fill",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "bi-hourglass-split",
        RconConnectionStatus.Error => "bi-exclamation-triangle-fill",
        _ => "bi-x-circle-fill"
    };

    private string StatusText(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => Localizer["Connected"],
        RconConnectionStatus.Connecting => Localizer["Connecting"],
        RconConnectionStatus.Reconnecting => Localizer["Reconnecting"],
        RconConnectionStatus.Error => Localizer["Connection error"],
        _ => Localizer["Disconnected"]
    };

    // The Logs tab's badge for an entry with no RconConnectionStatus (a worker-side diagnostic, not a
    // connection-status transition) - same badge classes as Status*, keyed by ConnectionLogLevel
    // instead so a parse error or poll failure still reads at a glance as "something to look at"
    // without pretending to be a connection state it isn't.
    private static string LevelBadgeClass(ConnectionLogLevel level) => level switch
    {
        ConnectionLogLevel.Error => "status-disconnected",
        ConnectionLogLevel.Warning => "status-pending",
        _ => "status-info"
    };

    private static string LevelIcon(ConnectionLogLevel level) => level switch
    {
        ConnectionLogLevel.Error => "bi-exclamation-triangle-fill",
        ConnectionLogLevel.Warning => "bi-exclamation-circle-fill",
        _ => "bi-info-circle-fill"
    };

    private string LevelText(ConnectionLogLevel level) => level switch
    {
        ConnectionLogLevel.Error => Localizer["Error"],
        ConnectionLogLevel.Warning => Localizer["Warning"],
        _ => Localizer["Info"]
    };

    public async ValueTask DisposeAsync()
    {
        HubClient.EventReceived -= OnEventReceived;
        HubClient.StatusChanged -= OnStatusChanged;
        HubClient.LogEntryReceived -= OnLogEntryReceived;
        HubClient.PlayerConnected -= OnPlayerConnected;
        HubClient.PlayerDisconnected -= OnPlayerDisconnected;
        HubClient.PlayerGeolocated -= OnPlayerGeolocated;
        HubClient.PlayerKilled -= OnPlayerKilled;
        HubClient.ServerReportsChanged -= OnServerReportsChanged;
        await HubClient.DisposeAsync();

        try
        {
            await JS.InvokeVoidAsync("statsChart.destroyAll");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - nothing left to clean up client-side.
        }
    }

    private enum Tab { Console, Chat, Players, Stats, Logs, Control, Plugins, Combat, Bases, Positions, Map, Reports }
}
