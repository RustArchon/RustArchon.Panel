@page "/servers/{Id:guid}"
@using System.Linq
@using System.Net
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Messaging.Contracts
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IRustServerApiClient RustServerClient
@inject RconHubClient HubClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@rendermode RenderModes.NonPrerenderedServer
@implements IAsyncDisposable

<PageTitle>@(server?.Name ?? "Server") — RustArchon</PageTitle>

@if (loading)
{
    <p><em>Loading server...</em></p>
}
else if (server is null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Server not found, or it's not one of yours.
    </div>
    <a class="btn btn-outline-secondary" href="servers"><i class="bi bi-arrow-left"></i> Back to Servers</a>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <a href="servers" class="link-arrow d-inline-block mb-2"><i class="bi bi-arrow-left"></i> All Servers</a>
            <h1 class="mb-0">@server.Name</h1>
            <p class="text-muted mb-0">
                <code>@server.Host:@server.Port</code>
                @if (!string.IsNullOrEmpty(server.Description))
                {
                    <span> — @server.Description</span>
                }
            </p>
        </div>
        <span class="badge status-badge @StatusBadgeClass(status)">
            <i class="bi @StatusIcon(status)"></i> @StatusText(status)
        </span>
    </div>

    <ul class="nav nav-tabs console-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Console ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Console)">
                <i class="bi bi-terminal"></i> Console
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Chat ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Chat)">
                <i class="bi bi-chat-dots"></i> Chat
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Players ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Players)">
                <i class="bi bi-people"></i> Players
            </button>
        </li>
    </ul>

    <div class="console-pane">
        @if (activeTab == Tab.Console)
        {
            <div class="console-toolbar">
                <label>
                    Lines
                    <select class="form-select form-select-sm" @bind="consoleLineCount">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </label>
                <label>
                    From
                    <input type="datetime-local" class="form-control form-control-sm" @bind="consoleSince" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <label>
                    To
                    <input type="datetime-local" class="form-control form-control-sm" @bind="consoleUntil" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadConsoleHistoryAsync()" disabled="@loadingConsoleHistory">
                    <i class="bi bi-arrow-clockwise"></i> Load
                </button>
                @if (consoleFilterActive)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetConsoleFilterAsync" disabled="@loadingConsoleHistory">
                        <i class="bi bi-x-circle"></i> Reset to latest
                    </button>
                }
            </div>

            @if (consoleEvents.Count == 0)
            {
                <div class="console-empty">
                    <i class="bi bi-broadcast"></i>
                    <p>No console activity captured yet.</p>
                    <p class="text-muted small">Once this server's connection is live, every console
                    line will stream here in real time, and history will still be here the next time
                    you check back - even if nobody was watching when it happened.</p>
                </div>
            }
            else
            {
                <div class="console-log" @ref="consoleLogRef">
                    @foreach (var evt in consoleEvents)
                    {
                        <div class="console-line">
                            <span class="console-line-time">@evt.CapturedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span class="console-line-message">@LinkifyConsoleLine(evt.Message)</span>
                        </div>
                    }
                </div>
            }
            <div class="console-input">
                <input type="text" class="form-control" placeholder="Send a command..."
                       @bind="commandText" @bind:event="oninput" @onkeydown="OnCommandKeyDown"
                       disabled="@sendingCommand" />
                <button class="btn btn-primary" @onclick="SendCommandAsync" disabled="@(sendingCommand || string.IsNullOrWhiteSpace(commandText))">
                    Send
                </button>
            </div>
            @if (!string.IsNullOrEmpty(commandError))
            {
                <p class="text-danger small mt-2">@commandError</p>
            }
        }
        else if (activeTab == Tab.Chat)
        {
            <div class="console-toolbar">
                <label>
                    Lines
                    <select class="form-select form-select-sm" @bind="chatLineCount">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </label>
                <label>
                    From
                    <input type="datetime-local" class="form-control form-control-sm" @bind="chatSince" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <label>
                    To
                    <input type="datetime-local" class="form-control form-control-sm" @bind="chatUntil" @bind:format="yyyy-MM-ddTHH:mm" />
                </label>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadChatHistoryAsync()" disabled="@loadingChatHistory">
                    <i class="bi bi-arrow-clockwise"></i> Load
                </button>
                @if (chatFilterActive)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetChatFilterAsync" disabled="@loadingChatHistory">
                        <i class="bi bi-x-circle"></i> Reset to latest
                    </button>
                }
            </div>

            @if (chatEvents.Count == 0)
            {
                <div class="console-empty">
                    <i class="bi bi-chat-dots"></i>
                    <p>No chat activity captured yet.</p>
                    <p class="text-muted small">In-game chat will show up here once this server's
                    connection is live.</p>
                </div>
            }
            else
            {
                <div class="console-log" @ref="chatLogRef">
                    @foreach (var evt in chatEvents)
                    {
                        var chat = ParseChatMessage(evt.Message);
                        <div class="console-line">
                            <span class="console-line-time">@evt.CapturedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            @if (chat is not null)
                            {
                                <span class="console-line-message">
                                    @if (IsSteamId(chat.UserId))
                                    {
                                        <a class="chat-username" style="@ChatUsernameStyle(chat.Color)" href="@PlayerHref(chat.UserId!)">@chat.Username</a>
                                    }
                                    else
                                    {
                                        <span class="chat-username" style="@ChatUsernameStyle(chat.Color)">@chat.Username</span>
                                    }
                                    : @chat.Message
                                </span>
                            }
                            else
                            {
                                <span class="console-line-message">@evt.Message</span>
                            }
                        </div>
                    }
                </div>
            }
            <div class="console-input">
                <input type="text" class="form-control" placeholder="Send a chat message..."
                       @bind="chatText" @bind:event="oninput" @onkeydown="OnChatKeyDown"
                       disabled="@sendingChat" />
                <button class="btn btn-primary" @onclick="SendChatAsync" disabled="@(sendingChat || string.IsNullOrWhiteSpace(chatText))">
                    Send
                </button>
            </div>
            @if (!string.IsNullOrEmpty(chatError))
            {
                <p class="text-danger small mt-2">@chatError</p>
            }
        }
        else
        {
            <div class="players-columns">
                <div class="players-current">
                    <h2 class="h6 text-muted text-uppercase">Currently connected</h2>
                    @if (loadingPlayers)
                    {
                        <p><em>Loading players...</em></p>
                    }
                    else if (currentPlayers.Count == 0)
                    {
                        <div class="console-empty">
                            <i class="bi bi-people"></i>
                            <p>Nobody is connected right now.</p>
                            <p class="text-muted small">Players show up here the moment they join,
                            and drop off the moment they disconnect.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm player-table">
                                <thead>
                                    <tr>
                                        <th>Player</th>
                                        <th>Steam ID</th>
                                        <th>IP address</th>
                                        <th>Connected</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in currentPlayers)
                                    {
                                        <tr>
                                            <td><a href="@PlayerHref(p.SteamId)">@p.DisplayName</a></td>
                                            <td><code>@p.SteamId</code></td>
                                            <td><code>@p.IpAddress</code></td>
                                            <td>@FormatDuration(p.ConnectedAtUtc)</td>
                                            <td>@GeolocationSummary(p)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="players-kills">
                    <h2 class="h6 text-muted text-uppercase">Recent kills</h2>
                    @if (loadingKills)
                    {
                        <p><em>Loading kill history...</em></p>
                    }
                    else if (recentKills.Count == 0)
                    {
                        <div class="console-empty">
                            <i class="bi bi-crosshair"></i>
                            <p>No kills captured yet.</p>
                            <p class="text-muted small">Kills are detected heuristically from console
                            text, so this may miss some and shouldn't be treated as authoritative.</p>
                        </div>
                    }
                    else
                    {
                        <div class="console-log">
                            @foreach (var k in recentKills)
                            {
                                <div class="console-line">
                                    <span class="console-line-time">@k.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span class="console-line-message">@KillSummary(k)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="players-inactive">
                <h2 class="h6 text-muted text-uppercase">Inactive players</h2>
                @if (loadingInactivePlayers && inactivePlayers.Count == 0)
                {
                    <p><em>Loading player history...</em></p>
                }
                else if (inactivePlayers.Count == 0)
                {
                    <div class="console-empty">
                        <i class="bi bi-clock-history"></i>
                        <p>No player history yet.</p>
                        <p class="text-muted small">Everyone who has ever connected and since
                        disconnected will show up here, along with their playtime and account info.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm player-table">
                            <thead>
                                <tr>
                                    <th>Nickname</th>
                                    <th>Steam ID</th>
                                    <th>Country</th>
                                    <th>VAC Bans</th>
                                    <th>Game Bans</th>
                                    <th>Violations</th>
                                    <th>Hours on Record</th>
                                    <th>Hours on Server</th>
                                    <th>Last Ping</th>
                                    <th>Last Session</th>
                                    <th>IP Address</th>
                                    <th>VPN</th>
                                    <th>Last Connected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in inactivePlayers)
                                {
                                    <tr>
                                        <td><a href="@PlayerHref(p.SteamId)">@p.DisplayName</a></td>
                                        <td><code>@p.SteamId</code></td>
                                        <td>@CountrySummary(p)</td>
                                        <td class="@(p.NumberOfVacBans is > 0 ? "text-danger fw-semibold" : "")">@(p.VacBanned.HasValue ? p.NumberOfVacBans ?? 0 : (object)"—")</td>
                                        <td class="@(p.NumberOfGameBans is > 0 ? "text-danger fw-semibold" : "")">@(p.VacBanned.HasValue ? p.NumberOfGameBans ?? 0 : (object)"—")</td>
                                        <td>@(p.LastViolationLevel?.ToString("0.00") ?? "—")</td>
                                        <td>@FormatHoursOnRecord(p.SteamMinutesPlayedForever)</td>
                                        <td>@FormatDurationLong(p.HoursOnServer)</td>
                                        <td>@(p.LastPing.HasValue ? $"{p.LastPing}ms" : "—")</td>
                                        <td>@FormatDurationLong(p.LastConnectionDuration)</td>
                                        <td><code>@p.IpAddress</code></td>
                                        <td>@VpnStatus(p.IsVpn)</td>
                                        <td>@p.LastConnectedAtUtc.ToLocalTime().ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (inactivePlayers.Count < inactivePlayersTotalCount)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadInactivePlayersAsync(append: true)" disabled="@loadingInactivePlayers">
                            @(loadingInactivePlayers ? "Loading..." : $"Load more ({inactivePlayers.Count} of {inactivePlayersTotalCount})")
                        </button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    // Query string, not a URL fragment - a fragment never reaches the server at all (it's stripped
    // before the HTTP request is even made), so a hard refresh on e.g. "#players" can't restore
    // anything without extra client-side JS to read window.location.hash. A query string round-trips
    // through Blazor's own routing normally and SupplyParameterFromQuery reads it directly.
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private RustServerDto? server;
    private bool loading = true;
    private Tab activeTab = Tab.Console;
    private RconConnectionStatus status;
    private readonly List<RconEventDto> consoleEvents = new();
    private readonly List<RconEventDto> chatEvents = new();
    private string commandText = string.Empty;
    private bool sendingCommand;
    private string? commandError;
    private string chatText = string.Empty;
    private bool sendingChat;
    private string? chatError;

    // ---- Players tab ----
    private readonly List<PlayerSessionDto> currentPlayers = new();
    private readonly List<PlayerKillEventDto> recentKills = new();
    private bool loadingPlayers = true;
    private bool loadingKills = true;
    private const int MaxRecentKills = 50;

    private readonly List<InactivePlayerDto> inactivePlayers = new();
    private bool loadingInactivePlayers = true;
    private int inactivePlayersPageNumber;
    private int inactivePlayersTotalCount;
    private const int InactivePlayersPageSize = 50;

    // Frames whose Type matches this (case-insensitively) are chat lines, not generic console
    // output. Kept as the one bit of classification this page needs rather than waiting on the
    // reader-side layer the RconEvent.Type remarks defer full classification to - RustWebRconClient
    // already reports chat frames with this exact type string.
    private const string ChatFrameType = "Chat";

    // ---- History loading (line count + optional date/time range), independent per tab ----
    private ElementReference consoleLogRef;
    private ElementReference chatLogRef;
    private int consoleLineCount = 200;
    private int chatLineCount = 200;
    private DateTime? consoleSince;
    private DateTime? consoleUntil;
    private DateTime? chatSince;
    private DateTime? chatUntil;
    private bool consoleFilterActive;
    private bool chatFilterActive;
    private bool loadingConsoleHistory;
    private bool loadingChatHistory;

    // ---- Auto-scroll bookkeeping ----
    // Set (via a JS check of the pane's *current* scroll position) right before a new line is added
    // to the list that backs it, then consumed in OnAfterRenderAsync once that line has actually been
    // rendered - see consoleScroll.js's isNearBottom remarks for why the check has to happen before
    // the mutation, not after.
    private bool pendingConsoleScroll;
    private bool pendingChatScroll;
    private bool initialScrollDone;

    // Runs after OnInitializedAsync on the very first pass, and again every time the query string
    // changes (including from our own NavigateTo calls in SwitchTabAsync) - the URL is the single
    // source of truth for which tab is active, not just the seed for the first render.
    protected override void OnParametersSet()
    {
        activeTab = TabQuery switch
        {
            "chat" => Tab.Chat,
            "players" => Tab.Players,
            _ => Tab.Console
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            server = await RustServerClient.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            server = null;
        }

        if (server is not null)
        {
            status = server.ConnectionStatus;

            await LoadConsoleHistoryAsync(resetScroll: false);
            await LoadChatHistoryAsync(resetScroll: false);
            await LoadPlayersAsync();
            await LoadKillsAsync();
            await LoadInactivePlayersAsync();

            HubClient.EventReceived += OnEventReceived;
            HubClient.StatusChanged += OnStatusChanged;
            HubClient.PlayerConnected += OnPlayerConnected;
            HubClient.PlayerDisconnected += OnPlayerDisconnected;
            HubClient.PlayerGeolocated += OnPlayerGeolocated;
            HubClient.PlayerKilled += OnPlayerKilled;
            await HubClient.ConnectAsync(Id);
        }

        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && !initialScrollDone)
        {
            initialScrollDone = true;
            await ScrollActiveTabToBottomAsync();
        }

        if (pendingConsoleScroll)
        {
            pendingConsoleScroll = false;
            // The .console-log div (and consoleLogRef with it) only exists in the DOM once
            // consoleEvents is non-empty - the empty-state placeholder renders in its place
            // otherwise. Invoking JS interop against an ElementReference that was never actually
            // bound to a rendered element throws and takes the whole circuit down with it.
            if (activeTab == Tab.Console && consoleEvents.Count > 0)
            {
                await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", consoleLogRef);
            }
        }

        if (pendingChatScroll)
        {
            pendingChatScroll = false;
            if (activeTab == Tab.Chat && chatEvents.Count > 0)
            {
                await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", chatLogRef);
            }
        }
    }

    private async Task ScrollActiveTabToBottomAsync()
    {
        if (activeTab == Tab.Console && consoleEvents.Count > 0)
        {
            await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", consoleLogRef);
        }
        else if (activeTab == Tab.Chat && chatEvents.Count > 0)
        {
            await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", chatLogRef);
        }
    }

    private async Task SwitchTabAsync(Tab tab)
    {
        if (activeTab == tab)
        {
            return;
        }

        activeTab = tab;

        // The newly-active tab's log wasn't in the DOM a moment ago (its @if block wasn't rendering),
        // so there's no "previous scroll position" to preserve - always land at the bottom, same as
        // the very first load.
        if (tab == Tab.Console)
        {
            pendingConsoleScroll = true;
        }
        else if (tab == Tab.Chat)
        {
            pendingChatScroll = true;
        }

        // Keeps the URL in sync so a refresh (or a shared/bookmarked link) lands back on this tab -
        // replace: true so tab-switching doesn't pile up browser-history entries. Omitted entirely for
        // Console (the default) so the plain "/servers/{id}" URL stays the common case. This also
        // re-fires OnParametersSet with the same tab we just set directly above - a harmless,
        // idempotent confirmation, not a fight over which value wins.
        var tabQueryValue = tab switch { Tab.Chat => "chat", Tab.Players => "players", _ => null };
        var newUri = tabQueryValue is null ? $"servers/{Id}" : $"servers/{Id}?tab={tabQueryValue}";
        NavigationManager.NavigateTo(newUri, replace: true);

        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task LoadConsoleHistoryAsync(bool resetScroll = true)
    {
        loadingConsoleHistory = true;
        StateHasChanged();

        try
        {
            var since = ToServerLocalUtc(consoleSince);
            var until = ToServerLocalUtc(consoleUntil);
            var history = await RustServerClient.GetEventsAsync(
                Id, pageNumber: 1, pageSize: consoleLineCount, isChat: false, since: since, until: until);

            consoleEvents.Clear();
            // Newest-first from the API - reverse for a natural top-to-bottom reading order.
            consoleEvents.AddRange(history.Items.Reverse());
            consoleFilterActive = since.HasValue || until.HasValue;
        }
        catch (Exception)
        {
            // A failed (re)load leaves whatever was already on screen in place rather than blanking it.
        }
        finally
        {
            loadingConsoleHistory = false;
        }

        if (resetScroll)
        {
            pendingConsoleScroll = true;
        }

        StateHasChanged();
    }

    private async Task LoadChatHistoryAsync(bool resetScroll = true)
    {
        loadingChatHistory = true;
        StateHasChanged();

        try
        {
            var since = ToServerLocalUtc(chatSince);
            var until = ToServerLocalUtc(chatUntil);
            var history = await RustServerClient.GetEventsAsync(
                Id, pageNumber: 1, pageSize: chatLineCount, isChat: true, since: since, until: until);

            chatEvents.Clear();
            chatEvents.AddRange(history.Items.Reverse());
            chatFilterActive = since.HasValue || until.HasValue;
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingChatHistory = false;
        }

        if (resetScroll)
        {
            pendingChatScroll = true;
        }

        StateHasChanged();
    }

    private async Task LoadPlayersAsync()
    {
        loadingPlayers = true;
        StateHasChanged();

        try
        {
            var players = await RustServerClient.GetCurrentPlayersAsync(Id);
            currentPlayers.Clear();
            currentPlayers.AddRange(players.OrderBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync - leave whatever was already on screen alone.
        }
        finally
        {
            loadingPlayers = false;
        }

        StateHasChanged();
    }

    private async Task LoadKillsAsync()
    {
        loadingKills = true;
        StateHasChanged();

        try
        {
            // Newest-first from the API - kept that way here, unlike the console/chat logs, since
            // this reads as a "recent activity" feed rather than a transcript meant to be read
            // top-to-bottom.
            var history = await RustServerClient.GetKillsAsync(Id, pageNumber: 1, pageSize: MaxRecentKills);
            recentKills.Clear();
            recentKills.AddRange(history.Items);
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingKills = false;
        }

        StateHasChanged();
    }

    private async Task LoadInactivePlayersAsync(bool append = false)
    {
        loadingInactivePlayers = true;
        StateHasChanged();

        try
        {
            var pageNumber = append ? inactivePlayersPageNumber + 1 : 1;
            var result = await RustServerClient.GetInactivePlayersAsync(Id, pageNumber, InactivePlayersPageSize);

            if (!append)
            {
                inactivePlayers.Clear();
            }

            inactivePlayers.AddRange(result.Items);
            inactivePlayersPageNumber = result.PageNumber;
            inactivePlayersTotalCount = result.TotalCount;
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingInactivePlayers = false;
        }

        StateHasChanged();
    }

    private void OnPlayerConnected(PlayerSessionDto dto)
    {
        InvokeAsync(() =>
        {
            // Poll-and-diff detection (see ServerConnectionActor's remarks) can in principle re-report
            // a session that's already tracked - de-dupe by Id rather than assuming exactly one
            // PlayerConnected per player.
            if (currentPlayers.All(p => p.Id != dto.Id))
            {
                currentPlayers.Add(dto);
                currentPlayers.Sort((a, b) => string.Compare(a.DisplayName, b.DisplayName, StringComparison.OrdinalIgnoreCase));
            }

            StateHasChanged();
        });
    }

    private void OnPlayerDisconnected(string steamId)
    {
        InvokeAsync(() =>
        {
            currentPlayers.RemoveAll(p => p.SteamId == steamId);
            StateHasChanged();
        });
    }

    private void OnPlayerGeolocated(PlayerSessionDto dto)
    {
        InvokeAsync(() =>
        {
            var index = currentPlayers.FindIndex(p => p.Id == dto.Id);
            if (index >= 0)
            {
                currentPlayers[index] = dto;
            }

            StateHasChanged();
        });
    }

    private void OnPlayerKilled(PlayerKillEventDto dto)
    {
        InvokeAsync(() =>
        {
            recentKills.Insert(0, dto);
            if (recentKills.Count > MaxRecentKills)
            {
                recentKills.RemoveRange(MaxRecentKills, recentKills.Count - MaxRecentKills);
            }

            StateHasChanged();
        });
    }

    private Task ResetConsoleFilterAsync()
    {
        consoleSince = null;
        consoleUntil = null;
        return LoadConsoleHistoryAsync();
    }

    private Task ResetChatFilterAsync()
    {
        chatSince = null;
        chatUntil = null;
        return LoadChatHistoryAsync();
    }

    // <input type="datetime-local"> gives a plain wall-clock value with no offset - interpreted here
    // as the server's own local time zone, matching how CapturedAtUtc is already displayed elsewhere
    // on this page (.ToLocalTime(), which for a Blazor Server app means the server's zone, not the
    // viewer's browser). Good enough for "show me roughly what happened around this time" filtering.
    private static DateTimeOffset? ToServerLocalUtc(DateTime? localValue) =>
        localValue.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(localValue.Value, DateTimeKind.Local)).ToUniversalTime()
            : null;

    private void Classify(RconEventDto evt)
    {
        if (string.Equals(evt.Type, ChatFrameType, StringComparison.OrdinalIgnoreCase))
        {
            chatEvents.Add(evt);
        }
        else
        {
            consoleEvents.Add(evt);
        }
    }

    private void OnEventReceived(RconEventDto evt)
    {
        var isChat = string.Equals(evt.Type, ChatFrameType, StringComparison.OrdinalIgnoreCase);

        InvokeAsync(async () =>
        {
            // Only worth asking "is the pane already scrolled to the bottom" when that pane is the
            // one currently on screen - the other tab's log isn't in the DOM at all right now, so
            // there's nothing to check (it gets its own scroll-to-bottom when the user switches to
            // it). And only when its log div actually exists yet - an empty list renders the
            // empty-state placeholder instead, leaving consoleLogRef/chatLogRef unbound; invoking JS
            // interop against an unbound ElementReference throws. This new event is about to become
            // that list's very first item, so there's nothing to be "not at the bottom of" anyway.
            if (isChat && activeTab == Tab.Chat)
            {
                pendingChatScroll = chatEvents.Count == 0
                    || await JS.InvokeAsync<bool>("consoleScroll.isNearBottom", chatLogRef);
            }
            else if (!isChat && activeTab == Tab.Console)
            {
                pendingConsoleScroll = consoleEvents.Count == 0
                    || await JS.InvokeAsync<bool>("consoleScroll.isNearBottom", consoleLogRef);
            }

            Classify(evt);
            StateHasChanged();
        });
    }

    private void OnStatusChanged(Guid serverId, RconConnectionStatus newStatus, string? detail)
    {
        if (serverId != Id)
        {
            return;
        }

        InvokeAsync(() =>
        {
            status = newStatus;
            StateHasChanged();
        });
    }

    private async Task OnCommandKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommandAsync();
        }
    }

    private async Task SendCommandAsync()
    {
        if (string.IsNullOrWhiteSpace(commandText) || sendingCommand)
        {
            return;
        }

        sendingCommand = true;
        commandError = null;
        var command = commandText;
        commandText = string.Empty;

        try
        {
            var result = await RustServerClient.SendCommandAsync(Id, new SendCommandRequest { Command = command });
            if (!result.Success)
            {
                commandError = result.Error switch
                {
                    "NotConnected" => "This server isn't connected right now - the command wasn't sent.",
                    _ => result.Error ?? "The command failed."
                };
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            commandError = "No worker responded in time - this server may not have an active connection.";
        }
        catch (Exception)
        {
            commandError = "Something went wrong sending that command.";
        }
        finally
        {
            sendingCommand = false;
        }
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendChatAsync();
        }
    }

    private async Task SendChatAsync()
    {
        if (string.IsNullOrWhiteSpace(chatText) || sendingChat)
        {
            return;
        }

        sendingChat = true;
        chatError = null;
        var message = chatText;
        chatText = string.Empty;

        try
        {
            // Rust's own console command for broadcasting to every player's in-game chat - there's no
            // separate "chat" RCON verb, so this rides the exact same command channel/endpoint the
            // Console tab uses. The server echoes it back as its own Chat-typed frame, so it'll appear
            // in this list via the live tail rather than being added optimistically here.
            var result = await RustServerClient.SendCommandAsync(Id, new SendCommandRequest { Command = BuildSayCommand(message) });
            if (!result.Success)
            {
                chatError = result.Error switch
                {
                    "NotConnected" => "This server isn't connected right now - the message wasn't sent.",
                    _ => result.Error ?? "The message failed to send."
                };
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            chatError = "No worker responded in time - this server may not have an active connection.";
        }
        catch (Exception)
        {
            chatError = "Something went wrong sending that message.";
        }
        finally
        {
            sendingChat = false;
        }
    }

    // Rust's WebRCON reports an unsolicited chat frame's Type as "Chat" and its Message as a
    // JSON-encoded object (Username/Message/Color/...), not plain text - this is the protocol's own
    // wire format (vanilla Rust, not a Carbon/Oxide quirk), and RustArchon's capture pipeline
    // (RustArchon.Worker's ServerConnectionActor) stores every frame's Message verbatim by design,
    // deferring exactly this kind of parsing to a reader-side layer - see RconEvent's remarks.
    // RustArchon.Rcon already has a ChatParser/ChatMessage pair for this shape, but it's built for
    // chat.tail's *array* response, not a single live frame's bare object - rather than pull that
    // library in here (this project only ever reaches RustArchon entities through DTOs/API clients,
    // never their lower-level implementation types) and adapt it for a shape it wasn't built for,
    // this is a small, display-only parse: falls back to the raw text on anything that doesn't match,
    // so an unexpected shape (or a genuinely plain-text "Chat" frame from some other setup) still
    // shows something instead of an empty line.
    private static readonly JsonSerializerOptions ChatPayloadJsonOptions = new() { PropertyNameCaseInsensitive = true };

    private sealed class ChatPayload
    {
        public string Username { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string? Color { get; set; }

        /// <summary>The chatter's Steam64 ID - Rust's own chat frame includes this alongside
        /// Username/Message/Color, confirmed live. Powers the username link to their player detail
        /// page; left null/unlinked for anything that doesn't look like a real Steam64 ID (see
        /// KillFeedTextParser's AsSteamId remarks for the same 17-digit heuristic).</summary>
        public string? UserId { get; set; }
    }

    private static ChatPayload? ParseChatMessage(string rawMessage)
    {
        try
        {
            var payload = JsonSerializer.Deserialize<ChatPayload>(rawMessage, ChatPayloadJsonOptions);
            return !string.IsNullOrEmpty(payload?.Username) ? payload : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    // Rust reports colors as plain hex ("#eeeeee") or a handful of named values - allowlisting the
    // shape before it lands in a style attribute is cheap insurance against a malformed/unexpected
    // value breaking the CSS declaration, not a defense against HTML injection (Blazor already
    // HTML-encodes attribute values regardless).
    private static string ChatUsernameStyle(string? color) =>
        !string.IsNullOrWhiteSpace(color) && System.Text.RegularExpressions.Regex.IsMatch(color, "^#?[0-9a-zA-Z]{1,10}$")
            ? $"color: {color};"
            : string.Empty;

    // Rust's "say" console command takes the rest of the line as the message verbatim - it does not
    // treat quotes as argument delimiters. Wrapping the message in quotes (an earlier version of this
    // method did) doesn't protect anything; it just makes the quote characters part of what gets
    // spoken, confirmed live: sending `say "hello"` broadcasts the literal text `"hello"`, quotes and
    // all. So this is intentionally a bare passthrough, not an escaping no-op.
    private static string BuildSayCommand(string message) => $"say {message}";

    private static string FormatDuration(DateTimeOffset connectedAtUtc)
    {
        var elapsed = DateTimeOffset.UtcNow - connectedAtUtc;
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m"
            : $"{Math.Max(0, (int)elapsed.TotalMinutes)}m";
    }

    // Every IGeolocationProvider is currently a stub that always returns null (see the Providers/
    // remarks), so in practice this always falls through to "—" today - it's written against the
    // real shape now so nothing here needs to change once a provider is actually wired up.
    private static string GeolocationSummary(PlayerSessionDto player)
    {
        if (string.IsNullOrEmpty(player.GeolocationCountry))
        {
            return "—";
        }

        var label = !string.IsNullOrEmpty(player.GeolocationCountryCode)
            ? $"{player.GeolocationCountry} ({player.GeolocationCountryCode})"
            : player.GeolocationCountry;

        var flags = new List<string>();
        if (player.GeolocationIsVpn == true)
        {
            flags.Add("VPN");
        }
        if (player.GeolocationIsProxy == true)
        {
            flags.Add("Proxy");
        }

        return flags.Count > 0 ? $"{label} — {string.Join(", ", flags)}" : label!;
    }

    private string PlayerHref(string steamId) => $"servers/{Id}/players/{steamId}";

    // Same 17-digit heuristic as KillFeedTextParser.AsSteamId - an NPC's network/entity ID never gets
    // remotely close to that length, so this reliably tells a real player apart from one without
    // needing to know anything about where the value came from.
    private static bool IsSteamId(string? value) => value is { Length: 17 } && value.All(char.IsDigit);

    // Finds every "<name>[<17-digit-steamid>]" occurrence in a raw console line (the shape used by
    // kill lines, "has spawned", etc. - see KillFeedTextParser's remarks) and turns just the name
    // portion into a link to that player's detail page, leaving the rest of the line as plain text.
    // Deliberately narrow rather than an attempt at universal name detection - lines that don't
    // happen to carry a bracketed Steam64 ID (e.g. the "ip:port/steamid/name joined" shape) simply
    // stay unlinked, same as they'd read today.
    private static readonly Regex ConsoleNameWithSteamIdPattern = new(@"(?<name>[^\[\]\r\n]+?)\[(?<id>\d{17})\]", RegexOptions.Compiled);

    private MarkupString LinkifyConsoleLine(string message)
    {
        if (string.IsNullOrEmpty(message))
        {
            return new MarkupString(string.Empty);
        }

        var matches = ConsoleNameWithSteamIdPattern.Matches(message);
        if (matches.Count == 0)
        {
            return new MarkupString(WebUtility.HtmlEncode(message));
        }

        var builder = new StringBuilder();
        var lastIndex = 0;

        foreach (Match match in matches)
        {
            builder.Append(WebUtility.HtmlEncode(message[lastIndex..match.Index]));

            var name = match.Groups["name"].Value;
            var steamId = match.Groups["id"].Value;
            builder.Append("<a href=\"").Append(WebUtility.HtmlEncode(PlayerHref(steamId))).Append("\">")
                   .Append(WebUtility.HtmlEncode(name))
                   .Append("</a>[").Append(steamId).Append(']');

            lastIndex = match.Index + match.Length;
        }

        builder.Append(WebUtility.HtmlEncode(message[lastIndex..]));

        return new MarkupString(builder.ToString());
    }

    private static string CountrySummary(InactivePlayerDto player)
    {
        if (string.IsNullOrEmpty(player.Country))
        {
            return "—";
        }

        return !string.IsNullOrEmpty(player.CountryCode)
            ? $"{player.Country} ({player.CountryCode})"
            : player.Country;
    }

    private static string VpnStatus(bool? isVpn) => isVpn switch
    {
        true => "Yes",
        false => "No",
        null => "—"
    };

    // Every provider is currently a stub (see Infrastructure/Geolocation/Providers's remarks), so in
    // practice this always shows "—" today - written against the real shape now so nothing here needs
    // to change once a provider is actually wired up.
    private static string FormatHoursOnRecord(int? minutesPlayedForever) =>
        minutesPlayedForever.HasValue ? FormatDurationLong(TimeSpan.FromMinutes(minutesPlayedForever.Value)) : "—";

    // "00d, HH:mm:ss" - used for every duration-shaped column in the inactive-players table (hours on
    // server, hours on record, last session length) so they read consistently side by side.
    private static string FormatDurationLong(TimeSpan duration) =>
        $"{duration.Days:00}d, {duration.Hours:00}:{duration.Minutes:00}:{duration.Seconds:00}";

    // VictimSteamId/KillerSteamId being null means "NPC" (see KillFeedTextParser's remarks) - this
    // only cares about names for display, since the Players tab's job is showing what happened, not
    // re-deriving who's a player vs. an NPC (the Worker already filtered NPC-vs-NPC noise out before
    // publishing PlayerKilled at all).
    private static string KillSummary(PlayerKillEventDto kill)
    {
        var weaponSuffix = string.IsNullOrEmpty(kill.Weapon) ? string.Empty : $" ({kill.Weapon})";

        if (string.IsNullOrEmpty(kill.KillerName))
        {
            // No killer identified means this came from the "died (reason)" shape, not "was killed
            // by" - confirmed live for a real player death ("CyberKnet[...] died (Fall)"), not just
            // NPCs. Weapon holds that reason here (see KillFeedTextParser's DiedPattern remarks), and
            // dropping it silently threw away the one piece of information the event actually has.
            return $"{kill.VictimName} died{weaponSuffix}";
        }

        return $"{kill.VictimName} was killed by {kill.KillerName}{weaponSuffix}";
    }

    private static string StatusBadgeClass(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "status-connected",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "status-pending",
        _ => "status-disconnected"
    };

    private static string StatusIcon(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "bi-check-circle-fill",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "bi-hourglass-split",
        RconConnectionStatus.Error => "bi-exclamation-triangle-fill",
        _ => "bi-x-circle-fill"
    };

    private static string StatusText(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "Connected",
        RconConnectionStatus.Connecting => "Connecting",
        RconConnectionStatus.Reconnecting => "Reconnecting",
        RconConnectionStatus.Error => "Connection error",
        _ => "Disconnected"
    };

    public async ValueTask DisposeAsync()
    {
        HubClient.EventReceived -= OnEventReceived;
        HubClient.StatusChanged -= OnStatusChanged;
        HubClient.PlayerConnected -= OnPlayerConnected;
        HubClient.PlayerDisconnected -= OnPlayerDisconnected;
        HubClient.PlayerGeolocated -= OnPlayerGeolocated;
        HubClient.PlayerKilled -= OnPlayerKilled;
        await HubClient.DisposeAsync();
    }

    private enum Tab { Console, Chat, Players }
}
