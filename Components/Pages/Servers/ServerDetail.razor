    private bool chatFilterActive;
    private bool loadingConsoleHistory;
    private bool loadingChatHistory;

    // ---- Console tab: site-admin-only unfiltered view ----
    // Whether the current session is a site admin acting as this server's tenant - see
    // IsActingAsTenant's remarks. Gates whether the toggle below is even shown; the actual
    // enforcement lives server-side (RustServersController.GetEvents, RconHub.JoinUnfilteredServerGroup),
    // both of which re-derive this same fact from the token independently rather than trusting this
    // field or the query/hub calls it drives.
    private bool isActingAsTenant;

    // When true, LoadConsoleHistoryAsync requests (and RconHubClient is joined to receive) background
    // events too, not just interactive ones - see OnUnfilteredConsoleToggledAsync.
    private bool unfilteredConsole;

    // ---- Auto-scroll bookkeeping ----
    // Set (via a JS check of the pane's *current* scroll position) right before a new line is added
    // to the list that backs it, then consumed in OnAfterRenderAsync once that line has actually been
    // rendered - see consoleScroll.js's isNearBottom remarks for why the check has to happen before
    // the mutation, not after.
    private bool pendingConsoleScroll;
    private bool pendingChatScroll;
    private bool pendingLogsScroll;
    private bool initialScrollDone;

    // Runs after OnInitializedAsync on the very first pass, and again every time the query string
    // changes (including from our own NavigateTo calls in SwitchTabAsync) - the URL is the single
    // source of truth for which tab is active, not just the seed for the first render.
    protected override void OnParametersSet()
    {
        activeTab = TabQuery switch
        {
            "chat" => Tab.Chat,
            "players" => Tab.Players,
            "stats" => Tab.Stats,
            "logs" => Tab.Logs,
            "plugins" => Tab.Plugins,
            "combat" => Tab.Combat,
            "bases" => Tab.Bases,
            "positions" => Tab.Positions,
            "map" => Tab.Map,
            "reports" => Tab.Reports,
            "control" => Tab.Control,
            _ => Tab.Console
        };
    }

    protected override async Task OnInitializedAsync()
    {
        siteName = (await Branding.GetAsync()).SiteName;

        try
        {
            server = await RustServerClient.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            server = null;
        }

        if (server is not null)
        {
            status = server.ConnectionStatus;
            isActingAsTenant = IsActingAsTenant();

            await LoadConsoleHistoryAsync(resetScroll: false);
            await LoadChatHistoryAsync(resetScroll: false);
            await LoadPlayersAsync();
            await LoadKillsAsync();
            await LoadInactivePlayersAsync();
            await LoadServerInfoHistoryAsync();
            await LoadConnectionLogAsync();
            await LoadPluginsAsync();

            // activeTab is set from the URL only AFTER this method finishes (OnParametersSet runs later), so ask the query itself.
            if (string.Equals(TabQuery, "combat", StringComparison.OrdinalIgnoreCase))
            {
                await LoadCombatAsync();
            }
            else if (string.Equals(TabQuery, "bases", StringComparison.OrdinalIgnoreCase))
            {
                await LoadBasesAsync();
            }
            else if (string.Equals(TabQuery, "positions", StringComparison.OrdinalIgnoreCase))
            {
                await LoadPositionsAsync();
            }

            // Not awaited, same reasoning as LoadLiveServerInfoAsync below - global.banlistex is a live
            // RCON round-trip, not a local DB query like the other Players-tab loads above, so awaiting
            // it here would hold up the whole page's "loading" state on a fetch only the ban list needs.
            _ = LoadBanListAsync();

            // Not awaited either: it only feeds the Reports tab's badge, and a caller without RustServer.ViewReports just gets a
            // 403 that leaves the badge off.
            _ = LoadReportCountAsync();

            if (activeTab == Tab.Stats)
            {
                pendingStatsChartRender = true;
            }

            // Deliberately not awaited, unlike every other eager load above - serverinfo is a live RCON
            // round-trip (confirmed live: 8+ seconds against a real server, not a local DB query like
            // the others), so awaiting it here would hold up the *entire* page's "loading" state - every
            // tab, not just Stats - on a fetch only the Stats tab needs. Its own StateHasChanged() call
            // still safely updates the UI once it completes: unlike OnPlayerConnected and friends, this
            // task is started from (and its continuations resume on) this component's own captured
            // synchronization context, not an arbitrary SignalR callback thread, so it doesn't need
            // InvokeAsync to get back onto it.
            _ = LoadLiveServerInfoAsync();

            HubClient.EventReceived += OnEventReceived;
            HubClient.StatusChanged += OnStatusChanged;
            HubClient.LogEntryReceived += OnLogEntryReceived;
            HubClient.PlayerConnected += OnPlayerConnected;
            HubClient.PlayerDisconnected += OnPlayerDisconnected;
            HubClient.PlayerGeolocated += OnPlayerGeolocated;
            HubClient.PlayerKilled += OnPlayerKilled;
            HubClient.ServerReportsChanged += OnServerReportsChanged;
            await HubClient.ConnectAsync(Id);
        }

        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && !initialScrollDone)
        {
            initialScrollDone = true;
            await ScrollActiveTabToBottomAsync();
        }

        if (pendingConsoleScroll)
        {
            pendingConsoleScroll = false;
            // The .console-log div (and consoleLogRef with it) only exists in the DOM once
            // consoleEvents is non-empty - the empty-state placeholder renders in its place
            // otherwise. Invoking JS interop against an ElementReference that was never actually
            // bound to a rendered element throws and takes the whole circuit down with it.
            if (activeTab == Tab.Console && consoleEvents.Count > 0)
            {
                await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", consoleLogRef);
            }
        }

        if (pendingChatScroll)
        {
            pendingChatScroll = false;
            if (activeTab == Tab.Chat && chatEvents.Count > 0)
            {
                await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", chatLogRef);
            }
        }

        if (pendingLogsScroll)
        {
            pendingLogsScroll = false;
            if (activeTab == Tab.Logs && connectionLog.Count > 0)
            {
                await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", logsLogRef);
            }
        }

        if (pendingStatsChartRender && activeTab == Tab.Stats && serverInfoHistory.Count > 0)
        {
            pendingStatsChartRender = false;
            await RenderStatsChartsAsync();
        }
    }

    private async Task ScrollActiveTabToBottomAsync()
    {
        if (activeTab == Tab.Console && consoleEvents.Count > 0)
        {
            await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", consoleLogRef);
        }
        else if (activeTab == Tab.Chat && chatEvents.Count > 0)
        {
            await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", chatLogRef);
        }
        else if (activeTab == Tab.Logs && connectionLog.Count > 0)
        {
            await JS.InvokeVoidAsync("consoleScroll.scrollToBottom", logsLogRef);
        }
    }

    private async Task SwitchTabAsync(Tab tab)
    {
        if (activeTab == tab)
        {
            return;
        }

        activeTab = tab;

        // The newly-active tab's log wasn't in the DOM a moment ago (its @if block wasn't rendering),
        // so there's no "previous scroll position" to preserve - always land at the bottom, same as
        // the very first load.
        if (tab == Tab.Console)
        {
            pendingConsoleScroll = true;
        }
        else if (tab == Tab.Chat)
        {
            pendingChatScroll = true;
        }
        else if (tab == Tab.Logs)
        {
            pendingLogsScroll = true;
        }

        // Keeps the URL in sync so a refresh (or a shared/bookmarked link) lands back on this tab -
        // replace: true so tab-switching doesn't pile up browser-history entries. Omitted entirely for
        // Console (the default) so the plain "/servers/{id}" URL stays the common case. This also
        // re-fires OnParametersSet with the same tab we just set directly above - a harmless,
        // idempotent confirmation, not a fight over which value wins.
        var tabQueryValue = tab switch { Tab.Chat => "chat", Tab.Players => "players", Tab.Stats => "stats", Tab.Logs => "logs", Tab.Plugins => "plugins", Tab.Combat => "combat", Tab.Bases => "bases", Tab.Positions => "positions", Tab.Map => "map", Tab.Reports => "reports", Tab.Control => "control", _ => null };
        var newUri = tabQueryValue is null ? $"servers/{Id}" : $"servers/{Id}?tab={tabQueryValue}";
        NavigationManager.NavigateTo(newUri, replace: true);

        // The Stats tab's <canvas> elements don't exist in the DOM until this @if block renders (same
        // reasoning as pendingConsoleScroll/pendingChatScroll above) - and even if they did on a
        // previous visit, switching away and back tears down and recreates them, orphaning whatever
        // Chart.js instance was attached to the old ones. So charts always need a fresh render on
        // every switch *to* Stats, not just the first time data loads.
        if (tab == Tab.Stats)
        {
            pendingStatsChartRender = true;
        }

        StateHasChanged();

        if (tab == Tab.Combat)
        {
            await LoadCombatAsync();
        }
        else if (tab == Tab.Bases)
        {
            await LoadBasesAsync();
        }
        else if (tab == Tab.Positions)
        {
            await LoadPositionsAsync();
        }
    }

    private async Task LoadConsoleHistoryAsync(bool resetScroll = true)
    {
        loadingConsoleHistory = true;
        StateHasChanged();

        try
        {
            var since = ToServerLocalUtc(consoleSince);
            var until = ToServerLocalUtc(consoleUntil);
            var history = await RustServerClient.GetEventsAsync(
                Id, pageNumber: 1, pageSize: consoleLineCount, isChat: false, since: since, until: until,
                includeNonInteractive: unfilteredConsole);

            consoleEvents.Clear();
            // Newest-first from the API - reverse for a natural top-to-bottom reading order.
            consoleEvents.AddRange(history.Items.Reverse());
            consoleFilterActive = since.HasValue || until.HasValue;
        }
        catch (Exception)
        {
            // A failed (re)load leaves whatever was already on screen in place rather than blanking it.
        }
        finally
        {
            loadingConsoleHistory = false;
        }

        if (resetScroll)
        {
            pendingConsoleScroll = true;
        }

        StateHasChanged();
    }

    private async Task LoadChatHistoryAsync(bool resetScroll = true)
    {
        loadingChatHistory = true;
        StateHasChanged();

        try
        {
            var since = ToServerLocalUtc(chatSince);
            var until = ToServerLocalUtc(chatUntil);
            var history = await RustServerClient.GetEventsAsync(
                Id, pageNumber: 1, pageSize: chatLineCount, isChat: true, since: since, until: until);

            chatEvents.Clear();
            chatEvents.AddRange(history.Items.Reverse());
            chatFilterActive = since.HasValue || until.HasValue;
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingChatHistory = false;
        }

        if (resetScroll)
        {
            pendingChatScroll = true;
        }

        StateHasChanged();
    }

    private async Task LoadPlayersAsync()
    {
        loadingPlayers = true;
        StateHasChanged();

        try
        {
            var players = await RustServerClient.GetCurrentPlayersAsync(Id);
            currentPlayers.Clear();
            currentPlayers.AddRange(players.OrderBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync - leave whatever was already on screen alone.
        }
        finally
        {
            loadingPlayers = false;
        }

        StateHasChanged();
    }

    private async Task LoadKillsAsync()
    {
        loadingKills = true;
        StateHasChanged();

        try
        {
            // Newest-first from the API - kept that way here, unlike the console/chat logs, since
            // this reads as a "recent activity" feed rather than a transcript meant to be read
            // top-to-bottom.
            var history = await RustServerClient.GetKillsAsync(Id, pageNumber: 1, pageSize: MaxRecentKills);
            recentKills.Clear();
            recentKills.AddRange(history.Items);
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingKills = false;
        }

        StateHasChanged();
    }

    private async Task LoadInactivePlayersAsync(bool append = false)
    {
        loadingInactivePlayers = true;
        StateHasChanged();

        try
        {
            var pageNumber = append ? inactivePlayersPageNumber + 1 : 1;
            var result = await RustServerClient.GetInactivePlayersAsync(Id, pageNumber, InactivePlayersPageSize);

            if (!append)
            {
                inactivePlayers.Clear();
            }

            inactivePlayers.AddRange(result.Items);
            inactivePlayersPageNumber = result.PageNumber;
            inactivePlayersTotalCount = result.TotalCount;
        }
        catch (Exception)
        {
            // Same reasoning as LoadConsoleHistoryAsync.
        }
        finally
        {
            loadingInactivePlayers = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Fetches and parses the server-wide ban list via <c>global.banlistex</c> - a plain space +
    /// quoted-field text table, not JSON (confirmed by watching a real third-party RCON client's
    /// actual traffic through RustArchon.RconEmulator): one line per ban, shaped
    /// <c>&lt;#&gt; &lt;steamid&gt; "&lt;name&gt;" "&lt;reason&gt;" &lt;expiry&gt;</c>, where expiry is
    /// <c>-1</c> for a permanent ban.
    /// </summary>
    private async Task LoadBanListAsync()
    {
        loadingBanList = true;
        banListError = null;
        StateHasChanged();

        try
        {
            // Interactive: false - this fires automatically on every page load, never because a user
            // asked for it (see this method's own doc remarks) - the exact shape of the bug
            // RconCommandContext exists to prevent. Must never show up in the Console tab.
            var result = await RustServerClient.SendCommandAsync(
                Id, new SendCommandRequest { Command = "global.banlistex", Interactive = false });
            if (result.Success)
            {
                banList.Clear();
                banList.AddRange(ParseBanList(result.Message ?? string.Empty));
            }
            else
            {
                banListError = result.Error switch
                {
                    "NotConnected" => Localizer["This server isn't connected right now - the ban list is unavailable."],
                    _ => result.Error ?? Localizer["Failed to load the ban list."]
                };
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.GatewayTimeout)
        {
            banListError = Localizer["No worker responded in time - this server may not have an active connection."];
        }
        catch (Exception)
