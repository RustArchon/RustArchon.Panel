    /// <summary>
    /// The installed plugin's file is valid and signed with THIS Panel's active key, or with an earlier key of it that has
    /// not been revoked (the update then moves it to the current key) - the precondition for offering to update it.
    /// </summary>
    private bool PluginSignedByThisPanel =>
        pluginStatus is { SigningState: PluginSigningStates.Valid }
            && (pluginStatus.SigningKeyMatchesThisPanel == true || pluginStatus.SigningKeyState == "retired");

    private RenderFragment DownloadPluginButton => @<button type="button" class="btn btn-sm btn-outline-primary mb-2"
                                                            data-testid="plugin-download"
                                                            @onclick="DownloadPluginAsync" disabled="@downloadingPlugin">
        <i class="bi bi-download"></i> @Localizer["Download plugin"]
    </button>;

    /// <summary>The plugin is positively in the server's plugin list - the gate for everything about it.</summary>
    private bool PluginListed => RustArchonPlugin.IsListed(plugins.Select(p => p.Name));

    /// <summary>The installed build reported it understands <c>archon.config</c>, so its switches can be set.</summary>
    private bool PluginCanBeConfigured => PluginReports(RustArchonPlugin.ConfigCapability);

    private bool PluginReports(string capability) =>
        pluginStatus is not null && pluginStatus.Capabilities.Contains(capability, StringComparer.Ordinal);

    /// <summary>
    /// Whether the Panel can install or update the Updater on this server by itself: the plugin can do it (the Updater cannot replace
    /// itself, so the plugin does), the plugin is signed by this Panel's current key (the Updater is signed with it), and updates are
    /// turned on for the server. Otherwise the Updater is installed by hand, or the plugin is updated first.
    /// </summary>
    private bool UpdaterSelfUpdateBlockedByUpdatesOff =>
        server is not null && !server.PluginUpdatesEnabled && PluginReports(RustArchonPlugin.UpdaterUpdateCapability)
        && pluginStatus is not null && pluginStatus.SigningKeyMatchesThisPanel == true
        && string.Equals(pluginStatus.SigningKeyState, "active", StringComparison.OrdinalIgnoreCase);

    private bool UpdaterSelfUpdateOffered =>
        server is not null && server.PluginUpdatesEnabled && PluginReports(RustArchonPlugin.UpdaterUpdateCapability)
        && pluginStatus is not null && pluginStatus.SigningKeyMatchesThisPanel == true
        && string.Equals(pluginStatus.SigningKeyState, "active", StringComparison.OrdinalIgnoreCase);

