                {
                    <div class="alert alert-secondary" data-testid="bases-needs-plugin">
                        <i class="bi bi-plug"></i>
                        @Localizer["The bases list needs the RustArchon plugin, which is not detected on this server. Install it from the Plugins tab."]
                    </div>
