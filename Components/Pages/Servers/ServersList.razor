@page "/servers"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using RustArchon.Messaging.Contracts
@using RustArchon.Panel.Clients
@using RustArchon.Panel.Services
@using RustArchon.Shared.DTOs
@attribute [Authorize]
@inject IRustServerApiClient RustServerClient
@rendermode RenderModes.NonPrerenderedServer

<PageTitle>Servers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Servers</h1>
    <button class="btn btn-primary" @onclick="ShowAddForm" disabled="@checkingPlanLimit">
        <i class="bi bi-plus-circle"></i> Add Server
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (editingServer != null)
{
    <div class="card mb-4">
        <div class="card-header">
            @(editingServer.Id == Guid.Empty ? "Add Server" : "Edit Server")
        </div>
        <div class="card-body">
            <EditForm Model="editingServer" OnValidSubmit="SaveServer">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="server-name">Name</label>
                        <InputText id="server-name" class="form-control" @bind-Value="editingServer.Name" />
                        <ValidationMessage For="() => editingServer.Name" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="server-description">Description</label>
                        <InputText id="server-description" class="form-control" @bind-Value="editingServer.Description" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="server-host">Host / IP address</label>
                        <InputText id="server-host" class="form-control" @bind-Value="editingServer.Host" />
                        <ValidationMessage For="() => editingServer.Host" class="text-danger" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="server-port">RCON Port</label>
                        <InputNumber id="server-port" class="form-control" @bind-Value="editingServer.Port" />
                        <ValidationMessage For="() => editingServer.Port" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="server-password">
                            RCON Password
                            @if (editingServer.Id != Guid.Empty)
                            {
                                <span class="text-muted">(leave blank to keep unchanged)</span>
                            }
                        </label>
                        <InputText id="server-password" type="password" class="form-control" @bind-Value="editingServer.RconPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => editingServer.RconPassword" class="text-danger" />
                    </div>
                </div>

                <hr class="my-3" />
                <h6 class="text-muted text-uppercase small mb-3">Integrations</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="server-steam-api-key">Steam Web API Key</label>
                        <InputText id="server-steam-api-key" type="password" class="form-control" @bind-Value="editingServer.SteamApiKey"
                                   placeholder="@(editingServer.HasSteamApiKey ? "Already configured — leave blank to keep unchanged" : "Not configured")"
                                   autocomplete="new-password" />
                        <div class="form-text">Powers VAC/game-ban status and hours-on-record for inactive players. Get one at <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noopener">steamcommunity.com/dev/apikey</a>.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="server-geo-provider">Geolocation Provider</label>
                        <InputSelect id="server-geo-provider" class="form-select" @bind-Value="editingServer.GeolocationProvider">
                            <option value="@GeolocationProviderKind.None">None</option>
                            <option value="@GeolocationProviderKind.ProxyCheckIo">proxycheck.io</option>
                            <option value="@GeolocationProviderKind.IpHubInfo">iphub.info</option>
                            <option value="@GeolocationProviderKind.IpInfoIo">ipinfo.io</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="server-geo-api-key">Geolocation API Key</label>
                        <InputText id="server-geo-api-key" type="password" class="form-control" @bind-Value="editingServer.GeolocationApiKey"
                                   placeholder="@(editingServer.HasGeolocationApiKey ? "Already configured — leave blank to keep unchanged" : "Not configured")"
                                   autocomplete="new-password" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@saving">
                        @(saving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@saving">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (loading)
{
    <p><em>Loading servers...</em></p>
}
else if (servers != null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Host</th>
                    <th>Port</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var server in servers.OrderBy(s => s.Name))
                {
                    <tr>
                        <td>@server.Name</td>
                        <td>@server.Host</td>
                        <td>@server.Port</td>
                        <td>@server.Description</td>
                        <td>
                            @if (!server.IsEnabled)
                            {
                                <span class="badge status-badge status-disconnected"><i class="bi bi-pause-circle-fill"></i> Disabled</span>
                            }
                            else
                            {
                                <span class="badge status-badge @StatusBadgeClass(server.ConnectionStatus)">
                                    <i class="bi @StatusIcon(server.ConnectionStatus)"></i> @StatusText(server.ConnectionStatus)
                                </span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-sm btn-primary" href="@($"servers/{server.Id}")">
                                    <i class="bi bi-terminal"></i> View
                                </a>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowEditForm(server)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                @if (server.IsEnabled)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleEnabled(server, enable: false)" disabled="@togglingId.Contains(server.Id)">
                                        <i class="bi bi-pause-circle"></i> Disable
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleEnabled(server, enable: true)" disabled="@togglingId.Contains(server.Id)">
                                        <i class="bi bi-play-circle"></i> Enable
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(server)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!servers.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No servers yet. Add one to start managing it over RCON.
        </div>
    }
}

@if (showDeleteConfirmation && serverToDelete != null)
{
    <RustArchon.Panel.Components.Shared.ConfirmationModal
        Title="Delete Server"
        ConfirmButtonText="Delete"
        ConfirmButtonClass="btn-danger"
        OnClose="HandleDeleteModalClose">
        <Message>
            Are you sure you want to remove '@serverToDelete.Name'? This cannot be undone.
        </Message>
    </RustArchon.Panel.Components.Shared.ConfirmationModal>
}

@code {
    private IEnumerable<RustServerDto>? servers;
    private bool loading = true;
    private bool saving;
    private bool checkingPlanLimit;
    private string? errorMessage;
    private string? successMessage;
    private ServerFormModel? editingServer;
    private bool showDeleteConfirmation;
    private RustServerDto? serverToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadServers();
    }

    private async Task LoadServers()
    {
        loading = true;
        errorMessage = null;
        try
        {
            var result = await RustServerClient.GetAllAsync();
            servers = result.Items;
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "load servers");
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// A heads-up, not the enforcement - checks the tenant's plan limit before opening the Add Server
    /// form at all, so a user who's already at their limit sees that immediately instead of filling
    /// out the whole form only to have <c>SaveServer</c> reject it. <c>CreateAsync</c> still runs the
    /// authoritative check on submit regardless (this read can go stale between the two - another tab
    /// adding a server in the meantime, say), so a failure here fails open: opening the form anyway
    /// and letting that later check catch it is strictly no worse than skipping this heads-up
    /// entirely.
    /// </summary>
    private async Task ShowAddForm()
    {
        errorMessage = null;
        checkingPlanLimit = true;

        try
        {
            var status = await RustServerClient.GetPlanLimitAsync();
            if (status.MaximumServers is { } max && status.CurrentServerCount >= max)
            {
                errorMessage = $"Your plan ({status.PlanName}) allows up to {max} server(s). Upgrade your plan to add more.";
                return;
            }
        }
        catch (Exception)
        {
            // Best-effort - see this method's own remarks on why a failed check here doesn't block
            // opening the form.
        }
        finally
        {
            checkingPlanLimit = false;
        }

        editingServer = new ServerFormModel { Port = 28016 };
    }

    private void ShowEditForm(RustServerDto server)
    {
        editingServer = new ServerFormModel
        {
            Id = server.Id,
            Name = server.Name,
            Host = server.Host,
            Port = server.Port,
            Description = server.Description,
            HasSteamApiKey = server.HasSteamApiKey,
            GeolocationProvider = server.GeolocationProvider,
            HasGeolocationApiKey = server.HasGeolocationApiKey
        };
    }

    private void CancelEdit()
    {
        editingServer = null;
    }

    private async Task SaveServer()
    {
        if (editingServer == null)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (editingServer.Id == Guid.Empty)
            {
                await RustServerClient.CreateAsync(new CreateRustServerDto
                {
                    Name = editingServer.Name,
                    Host = editingServer.Host,
                    Port = editingServer.Port,
                    RconPassword = editingServer.RconPassword ?? string.Empty,
                    Description = editingServer.Description,
                    SteamApiKey = string.IsNullOrEmpty(editingServer.SteamApiKey) ? null : editingServer.SteamApiKey,
                    GeolocationProvider = editingServer.GeolocationProvider,
                    GeolocationApiKey = string.IsNullOrEmpty(editingServer.GeolocationApiKey) ? null : editingServer.GeolocationApiKey
                });
                successMessage = $"Server '{editingServer.Name}' was added.";
            }
            else
            {
                await RustServerClient.UpdateAsync(editingServer.Id, new UpdateRustServerDto
                {
                    Id = editingServer.Id,
                    Name = editingServer.Name,
                    Host = editingServer.Host,
                    Port = editingServer.Port,
                    RconPassword = string.IsNullOrEmpty(editingServer.RconPassword) ? null : editingServer.RconPassword,
                    Description = editingServer.Description,
                    SteamApiKey = string.IsNullOrEmpty(editingServer.SteamApiKey) ? null : editingServer.SteamApiKey,
                    GeolocationProvider = editingServer.GeolocationProvider,
                    GeolocationApiKey = string.IsNullOrEmpty(editingServer.GeolocationApiKey) ? null : editingServer.GeolocationApiKey
                });
                successMessage = $"Server '{editingServer.Name}' was updated.";
            }

            editingServer = null;
            await LoadServers();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "save server");
        }
        finally
        {
            saving = false;
        }
    }

    private readonly HashSet<Guid> togglingId = new();

    private async Task ToggleEnabled(RustServerDto server, bool enable)
    {
        togglingId.Add(server.Id);
        errorMessage = null;

        try
        {
            if (enable)
            {
                await RustServerClient.EnableAsync(server.Id);
            }
            else
            {
                await RustServerClient.DisableAsync(server.Id);
            }

            await LoadServers();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, enable ? "enable server" : "disable server");
        }
        finally
        {
            togglingId.Remove(server.Id);
        }
    }

    private static string StatusBadgeClass(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "status-connected",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "status-pending",
        _ => "status-disconnected"
    };

    private static string StatusIcon(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "bi-check-circle-fill",
        RconConnectionStatus.Connecting or RconConnectionStatus.Reconnecting => "bi-hourglass-split",
        RconConnectionStatus.Error => "bi-exclamation-triangle-fill",
        _ => "bi-x-circle-fill"
    };

    private static string StatusText(RconConnectionStatus status) => status switch
    {
        RconConnectionStatus.Connected => "Connected",
        RconConnectionStatus.Connecting => "Connecting",
        RconConnectionStatus.Reconnecting => "Reconnecting",
        RconConnectionStatus.Error => "Connection error",
        _ => "Disconnected"
    };

    private void ConfirmDelete(RustServerDto server)
    {
        serverToDelete = server;
        showDeleteConfirmation = true;
    }

    private async Task HandleDeleteModalClose(bool confirmed)
    {
        showDeleteConfirmation = false;

        if (!confirmed || serverToDelete == null)
        {
            serverToDelete = null;
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            await RustServerClient.DeleteAsync(serverToDelete.Id);
            successMessage = $"Server '{serverToDelete.Name}' was removed.";
            await LoadServers();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.For(ex, "remove server");
        }
        finally
        {
            serverToDelete = null;
        }
    }

    private sealed class ServerFormModel : IValidatableObject
    {
        public Guid Id { get; set; }

        [Required, MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required, MaxLength(255)]
        public string Host { get; set; } = string.Empty;

        [Range(1, 65535)]
        public int Port { get; set; } = 28016;

        /// <summary>Required when adding a new server; optional when editing (blank keeps it unchanged).</summary>
        public string? RconPassword { get; set; }

        [MaxLength(500)]
        public string? Description { get; set; }

        /// <summary>Plaintext, transient - blank keeps the existing key (if any) unchanged.</summary>
        public string? SteamApiKey { get; set; }

        /// <summary>Whether a Steam API key is already configured - display-only, informs the "leave
        /// blank to keep unchanged" hint; never itself sent back to the API.</summary>
        public bool HasSteamApiKey { get; set; }

        public GeolocationProviderKind GeolocationProvider { get; set; } = GeolocationProviderKind.None;

        /// <summary>Plaintext, transient - blank keeps the existing key (if any) unchanged.</summary>
        public string? GeolocationApiKey { get; set; }

        /// <summary>Same reasoning as <see cref="HasSteamApiKey"/>.</summary>
        public bool HasGeolocationApiKey { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Id == Guid.Empty && string.IsNullOrEmpty(RconPassword))
            {
                yield return new ValidationResult("RCON password is required.", [nameof(RconPassword)]);
            }
        }
    }
}
